; Shinobi Yolu - Godot projesi
config_version=5

[application]
config/name="Shinobi Yolu"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]
anti_aliasing/quality/msaa_3d=2

[autoload]

Game="*res://scripts/core/game.gd"
Data="*res://scripts/core/data.gd"
Sfx="*res://scripts/core/sfx.gd"
FX="*res://scripts/combat/fx.gd"
Combat="*res://scripts/combat/combat.gd"
Jutsu="*res://scripts/combat/jutsu.gd"
Buffs="*res://scripts/core/buffs.gd"
Interact="*res://scripts/world/interact.gd"
Lights="*res://scripts/world/lights.gd"
Waterfalls="*res://scripts/world/waterfalls.gd"
Steam="*res://scripts/world/steam.gd"
Spawner="*res://scripts/core/spawner.gd"
Progress="*res://scripts/core/progress.gd"
Missions="*res://scripts/core/missions.gd"
ChuninExam="*res://scripts/core/events.gd"
Exams="*res://scripts/core/exams/exams.gd"
Kage="*res://scripts/core/kage.gd"
Orgs="*res://scripts/core/orgs.gd"
RasenganTraining="*res://scripts/core/rasengan_training.gd"
Hud="*res://scripts/ui/hud.gd"
TailedBeasts="*res://scripts/core/tailed_beasts.gd"
WorldDamage="*res://scripts/world/world_damage.gd"
