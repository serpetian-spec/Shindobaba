	st(tt, "bind", 5.5)
	VFX.shockwave(at + Vector3.UP * 0.1, Color(0.4, 0.2, 0.6), 6.0, 0.5, true)
	Combat.popup_text(at + Vector3.UP * 2.6, "Karanlık Mühür!", Color(0.7, 0.5, 0.9))
