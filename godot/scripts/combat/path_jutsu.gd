	pit.material_override = pm
	pit.position = Vector3.UP * 1.2
	root.add_child(pit)
	for k in 8:
		var a = k * TAU / 8.0
		var tag = Label3D.new()
		tag.text = "封"
		tag.font_size = 72
		tag.pixel_size = 0.004
		tag.modulate = Color(0.75, 0.1, 0.12)
		tag.outline_modulate = Color(0.95, 0.92, 0.8)
		tag.outline_size = 30
		tag.position = Vector3(cos(a) * 2.25, 1.6, sin(a) * 2.25)
