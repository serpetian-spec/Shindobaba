	for k in 6:
		var row = 1.0 if k % 2 == 0 else -1.0
		var along = 7.0 + int(k / 2) * 8.0
		var face = -side * row
		after(int(k / 2) * 0.15, func():
			_wood_house(c.global_position + d * along + side * row * 6.5, atan2(face.x, face.z), 25.0, true))
	Sfx.play("earth", c.global_position, 0.6)


