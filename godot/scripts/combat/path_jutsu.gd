## Sekiz Hayati Nokta: sisin içinden sekiz noktaya sekiz ışık hızında kesik
func p_momochi_hachi(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 16.0)
	busy(c, 1.3)
	_mm_cleaver(c, 1.3)
