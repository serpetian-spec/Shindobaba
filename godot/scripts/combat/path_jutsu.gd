			tw.tween_interval(0.2)
		tw.tween_property(tt, "global_position", gp(y0 + c.face_dir() * 1.2), 0.1)
		tw.tween_callback(func():
			if live(tt):
				melee_fx(c, tt.global_position + Vector3.UP * 0.3, Color(1, 0.8, 0.6), 1.6, true)
