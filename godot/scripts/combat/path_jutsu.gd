## Senninka (kanon, Jūgo klanı kekkei genkai): bedenden salgılanan sıvı, emilen doğa enerjisiyle bedeni dönüştürür (ten
## rengi değişir, kollar kalınlaşır). 1. aşama: Kassokuken/Masakari/Jet Booster Jump açılır. Dönüşümdeyken yeniden kullanılırsa
## 2. aşama: daha da iri, Taren Fujizuho açılır. Bedel (kanon): sürekli emilen doğa enerjisi ani, kontrolsüz öldürme nöbetleri
## getirir — nöbette kontrol gider, en yakındaki kim olursa (dost bile) ona saldırırsın. Taşlaşma riski yok. AI aynı kural.
func p_jugo_ofke(c: Node3D, _t: Node3D) -> void:
	var is_p = c is Player
	var in1 = (is_p and Buffs.has("jugo_senninka")) or (not is_p and c.get("buffs") != null and c.buffs.has("jugo_senninka"))
	var stage = 2 if in1 else 1
	busy(c, 0.9)
	var DUR = 18.0
	VFX.shockwave(c.global_position + Vector3.UP, NATURE, 8.0 + stage * 4.0, 0.5, false)
	FX.aura(c, Color(0.6, 0.2, 0.1) if stage == 2 else Color(0.55, 0.45, 0.25), 1.4 + stage * 0.4, Vector3(0, 0.9, 0), DUR)
	_stone_skin(c, DUR, Color(0.55, 0.45, 0.4) if stage == 2 else Color(0.7, 0.6, 0.45))
	var m = c.get("model")
	if m and m.get("overlay") != null:   # dönüşen kollar kalınlaşır
		var bk = 1.3 if stage == 1 else 1.7
		m.overlay.bulk["LeftUpperArm"] = bk
		m.overlay.bulk["RightUpperArm"] = bk
		after(DUR, func():
			if is_instance_valid(m):
				m.overlay.bulk.erase("LeftUpperArm")
				m.overlay.bulk.erase("RightUpperArm"))
	var mods = {"melee": 1.35, "speed": 1.12, "armor": 0.8} if stage == 1 else {"melee": 1.7, "speed": 1.25, "armor": 0.65}
	var key = "jugo_senninka" if stage == 1 else "jugo_senninka2"
	if is_p:
		Buffs.remove("jugo_senninka")
		Buffs.add(key, DUR, mods.merged({"_name": "Senninka %d. aşama" % stage, "_desc": "doğa enerjisiyle dönüşmüş beden; öldürme nöbetleri gelebilir"}))
	elif c.has_method("add_buff"):
		c.add_buff(key, DUR, mods)
	Combat.popup_text(c.global_position + Vector3.UP * 2.6, "Senninka %d" % stage, NATURE)
	# öldürme nöbetleri: ara ara kontrol gider, en yakındakine saldırırsın
	every(DUR, 3.0, func(_i, _k):
		if not live(c) or randf() > (0.25 if stage == 1 else 0.45):
			return
		var near: Node3D = null
		var bd = 9.0
		for f in get_tree().get_nodes_in_group("fighters"):
			if f == c or f.is_dead() or f is TailedBeast:
				continue
			var dd = f.global_position.distance_to(c.global_position)
			if dd < bd:
				bd = dd
				near = f
		Combat.popup_text(c.global_position + Vector3.UP * 2.8, "Öldürme dürtüsü!", Color(0.9, 0.25, 0.15))
		if is_p:
			c.input_locked = 1.6
		if near:
			var to = gp(near.global_position - (near.global_position - c.global_position).normalized() * 1.0)
			var tw = c.create_tween()
			tw.tween_property(c, "global_position", to, 0.25)
			tw.tween_callback(func():
				if live(near) and live(c):
					anim(c, "cross", 1.6)
					near.take_hit(inf(c, "jugo_ofke", 0.9, {"knock": 12.0, "kind": "heavy", "melee": true, "attacker": c}))), Callable())
	shake(0.8)
	Sfx.play("roar", c.global_position, 0.7)


# ================================================================== Yeni klanlar 2: Funato (deniz) / Kaminarimon (elektromanyetik şimşek) / Ōtsutsuki (tanrısal soy)
const SEA := Color(0.2, 0.55, 0.85)
const EMAG := Color(0.55, 0.8, 1.0)
const DIVINE := Color(0.95, 0.92, 0.75)


# ------------------------------------------------------------------ Funato (Boruto, Tenma Funato): kemancı yengeç kıskacı
const CRAB := Color(0.86, 0.34, 0.16)
const CRAB_TIP := Color(0.96, 0.86, 0.7)


## Kemancı yengecin büyük kıskacı (sağ kolda): kabuk avuç + sabit üst parmak + açılıp kapanan alt parmak (dişli)
func _crab_claw(c: Node3D) -> Dictionary:
	var ba = bone_attach(c, "RightHand")
	if ba == null:
		return {}
	var root = Node3D.new()
	ba.add_child(root)
	var b = MB.new()
	b.add_grad("sphere", Vector3(0, 0.02, 0.2), Vector3(0.36, 0.32, 0.52), CRAB.lightened(0.12), CRAB.darkened(0.28), Vector3.ZERO, 14)   # şişkin avuç (propodus)
	b.add("cyl", Vector3(0, 0, -0.04), Vector3(0.17, 0.14, 0.17), CRAB.darkened(0.3), Vector3(90, 0, 0), 12)   # bilek halkası
	# sabit üst parmak: kalın kökten sivri uca, hafif aşağı kıvrık (iki konik parça)
	b.add_grad("cone", Vector3(0, 0.09, 0.56), Vector3(0.15, 0.36, 0.13), CRAB, CRAB.darkened(0.1), Vector3(90, 0, 0), 10)
	b.add_grad("cone", Vector3(0, 0.04, 0.86), Vector3(0.09, 0.3, 0.08), CRAB, CRAB_TIP, Vector3(100, 0, 0), 8)
	for k in 5:   # iç dişler
		b.add("cone", Vector3(0, 0.0, 0.44 + k * 0.1), Vector3(0.03, 0.06, 0.03), CRAB_TIP, Vector3(180, 0, 0), 4)
	var top = mesh_of(b)
	root.add_child(top)
	var jaw = Node3D.new()
	jaw.position = Vector3(0, -0.08, 0.36)
	root.add_child(jaw)
	var bj = MB.new()
	bj.add_grad("cone", Vector3(0, -0.02, 0.18), Vector3(0.12, 0.32, 0.1), CRAB.darkened(0.08), CRAB.darkened(0.15), Vector3(90, 0, 0), 10)
	bj.add_grad("cone", Vector3(0, 0.02, 0.44), Vector3(0.07, 0.26, 0.06), CRAB.darkened(0.05), CRAB_TIP, Vector3(80, 0, 0), 8)
	for k in 4:
		bj.add("cone", Vector3(0, 0.05, 0.1 + k * 0.1), Vector3(0.025, 0.05, 0.025), CRAB_TIP, Vector3.ZERO, 4)
	jaw.add_child(mesh_of(bj))
	root.scale = Vector3.ONE * 1.05
	return {"root": root, "jaw": jaw, "ba": ba}


## Kıskaç açılıp kapanır (açı: derece)
func _crab_snap(st: Dictionary, open_deg: float, t_open: float, t_close: float) -> void:
	var jaw: Node3D = st.get("jaw")
	if jaw == null or not is_instance_valid(jaw):
		return
	var tw = jaw.create_tween()
	tw.tween_property(jaw, "rotation:x", deg_to_rad(open_deg), t_open).set_trans(Tween.TRANS_SINE)
	tw.tween_property(jaw, "rotation:x", 0.0, t_close).set_trans(Tween.TRANS_EXPO).set_ease(Tween.EASE_IN)


func _crab_of(c: Node3D) -> Dictionary:
	if not c.has_meta("shiomaneki"):
		return {}
	var st: Dictionary = c.get_meta("shiomaneki")
	if not is_instance_valid(st.get("root")):
		c.remove_meta("shiomaneki")
		return {}
	return st


## Kuchiyose: Shiomaneki (kanon): parşömenden dev kıskaç çağrılır, kola geçer; 25 sn yakın dövüş güçlenir (metali keser)
func p_funato_shiomaneki(c: Node3D, _t: Node3D) -> void:
	busy(c, 0.6)
	var old = _crab_of(c)
	if not old.is_empty():
		old["ba"].queue_free()
	FX.smoke_puff(hand_pos(c, true), 0.9, 14)
	summon_circle(gp(c.global_position), 1.6, SEA, 0.8)
	var st = _crab_claw(c)
	if st.is_empty():
		return
	c.set_meta("shiomaneki", st)
	_crab_snap(st, 32.0, 0.15, 0.1)
	if c is Player:
		Buffs.add("shiomaneki", 25.0, {"melee": 1.25, "_name": "Shiomaneki", "_desc": "Kemancı yengeç kıskacı: yakın dövüş +%25"})
	elif c.has_method("add_buff"):
		c.add_buff("shiomaneki", 25.0, {"melee": 1.25})
	after(25.0, func():
		if is_instance_valid(st.get("ba")):
			FX.smoke_puff((st["root"] as Node3D).global_position, 0.7, 10)
			st["ba"].queue_free()
		if is_instance_valid(c) and c.has_meta("shiomaneki") and c.get_meta("shiomaneki") == st:
			c.remove_meta("shiomaneki"))
	Sfx.play("summon", c.global_position, 1.2)


## Isō Ryōdan (kanon): kıskaç açık rakibe atılır, başına kapanır — ağır tek kesik. Kıskaç takılı olmalı
func p_funato_iso_ryodan(c: Node3D, t: Node3D) -> void:
	var st = _crab_of(c)
	if st.is_empty():
		if c is Player:
			Hud.msg("Önce Kuchiyose: Shiomaneki ile kıskacı çağır.", Color(1, 0.75, 0.45))
		return
	var tt = tg(c, t, 12.0)
	busy(c, 0.7)
	var d = fwd(c, t)
	var start = c.global_position
	var end = gp((tt.global_position - d * 1.2) if tt else start + d * 7.0)
	_crab_snap(st, 48.0, 0.18, 0.08)
	anim(c, "cross", 1.4)
	every(0.2, 1.0 / 60.0, func(_i, k):
		if live(c):
			c.global_position = gp(start.lerp(end, k)), func():
		if not live(c):
			return
		var at = (tt.global_position + Vector3.UP * tt.height * 0.85) if tt and live(tt) else end + Vector3.UP * 1.5
		impact_fx("", CRAB_TIP, at, 1.2)
		VFX.shockwave(at, CRAB_TIP, 2.0, 0.2, false, d)
		mhit(c, at, 1.6, inf(c, "funato_iso_ryodan", 2.4, {"knock": 8.0, "kind": "heavy", "bleed": 4.0, "hitstop": 0.12}))
		Sfx.play("clink", at, 0.7))


## Suiton: Suisairin (kanon): sudan sayısız balık pulu kıskacın içinden yelpaze gibi fırlar. Kıskaç takılı olmalı
func p_funato_suisairin(c: Node3D, t: Node3D) -> void:
	var cs = _crab_of(c)
	if cs.is_empty():
		if c is Player:
			Hud.msg("Önce Kuchiyose: Shiomaneki ile kıskacı çağır.", Color(1, 0.75, 0.45))
		return
	var tt = tg(c, t, 26.0)
	busy(c, 0.8)
	_crab_snap(cs, 40.0, 0.12, 0.6)
	var b = MB.new()
	b.add_grad("sphere", Vector3.ZERO, Vector3(0.16, 0.03, 0.2), Color(0.8, 0.93, 1.0), Color(0.35, 0.65, 1.0), Vector3.ZERO, 6)
	var scale_mesh = b.build(Props.toon())
	for k in 18:
		after(0.12 + k * 0.025, func():
			if not live(c):
				return
			var root: Node3D = cs.get("root")
			var from = root.global_position + root.global_transform.basis.z * 0.8 if is_instance_valid(root) else hand_pos(c, true)
			var dir = aim_at(c, tt, from).rotated(Vector3.UP, randf_range(-0.28, 0.28)) + Vector3(0, randf_range(-0.05, 0.08), 0)
			var mi = MeshInstance3D.new()
			mi.mesh = scale_mesh
			shot(c, from, dir.normalized(), 38.0, mi, inf(c, "funato_suisairin", 0.18, {"knock": 1.0, "kind": "light", "element": "suiton", "bleed": 0.5}), null, false, 1.0, func(p, h):
				VFX.splash(p, 0.4)
				if h and live(h):
					st(h, "wet", 3.0)))
	Sfx.play("water", c.global_position, 1.3)

func p_kaminarimon_denko_ken(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 8.0)
	busy(c, 0.6)
	_rai_hand(c, 0.6)
	_jump_at(c, tt, 0.3, 8.0)
	after(0.25, func():
		if live(c):
			var at = c.global_position + Vector3.UP * 1.1 + c.face_dir() * 1.2
			impact_fx("raiton", EMAG, at, 1.4)
			mhit(c, at, 2.2, inf(c, "kaminarimon_denko_ken", 1.4, {"knock": 12.0, "kind": "heavy", "element": "raiton", "stun": 0.8})))
	Sfx.play("chidori", c.global_position, 1.3)


func p_kaminarimon_raijin_tate(c: Node3D, _t: Node3D) -> void:
	busy(c, 0.4)
	var ring = Node3D.new()
	c.add_child(ring)
	ring.position = Vector3(0, 1.2, 1.3)
	for k in 6:
		var a = k * TAU / 6.0
		var o = VFX.lightning_ball(0.35, EMAG)
		ring.add_child(o)
		o.position = Vector3(cos(a), sin(a), 0) * 1.0
	var tw = ring.create_tween()
	tw.tween_property(ring, "rotation:z", TAU * 6.0, 5.0)
	tw.tween_callback(ring.queue_free)
	every(5.0, 0.06, func(_i, _k):
		if not (live(c) and is_instance_valid(ring)):
			return
		for pr in get_tree().get_nodes_in_group("projectiles"):
			if pr.get("shooter") != c and pr.global_position.distance_to(ring.global_position) < 2.0:
				VFX.bolt(ring.global_position, pr.global_position, EMAG, 0.1, 0.15, 1)
				pr.queue_free(), Callable())
	Sfx.play("chidori", c.global_position, 1.5)


func p_kaminarimon_denki_ito(c: Node3D, t: Node3D) -> void:
	busy(c, 0.6)
	var d = fwd(c, t)
	var side = d.cross(Vector3.UP).normalized()
	var a = gp(c.global_position + d * 6.0 + side * 4.0) + Vector3.UP
	var b = gp(c.global_position + d * 6.0 - side * 4.0) + Vector3.UP
	tether(func(): return a, func(): return b, 0.03, VFX.mat_bolt(EMAG, 2.2), 8.0)
	every(8.0, 0.15, func(i, _k):
		if i % 3 == 0:
			VFX.bolt(a, b, EMAG, 0.06, 0.12, 1)
		for e in enemies_near(c, (a + b) * 0.5, 4.5):
			var p = e.global_position + Vector3.UP
			var ab = b - a
			var tpar = clampf((p - a).dot(ab) / ab.length_squared(), 0.0, 1.0)
			if (a + ab * tpar).distance_to(p) < 1.0:
				st(e, "stun", 1.0)
				e.take_hit(inf(c, "kaminarimon_denki_ito", 0.3, {"knock": 2.0, "kind": "light", "element": "raiton"})), Callable())
	Sfx.play("chidori", c.global_position, 1.6)


func p_kaminarimon_raikou(c: Node3D, t: Node3D) -> void:
	busy(c, 0.5)
	var d = fwd(c, t)
	var start = c.global_position
	var end = gp(start + d * 16.0)
	stream_fx(start + Vector3.UP, d, 16.0, 0.35, VFX.mat_bolt(EMAG, 2.4), 0.3)
	for k in 6:
		VFX.bolt(start + Vector3.UP + d * k * 2.6, start + Vector3.UP + d * (k + 1) * 2.6 + Vector3(randf_range(-0.6, 0.6), randf_range(-0.4, 0.6), 0), EMAG, 0.12, 0.25, 1)
	c.global_position = end
	Combat.hit_zone(c, start, d, 16.0, 10.0, 2.0, inf(c, "kaminarimon_raikou", 1.4, {"knock": 8.0, "kind": "heavy", "element": "raiton", "stun": 0.5}))
	Sfx.play("thunder", c.global_position, 1.4)


func p_kaminarimon_raikyu_ame(c: Node3D, t: Node3D) -> void:
	busy(c, 0.9)
	var at = gp(Jutsu._aim_ground(c, t, 10.0, 20.0))
	for k in 10:
		after(0.2 + k * 0.1, func():
			var q = at + Vector3(randf_range(-5, 5), 0, randf_range(-5, 5))
			var ball = VFX.lightning_ball(0.6, EMAG)
			get_tree().current_scene.add_child(ball)
