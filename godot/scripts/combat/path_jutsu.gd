## Ejder Alevi Gürültüsü: ağızdan sivri dişli ejder başı biçiminde çok sayıda alev mermisi
func p_katon_ryuen_hoka_no_jutsu(c: Node3D, t: Node3D) -> void:
	busy(c, 1.0)
	var tt = tg(c, t, 28.0)
	for k in 5:
		after(k * 0.12, func():
			if not live(c):
				return
			# alev ejder başı (gerçek ejder kafası) + kısa alev gövdesi
			var head = Node3D.new()
			var fm = VFX.mat_fire("fire", 2.6, 2.2, 0.36, 1.4, 0.1, Vector3(0, 0, 1))
			var dh = VfxSerpent.dragon_head(fm, 1.8, Color(1, 1, 0.6))
			head.add_child(dh)
			# anime: ejder başlı alevler önce yelpaze gibi göğe fırlar, sonra kıvrılıp hedefin üstüne yukarıdan dalar
			var fd = c.face_dir()
			var sd = fd.cross(Vector3.UP)
			var from = _mouth_pos(c) + sd * (k - 2) * 0.4
			var up_dir = (fd * 0.6 + Vector3.UP * 0.9 + sd * (k - 2) * 0.35).normalized()
			var pr = shot(c, from, up_dir, 24.0, head, inf(c, "katon_ryuen_hoka_no_jutsu", 0.6, {"knock": 9.0, "launch": 3.0, "kind": "heavy", "element": "katon", "burn": 2.0}), tt, false, 2.4, func(p, _h):
				impact_fx("katon", FIRE, p, 1.6)
				VFX.explosion(p, 1.4)
				VFX.linger(gp(p), "katon", FIRE, 1.4, 3.0))
			pr.homing_turn = 0.0
			pr.radius = 1.1
			var age = {"t": 0.0}
			pr.on_tick = func(p2, dt):
				age["t"] += dt
				if age["t"] > 0.4:
					# dalış: hedefe (yoksa önündeki yere) güçlü dönüş, hızlanarak iner
					var goal = (tt.global_position + Vector3.UP) if tt and live(tt) else gp(c.global_position + fd * 18.0)
					p2.vel = p2.vel.lerp((goal - p2.global_position).normalized() * 34.0, minf(1.0, dt * 6.0))
				if randf() < 0.5:
					VFX.puffs(p2.global_position, {"amount": 2, "life": 0.35, "size": 0.9, "radius": 0.4, "vmin": 0.5, "vmax": 1.5, "dir": Vector3.UP, "spread": 60.0,
						"glow": 1.15, "hot": 0.6, "outline_col": Color(0.7, 0.2, 0.03), "outline": 0.03,
						"colors": [Color(1.0, 0.95, 0.55, 1), Color(1.0, 0.6, 0.12, 1), Color(0.5, 0.12, 0.03, 0)]})
			var body = VfxSerpent.new()
			body.style = "fire"
			body.seed_id = "ryuen%d" % k
			body.head = pr
			body.count = 9
			body.spacing = 0.8
			body.radius = 1.1
			body.mat = VFX.mat_fire("fire", 2.6, 2.2, 0.36, 1.4, 0.1, Vector3(0, 0, 1))
			get_tree().current_scene.add_child(body))
	Sfx.play("fire", c.global_position, 0.6)


## Rüzgâr Bıçağı: iki parmaktan çıkan görünmez rüzgâr bıçağı uzaktan hedefi keser (havada ince titreşen çizgi)
func p_kaze_no_yaiba(c: Node3D, t: Node3D) -> void:
	busy(c, 0.6)
	var tt = tg(c, t, 16.0)
	var d = _face(c, tt)
	after(0.2, func():
		if not live(c):
			return
		var from = hand_pos(c, true)
		var end = (tt.global_position + Vector3.UP if tt else from + d * 14.0)
		# görünmez kılıç: parmaklardan hedefe uzanan ince, keskin hava çizgileri (kutu yerine)
		var dl = end - from
		var sd = dl.cross(Vector3.UP).normalized()
		for k in 5:
			var off = randf_range(-0.12, 0.12)
			var bow = randf_range(-0.35, 0.35)
			WindFX.streak(func(q: float) -> Vector3: return from + dl * q + sd * (off + sin(q * PI) * bow) + Vector3.UP * off,
				0.14, randf_range(0.03, 0.06), Color(1, 1, 1, 0.9), k * 0.02, 12)
		FX.burst(from, {"amount": 18, "life": 0.25, "tex": FX.tex_spark, "size": 1.4, "vmin": 40.0, "vmax": 60.0, "dir": dl.normalized(), "spread": 3.0, "radius": 0.1,
			"colors": [Color(1, 1, 1, 0.0), Color(1, 1, 1, 0.8), Color(1, 1, 1, 0.0)]})
		if tt:
			_arc_cut(tt.global_position + Vector3.UP, d, -50.0, 50.0, Color(0.9, 1, 0.95), 1.4)
			mhit(c, tt.global_position + Vector3.UP, 1.6, inf(c, "kaze_no_yaiba", 1.6, {"knock": 4.0, "kind": "heavy", "element": "fuuton", "bleed": 5.0}))
		Sfx.play("wind", from, 2.0, 0.5))


