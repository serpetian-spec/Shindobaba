		impact_fx("fuuton", HAGO, at + Vector3.UP * 0.5, 1.3)
		hit(c, at + Vector3.UP, 3.5, inf(c, "hagoromo_tenba", 2.0, {"knock": 12.0, "kind": "heavy", "bleed": 2.0})))
	Sfx.play("wind", c.global_position, 0.9)


