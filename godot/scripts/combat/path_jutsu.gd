## Kyodai Sensu: dev yelpaze üç kez savrulur, her yıldızda rüzgâr büyür
func p_kyodai_sensu(c: Node3D, t: Node3D) -> void:
	busy(c, 1.6)
	var d = fwd(c, t)
	jutsu_weapon(c, "tessen", 1.8)
	for k in 3:
		after(0.25 + k * 0.42, func():
			if not live(c):
				return
			anim(c, "slash_c" if k % 2 == 0 else "slash_b", 1.4)
