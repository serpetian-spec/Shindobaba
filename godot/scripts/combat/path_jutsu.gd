			m.visible = false
		st(tt, "stun", 4.0)
		tt.take_hit(inf(c, "senpo_ryosei_no_jutsu", 1.0, {"knock": 0.0, "kind": "heavy"}))
		get_tree().create_timer(4.0).timeout.connect(func():
