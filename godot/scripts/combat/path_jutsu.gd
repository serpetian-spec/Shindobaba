## Ölüm Mahkumiyeti Laneti: hedefin kanı yalanır, kanla yere üçgenli lanet çemberi çizilir, beden siyah-beyaza döner — kendine saplanan her mızrak hedefi deler
func p_jujutsu_shiji_hyoketsu(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 24.0)
	# anime: lanet ancak hedefin kanı alınmışsa (tırpan/kazık) kurulur; çemberdeyken sana gelen her acı ona da gelir
	if c is Player and (tt == null or not tt.has_meta("jashin_kan") or Time.get_ticks_msec() - int(tt.get_meta("jashin_kan")) > 30000):
		Hud.msg("Lanet için önce hedefin kanını almalısın: Sanjin no Ōgama ya da Kaeri Yari ile yarala (30 sn).", Color(1, 0.5, 0.45))
		return
	busy(c, 2.0)
	if tt == null:
		return
	if c is Player:
		c.set_meta("jashin_link", [tt, Time.get_ticks_msec() + 12000])
		Hud.msg("Lanet bağı kuruldu: 12 sn boyunca sana gelen her acı hedefe de gelir.", Color(0.9, 0.3, 0.3), 4.0)
	var at = gp(c.global_position)
	var blood = Color(0.7, 0.05, 0.05)
	var b = MB.new()
	b.add("cyl", Vector3(0, 0.02, 0), Vector3(4.0, 0.02, 4.0), blood, Vector3.ZERO, 32)
	b.add("cyl", Vector3(0, 0.03, 0), Vector3(3.6, 0.02, 3.6), Color(0.85, 0.75, 0.55), Vector3.ZERO, 32)
	for k in 3:
		var a = k * TAU / 3.0 + PI * 0.5
		var a2 = (k + 1) * TAU / 3.0 + PI * 0.5
		var p1 = Vector3(cos(a), 0, sin(a)) * 1.75
		var p2 = Vector3(cos(a2), 0, sin(a2)) * 1.75
		var mid = (p1 + p2) * 0.5
		b.add("box", mid + Vector3.UP * 0.04, Vector3(0.1, 0.02, p1.distance_to(p2)), blood, Vector3(0, rad_to_deg(atan2((p2 - p1).x, (p2 - p1).z)), 0))
	var circle = mesh_of(b)
	get_tree().current_scene.add_child(circle)
	circle.global_position = at
	for k in 3:
		after(0.5 + k * 0.45, func():
			if not (live(c) and live(tt)):
				return
			VFX.debris(c.global_position + Vector3.UP * 1.2, blood, 8, 5.0, 0.25)
			VFX.debris(tt.global_position + Vector3.UP * 1.2, blood, 14, 7.0, 0.3)
			VFX.shockwave(tt.global_position + Vector3.UP, blood, 2.4, 0.25, false)
			tt.take_hit(inf(c, "jujutsu_shiji_hyoketsu", 1.6, {"knock": 0.0, "kind": "heavy", "bleed": 4.0, "hitstop": 0.08}))
			if c is Player:
				c.hp = maxf(1.0, c.hp - c.max_hp * 0.03))
	free_after(2.2, circle)
	Sfx.play("blade", c.global_position, 0.5)


## Ağaç Denizi Aşınması: yerden yüzlerce kök ve dal bütün alanı örter — içindeki herkes sarılır, boğulur
func p_jukai_shinshoku(c: Node3D, t: Node3D) -> void:
	busy(c, 1.0)
	var at = gp(c.global_position + fwd(c, t) * 7.0)
	# ref: kullanıcının önünden yere yayılan, birbirine dolanan kalın kökler (sivri kazık değil)
	var d0 = fwd(c, t)
	var o = gp(c.global_position + d0 * 1.5)
	for k in 22:
		var dir = d0.rotated(Vector3.UP, randf_range(-1.1, 1.1))
		var L = randf_range(9.0, 16.0)
		_creep_root(o + dir.cross(Vector3.UP) * randf_range(-1.0, 1.0), dir, L, randf_range(0.35, 0.7), randf() * 0.35, 3.4)
		if k % 3 == 0:   # dallanan ikincil kök
			var mid = o + dir * L * randf_range(0.4, 0.6)
			_creep_root(mid, dir.rotated(Vector3.UP, randf_range(-0.9, 0.9)), L * 0.5, 0.3, 0.3 + randf() * 0.2, 3.1)
	VFX.cracks(o, 3.0)
	every(3.5, 0.5, func(_i, k):
		if not live(c):
			return
		for e in enemies_near(c, at, 11.0):
			st(e, "bind", 0.6)
			if int(k) % 2 == 0:
				VFX.debris(e.global_position, EARTH, 4, 5.0, 0.3)
			e.take_hit(inf(c, "jukai_shinshoku", 0.35, {"knock": 0.0, "kind": "light", "element": "mokuton"})), Callable())
	shake(0.6)
	Sfx.play("earth", at, 0.5)


## Beş Doğa Büyük Kombosu: klonlar yan yana dizilir — ateş, rüzgâr, su, şimşek ve toprak aynı anda tek dev akıntıda birleşir
func p_goton_dairendan_no_jutsu(c: Node3D, t: Node3D) -> void:
	busy(c, 1.8)
	var tt = tg(c, t, 34.0)
	var d = fwd(c, tt)
	var side = d.cross(Vector3.UP).normalized()
	var at = c.global_position
	var goal = gp(tt.global_position if tt else at + d * 22.0) + Vector3.UP
	# dört gölge klon kullanıcının iki yanında belirir (içinde doğan klon yok), hepsi aynı anda aynı el pozunu verir;
	# kullanıcı ateşi, klonlar rüzgâr / su / şimşek / toprağı atar — beş element hedefte birleşip dev patlamaya döner
	var els = ["fuuton", "suiton", "raiton", "doton"]
	var offs = [-2.6, -1.3, 1.3, 2.6]
	var clones = []
	var mdl = c.get("model")
	for k in 4:
		var q = gp(at + side * offs[k] - d * 0.4)
		FX.smoke_puff(q + Vector3.UP, 0.8, 10)
		if mdl and "look" in mdl:
			var cm = CharacterModel.new()
			get_tree().current_scene.add_child(cm)
			cm.setup(mdl.look)
			cm.global_position = q
			cm.rotation.y = mdl.global_rotation.y
			cm.scale = Vector3.ONE * float(cm.age_scale)
			cm.play("cast_in", 0.05, 1.2, true)
			clones.append(cm)
		else:
			clones.append(null)
	anim(c, "cast_in", 1.2)
	VFX.gather(_mouth_pos(c), FIRE, 0.8)
	after(0.5, func():
		if not live(c):
			return
		anim(c, "push", 1.3)
		var from = _mouth_pos(c)
		_flame_jet(c, from, (goal - from).normalized(), from.distance_to(goal), 3.5, 0.8, 1.4)
		for k in 4:
			var cm = clones[k]
			var src = (cm.global_position + Vector3.UP * 1.4 + d * 0.6) if cm and is_instance_valid(cm) else from + side * offs[k]
			if cm and is_instance_valid(cm):
				cm.play("cast_out", 0.05, 1.3, true)
			var dir = (goal - src).normalized()
			var L = src.distance_to(goal)
			match els[k]:
				"fuuton":
					stream_fx(src, dir, L, 1.8, VFX.mat_wind(Color(0.75, 1.0, 0.9), 8.0, 6.0, Vector3(0, 0, 1), 0.6), 0.7)
					for q in 5:
						WindFX.streak(func(u: float) -> Vector3:
							var a = q * TAU / 5.0 + u * 10.0
							return src.lerp(goal, u) + (side * cos(a) + Vector3.UP * sin(a)) * 0.6, 0.5, 0.06, Color(0.8, 1.0, 0.9), q * 0.04, 12)
				"suiton":
					stream_fx(src, dir, L, 1.8, VFX.mat_water(Color(0.1, 0.35, 0.7), Color(0.3, 0.65, 1.0), Color(0.85, 0.95, 1.0), Vector3(0, 0, 1), 1.0, 0.7, 0.15), 0.7)
				"raiton":
					for q in 6:
						after(q * 0.08, func():
							LightRibbon.spawn(LightRibbon.curve(src, goal, src.lerp(goal, 0.5) + Vector3(randf_range(-1.5, 1.5), randf_range(-1, 1.5), randf_range(-1.5, 1.5)), 12), 0.35, 0.22, RAI))
				"doton":
					for q in 6:
						after(q * 0.06, func():
							var rk = _rock(randf_range(0.6, 1.1))
							get_tree().current_scene.add_child(rk)
							rk.global_position = src
							var tw = rk.create_tween()
							tw.tween_property(rk, "global_position", goal + Vector3(randf_range(-1.5, 1.5), randf_range(-0.5, 1.0), randf_range(-1.5, 1.5)), 0.4)
							tw.tween_callback(func(): VFX.debris(rk.global_position, EARTH, 6, 6.0, 0.4))
							tw.tween_callback(rk.queue_free))
		# birleşme: hedefte beş renkli dev patlama
		after(0.45, func():
			VFX.explosion(goal, 4.0)
			impact_fx("katon", FIRE, goal, 3.0)
			impact_fx("raiton", RAI, goal, 2.0)
			WindFX.blast(goal, 4.0, 18, WindFX.LINE, false)
			VFX.cracks(gp(goal), 10.0)
			for h in hit(c, goal, 7.5, inf(c, "goton_dairendan_no_jutsu", 3.4, {"knock": 26.0, "launch": 7.0, "kind": "heavy", "burn": 3.0, "stun": 0.8, "hitstop": 0.14})):
				st(h, "slow", 2.0)
			if Game.world:
				Game.world.env.screen_flash(0.2)
			shake(1.5))
		Combat.hit_zone(c, at, d, at.distance_to(goal) + 4.0, 40.0, 4.0, inf(c, "goton_dairendan_no_jutsu", 1.0, {"knock": 8.0, "kind": "heavy"})))
	after(1.6, func():
		for cm in clones:
			if cm and is_instance_valid(cm):
				FX.smoke_puff(cm.global_position + Vector3.UP, 0.8, 10)
				cm.queue_free())
	Sfx.play("boom", c.global_position, 0.7)


# ================================================================== Yeni jutsular N (Sv.28): Kamui, Susanoo dansı, lotus kolosu, ahşap ormanlar, iblis heykeli
const KAMUI := Color(0.2, 0.15, 0.3)


## Kamui girdabı: ortak uzay bükülmesi (MsArts.kamui_vortex; geometrik koni kabuk yok). parent verilirse onu izler.
func _kamui_swirl(at: Vector3, r: float, dur: float, parent: Node3D = null) -> MeshInstance3D:
	var pos = parent.to_global(at) if parent else at
	var v = MsArts.kamui_vortex(pos, r, dur)
	if parent:
		var o = {"v": v, "p": parent}
		v.create_tween().tween_method(func(_x: float):
			if is_instance_valid(o["v"]) and is_instance_valid(o["p"]):
				o["v"].global_position = o["p"].to_global(at), 0.0, 1.0, dur)
	return v


## Zincir halkalarından oluşan düğüm (u boyunca uzanır)
func _chain_links(n: int, col: Color) -> Node3D:
	var root = Node3D.new()
	var m = StandardMaterial3D.new()
	m.albedo_color = col
	m.metallic = 0.7
	m.roughness = 0.3
	m.emission_enabled = true
	m.emission = col * 0.6
	for k in n:
		var link = MeshInstance3D.new()
		var tm = TorusMesh.new()
		tm.inner_radius = 0.18; tm.outer_radius = 0.3; tm.rings = 12; tm.ring_segments = 6
		link.mesh = tm
		link.material_override = m
		link.position = Vector3(0, 0, k * 0.42)
		link.rotation = Vector3(0, 0, (PI * 0.5) * (k % 2))   # halka düzlemi zincir eksenini içerir, sırayla 90° döner: birbirine geçer (eskiden eksene dikti: ayrık pullar gibiydi)
		link.scale = Vector3(1, 1, 1.5)
		root.add_child(link)
	return root


## Kuyruk Söküm Yöntemi: hedefin altında su yansımalı mühür havuzu, çakrası yukarı sökülür — çakra emilir, bağlanır
