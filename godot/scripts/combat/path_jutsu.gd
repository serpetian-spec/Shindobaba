func p_bashosen_mizu_no_maki(c: Node3D, t: Node3D) -> void:
	var d = fwd(c, t)
	var side = d.cross(Vector3.UP).normalized()
	bashosen_fan(c, Color(0.4, 0.7, 1.0))
	after(0.35, func():
		var wave = MeshInstance3D.new()
