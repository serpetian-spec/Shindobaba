		body.count = 18
		body.spacing = 1.1
		body.radius = 1.6
		body.mat = sm
		get_tree().current_scene.add_child(body)
		var age = {"t": 0.0}
		pr.on_tick = func(p2, dt):
			age["t"] += dt
			var sd = p2.vel.cross(Vector3.UP).normalized()
			p2.global_position += sd * sin(age["t"] * 6.0) * dt * 5.0
			if randf() < 0.6:
