	for k in 3:
		after(k * 0.08, func():
			if not live(c):
				return
			var pr = shot(c, from, d, 42.0, Node3D.new(), inf(c, "futon_shinkuha", 0.37, {"knock": 5.0, "kind": "heavy", "element": "fuuton", "bleed": 2.0}), null, true, 0.75)
			pr.radius = 1.3
			for q in 7:
				var o2 = from + sd * (q - 3) * 0.3
