		tw2.tween_interval(0.35)
		tw2.tween_callback(ch.queue_free)
		mhit(c, c.global_position + Vector3.UP + c.face_dir() * 1.5, 3.0, inf(c, "kamuibashiri", 1.6, {"knock": 12.0, "kind": "heavy", "stun": 0.5})))
