func p_suiton_mizu_shibari(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 16.0)
	busy(c, 0.6)
	if tt == null:
		return
	var at = tt.global_position
	var root = Node3D.new()
	get_tree().current_scene.add_child(root)
	root.global_position = at
	for k in 2:
		var mi = MeshInstance3D.new()
