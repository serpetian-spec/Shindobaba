# ================================================================== Yeni jutsular J (Sv.18): ahşap, Rasengan, şimşek, kum, demir kum
const IRONSAND := Color(0.12, 0.12, 0.15)
const PURPLE_RAI := Color(0.75, 0.5, 1.0)


func _wood_mat() -> Material:
	var m = StandardMaterial3D.new()
	m.albedo_color = WOOD.lightened(0.15)
	m.emission_enabled = true
	m.emission = WOOD * 0.35
	m.roughness = 0.9
	return m


func _iron_mat() -> Material:
	# ref (Sandaime Kazekage): mat kara demir kumu, hafif gri parıltı (eskiden açık parlak: gümüş görünüyordu)
	# su malzemesi beyaz köpük şeritleri çiziyordu (siyah-beyaz zebra) -> mat kara toon (ref: koyu, kumlu demir)
	if not VFX._cache.has("iron_sand_mat"):
		VFX._cache["iron_sand_mat"] = Props.toon_color(Color(0.09, 0.09, 0.11))
	return VFX._cache["iron_sand_mat"]


## Elde Rasengan (dur sn), s boyut
func _ras_hand(c: Node3D, dur: float, s := 0.4, side := "RightHand") -> void:
	var ba = bone_attach(c, side)
	if ba == null:
		return
	ba.add_child(VFX.rasengan(s))
	free_after(dur, ba)


## Ahşap Kilit Duvarı: yerden kemerli ahşap kubbe yükselir, içindekileri korur
func p_mokuton_mokujoheki(c: Node3D, _t: Node3D) -> void:
	# anime: kullanıcının üstünde yerden fışkıran dolu yarım silindir ahşap tünel — kesik uçları açık turuncu, gövde kahverengi
	busy(c, 0.6)
	var at = gp(c.global_position)
	var b = MB.new()
	var ol = PackedVector2Array()
	var RO = 3.0
	var RI = 2.5
	for k in 29:
		var a = PI * k / 28.0
		ol.append(Vector2(sin(a) * RO, cos(a) * RO))
	for k in 29:
		var a = PI * (28 - k) / 28.0
		ol.append(Vector2(sin(a) * RI, cos(a) * RI))
	b.add_slab(ol, 5.2, Color(0.86, 0.52, 0.27), Transform3D.IDENTITY, Callable(), WOOD_C)
	b.add_slab(ol, 5.2, Color(0.86, 0.52, 0.27), Transform3D(Basis.from_scale(Vector3(-1, 1, 1)), Vector3.ZERO), Callable(), WOOD_C.darkened(0.15))   # ters sargı: kabuk iki yandan da görünür
	for q in 3:   # kesitte yıllık halkalar
		var rr = lerpf(RI, RO, (q + 1) / 4.0)
		for k in 28:
			var a0 = PI * k / 28.0
			var a1 = PI * (k + 1) / 28.0
			for sx in [-1.0, 1.0]:
				var p0 = Vector3(sx * 2.605, sin(a0) * rr, cos(a0) * rr)
				var p1 = Vector3(sx * 2.605, sin(a1) * rr, cos(a1) * rr)
				var xf = Transform3D(Basis.looking_at((p1 - p0).normalized(), Vector3.RIGHT), (p0 + p1) * 0.5)
				b.add_xf("box", xf.scaled_local(Vector3(0.01, 0.04, p0.distance_to(p1) + 0.01)), Color(0.7, 0.4, 0.2))
	var root = mesh_of(b, Props.bark_toon())
	get_tree().current_scene.add_child(root)
	root.global_position = at
	var fd = c.face_dir()
	root.rotation.y = atan2(-fd.z, fd.x)   # tünel ekseni bakış yönünde
	root.scale = Vector3(1, 0.05, 0.05)
	var tw = root.create_tween()
	tw.tween_property(root, "scale", Vector3.ONE, 0.35).set_trans(Tween.TRANS_BACK)
	tw.tween_interval(5.0)
	tw.tween_property(root, "scale", Vector3(1, 0.05, 0.05), 0.4)
	tw.tween_callback(root.queue_free)
	_earth_burst(at, 2.0)
	if c is Player:
		Buffs.add("mokujoheki", 5.0, {"armor": 0.15, "_name": "Ahşap Kubbe", "_desc": "ahşap kubbe seni koruyor"})
	elif c.has_method("add_buff"):
		c.add_buff("mokujoheki", 5.0, {"armor": 0.15})   # AI aynı koruma
	# kanon: yakındaki düşman kubbenin içinde kapana kısılır
	for e in enemies_near(c, at, 2.6):
		st(e, "bind", 1.5)
	Sfx.play("earth", at, 0.8)


