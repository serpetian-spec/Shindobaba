## Metal shuriken (4 sivri kanat, ortada delik halkası) — kaifūjutsu/enbu yağmurları için
func _steel_star(sz := 1.0) -> MB:
	var b = MB.new()
	for k in 4:
		var a = k * 90.0
		var d = Vector3(cos(deg_to_rad(a)), 0, sin(deg_to_rad(a)))
		b.add("cone", d * 0.1 * sz, Vector3(0.09 * sz, 0.2 * sz, 0.012), Color(0.62, 0.63, 0.68), Vector3(90, -a + 90, 0), 3)
	b.add("cyl", Vector3.ZERO, Vector3(0.09 * sz, 0.02, 0.09 * sz), Color(0.3, 0.3, 0.34), Vector3.ZERO, 8)
	return b


## Mühür Çözme: Shuriken (ref: mühür kâğıdını öne uzatır, kâğıttan patlayan duman halkası içinden onlarca shuriken
## yelpaze gibi fırlar). Hazırlıkta parşömen iki elde açılır; bırakışta kâğıt yüzünden mühür ışığı + dalga dalga shuriken
func form_kaifujutsu_shuriken(c: Node3D, rt: float) -> void:
	c.set_meta("pj_scroll", hold_scroll(c, rt + 1.1, 0.42, 0.6))


func p_kaifujutsu_shuriken(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 24.0)
	busy(c, 1.2)
	var sc = _held(c)
	var fd: Vector3 = c.face_dir()
	fd.y = 0
	fd = fd.normalized()
	var o = (sc.global_position if sc else c.global_position + Vector3.UP * 1.3) + fd * 0.25
	if sc:
		fade_free(sc, 1.05, 0.2)
	# mühür açılışı: kâğıt yüzünde kara yazı halkası + kısa beyaz parlama (duman bulutu yok)
	FX.ring(o, Color(0.1, 0.08, 0.06), 1.2, 0.3, false)
	VFX.star(o, Color(1.0, 0.97, 0.85), 1.0)
	Sfx.play("poof", o, 1.4, 0.4)
	var side = fd.cross(Vector3.UP).normalized()
	for wave in 4:   # dört dalga, her dalga yelpaze (sol→sağ) 9 shuriken + 3 kunai
		for k in 12:
			after(0.06 + wave * 0.2 + k * 0.012, func():
				if not live(c):
					return
				var f = (k / 11.0) - 0.5
				var aim = aim_at(c, tt, o)
				var dir = (aim + side * f * 0.7 + Vector3.UP * randf_range(-0.05, 0.12)).normalized()
				var from = o + side * f * 0.4
				var is_kunai = k % 4 == 3
				var b: MB
				if is_kunai:
					b = MB.new()
					b.add("cone", Vector3(0, 0, 0.16), Vector3(0.05, 0.3, 0.02), Color(0.55, 0.56, 0.6), Vector3(90, 0, 0), 4)
					b.add("cyl", Vector3(0, 0, -0.04), Vector3(0.025, 0.14, 0.025), Color(0.2, 0.18, 0.16), Vector3(90, 0, 0), 6)
				else:
					b = _steel_star(1.7)
				var pr = shot(c, from, dir, 38.0, mesh_of(b), inf(c, "kaifujutsu_shuriken", 0.12, {"knock": 1.0, "kind": "light", "bleed": 1.0}), tt if wave % 2 == 0 else null, false, 0.9)
				if pr and not is_kunai:
					pr.spin = Vector3(0, 32.0, 0))
	Sfx.play("kunai", c.global_position, 1.3)


## Hayalet Çoklu Shuriken: tek shuriken havada onlarca hayalet kopyaya bölünür, hedefin çevresine yağar
func p_genei_taju_shuriken(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 26.0)
	busy(c, 0.8)
	var o = hand_pos(c)
	var dest = (tt.global_position + Vector3.UP if is_instance_valid(tt) else o + fwd(c, t) * 18.0)
	var mid = o.lerp(dest, 0.4) + Vector3.UP * 3.0
	for k in 16:
		after(0.3 + k * 0.02, func():
			if not live(c):
				return
			var b = MB.new()
			b.add("box", Vector3.ZERO, Vector3(0.3, 0.02, 0.3), Color(0.5, 0.5, 0.58, 0.8), Vector3(0, 45, 0))
			var target = dest + Vector3(randf_range(-2.0, 2.0), randf_range(-0.6, 0.6), randf_range(-2.0, 2.0))
			var pr = shot(c, mid, (target - mid).normalized(), 30.0, mesh_of(b), inf(c, "genei_taju_shuriken", 0.2, {"knock": 1.0, "kind": "light", "bleed": 1.0}), null, false, 0.8)
			if pr:
				pr.spin = Vector3(0, 30.0, 0))
	VFX.star(mid, Color(0.8, 0.85, 1.0), 1.5)
	Sfx.play("kunai", c.global_position, 1.2)


## Enbu: Ni no Dan (ref: dönen beyaz hortumun içinden dışa savrulan silahlar). Sıçrayıp kendi ekseninde döner;
## bedeni saran çok katlı rüzgâr hortumu (akım çizgileri) yükselir, hortumda sarmal çizerek dönen kunai/shuriken
## halkası oluşur, sonra hepsi hortumdan dışa (hedefe) savrulur
func p_enbu_ni_no_dan(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 22.0)
	busy(c, 1.4)
	if c.get("velocity") != null:
		c.velocity.y = 12.0
	var gray = Color(0.94, 0.95, 1.0, 0.85)
	for L in 3:   # hortum: üç kat swirl, gövdeyi takip eder
		after(L * 0.08, func():
			if live(c):
				WindFX.swirl(c.global_position + Vector3.UP * (0.2 + L * 0.6), 1.0 + L * 0.35, 3.6, 1.2, 12, gray, L == 0))
	for k in 10:   # hortum boyunca yükselen ince sarmal çizgiler
		var ph = k * TAU / 10.0
		WindFX.streak(func(q: float) -> Vector3:
			var cp = c.global_position if is_instance_valid(c) else Vector3.ZERO
			return cp + Vector3(cos(ph + q * 9.0) * (0.7 + q * 0.9), q * 4.2, sin(ph + q * 9.0) * (0.7 + q * 0.9)),
			1.1, 0.05, gray, 0.1 + k * 0.03, 22)
	# hortumda dönen silah halkası
	var orbit = []
	for k in 16:
		var b: MB
		if k % 2 == 0:
			b = _steel_star(1.2)
		else:
			b = MB.new()
			b.add("cone", Vector3(0, 0, 0.16), Vector3(0.05, 0.32, 0.02), Color(0.55, 0.56, 0.6), Vector3(90, 0, 0), 4)
			b.add("cyl", Vector3(0, 0, -0.05), Vector3(0.025, 0.14, 0.025), Color(0.2, 0.18, 0.16), Vector3(90, 0, 0), 6)
		var m = mesh_of(b)
		scene_add(m, c.global_position)
		orbit.append(m)
	var t0 = Game.now()
	every(0.75, 1.0 / 60.0, func(_i, _k):
		if not is_instance_valid(c):
			return
		var u = Game.now() - t0
		for k in orbit.size():
			var m = orbit[k]
			if not is_instance_valid(m):
				continue
			var a = k * TAU / orbit.size() + u * 11.0
			var h = 0.5 + fmod(k * 0.37, 1.0) * 2.4
			m.global_position = c.global_position + Vector3(cos(a), 0, sin(a)) * (1.1 + u * 0.6) + Vector3.UP * h
			m.look_at(m.global_position + Vector3(-sin(a), 0, cos(a)), Vector3.UP)
			m.rotate_object_local(Vector3.UP, u * 30.0), func():
		for k in orbit.size():   # savrulma: her silah bulunduğu yerden hedefe
			var m = orbit[k]
			if not is_instance_valid(m):
				continue
			var from = m.global_position
			m.queue_free()
			if not live(c):
				continue
			var b2: MB = _steel_star(1.2) if k % 2 == 0 else null
			if b2 == null:
				b2 = MB.new()
				b2.add("cone", Vector3(0, 0, 0.16), Vector3(0.05, 0.32, 0.02), Color(0.55, 0.56, 0.6), Vector3(90, 0, 0), 4)
			var pr = shot(c, from, aim_at(c, tt, from).rotated(Vector3.UP, randf_range(-0.12, 0.12)), 36.0, mesh_of(b2), inf(c, "enbu_ni_no_dan", 0.2, {"knock": 1.0, "kind": "light", "bleed": 1.0}), tt if k % 3 == 0 else null, false, 0.9)
			if pr and k % 2 == 0:
				pr.spin = Vector3(0, 30.0, 0)
		if live(c):
			WindFX.blast(c.global_position + Vector3.UP, 3.0, 18, gray, false))
	Sfx.play("whoosh", c.global_position, 1.2)


## Sōgu: Tensasai — havadaki dev zincirli silahlar ve gürzler gökten hedefin üstüne çöker
func p_sogu_tensasai(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 26.0)
	busy(c, 1.4)
	var at = gp(tt.global_position if tt else c.global_position + fwd(c, t) * 10.0)
	var tpos = func() -> Vector3: return gp(tt.global_position) if tt and live(tt) else at
	# anime: elde açılan parşömen göğe fırlatılır, düşmanın tam üstünde açık durur; silahlar parlak beyaz çizgilerle düşmana iner
	var sky = at + Vector3(0, 15.0, 0) - fwd(c, t) * 1.5
	var scr = _held(c)
	if scr == null:
		scr = scroll_node(0.42, 0.7)
		scene_add(scr, live_hand(c, true))
		scroll_len(scr, 0.5)
	var yaw = atan2(fwd(c, t).x, fwd(c, t).z)
	var goal = Transform3D(Basis.from_euler(Vector3(deg_to_rad(-55), yaw, 0)).scaled(Vector3.ONE * 6.0), sky)   # kâğıt yüzü aşağı, atana dönük
	var l0 = scr.get_node("paper").scale.y * 0.7
	var ftw = scr.create_tween().set_parallel()
	ftw.tween_property(scr, "global_transform", goal, 0.38).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	ftw.tween_method(func(v): scroll_len(scr, v), l0, 0.7, 0.38)
	Sfx.play("whoosh", hand_pos(c, true), 1.3)
	fade_free(scr, 1.9, 0.3)
	for k in 26:
		after(0.42 + k * 0.035, func():
			var from = sky + Vector3(randf_range(-2.0, 2.0), randf_range(-0.5, 0.5), randf_range(-2.0, 2.0))
			var to = tpos.call() + Vector3(randf_range(-0.9, 0.9), 0.1, randf_range(-0.9, 0.9))   # düşmanın tam üstüne
			WindFX.streak(func(q: float) -> Vector3: return from.lerp(to, q), 0.45, 0.12, Color(1, 1, 1))
			var pr = throw_weapon(c, "sogu_tensasai", WEAPON_KINDS[k % WEAPON_KINDS.size()], from, to, 60.0, 0.04, tt if tt and live(tt) else null)
			pr.on_hit = func(pos: Vector3, _tg: Node3D) -> void:
				hit(c, pos, 1.2, inf(c, "sogu_tensasai", 0.04, {"knock": 1.5, "kind": "light"}))
			if k % 5 == 0:
				Sfx.play("kunai", from, randf_range(0.8, 1.2), 0.6))
	for k in 7:
		after(0.5 + k * 0.1, func():
			var p = tpos.call() + Vector3(randf_range(-1.0, 1.0), 0, randf_range(-1.0, 1.0))
			var b = MB.new()
			if k % 2 == 0:
				b.add("sphere", Vector3.ZERO, Vector3(0.9, 0.9, 0.9), Color(0.35, 0.35, 0.38))
				for s in 6:
					b.add("cone", Vector3(cos(s * 1.05), 0, sin(s * 1.05)) * 0.45, Vector3(0.15, 0.4, 0.15), Color(0.35, 0.35, 0.38), Vector3(0, 0, 90), 4)
			else:
				b.add("box", Vector3.ZERO, Vector3(0.12, 2.4, 0.4), Color(0.6, 0.6, 0.65))
			var w = mesh_of(b)
			scene_add(w, p + Vector3.UP * 14.0)
			var src = sky
			tether(func(): return src, func(): return w.global_position if is_instance_valid(w) else src, 0.03, Props.toon_color(Color(0.4, 0.4, 0.42)), 0.6)
			var tw = w.create_tween()
			tw.tween_property(w, "global_position", p + Vector3.UP * 0.4, 0.3).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
			tw.tween_callback(func():
				VFX.cracks(p, 1.6)
				WindFX.soft_dust(p, {"amount": 8, "size": 0.6, "radius": 0.6, "life": 0.6}, WindFX.dust_col(p))
				mhit(c, p + Vector3.UP, 1.6, inf(c, "sogu_tensasai", 0.25, {"knock": 8.0, "kind": "heavy"})))
			tw.tween_interval(0.8)
			tw.tween_callback(w.queue_free))
	Sfx.play("earth", at, 1.0)


## Sō Shuriken: telli shurikenler hedefin çevresinde döner, teller çekilince hedefi sarıp bağlar
func p_soshuriken_no_jutsu(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 20.0)
	busy(c, 1.0)
	if tt == null:
		return
	var o = hand_pos(c)
	for k in 3:
		var a = k * TAU / 3.0
		after(0.15 + k * 0.08, func():
			if not (live(c) and live(tt)):
				return
			var p1 = tt.global_position + Vector3.UP * 1.0 + Vector3(cos(a), 0, sin(a)) * 1.2
			WindFX.streak(func(q: float) -> Vector3: return o.lerp(p1, q), 0.4, 0.015, Color(0.85, 0.85, 0.9), 0.0, 8)
			WindFX.streak(func(q: float) -> Vector3: return p1 + Vector3(cos(a + q * TAU), 0, sin(a + q * TAU)) * 0.2, 0.4, 0.015, Color(0.85, 0.85, 0.9), 0.3, 8))
	after(0.6, func():
		if live(tt):
			st(tt, "bind", 2.5)
			Combat.popup_text(tt.global_position + Vector3.UP * 2.4, "Tellerle bağlandı!", Color(0.85, 0.85, 0.9))
			tt.take_hit(inf(c, "soshuriken_no_jutsu", 0.8, {"knock": 0.0, "kind": "heavy", "bleed": 2.0})))
	Sfx.play("kunai", c.global_position, 1.1)


# ================================================================== Shakuton: Pakura tarzı ara teknikler (kanonda adı geçmeyen, tarza uygun)
## Kavurucu Küre: avuçta tek kavurucu küre toplanır, fırlar; isabet ettiği yerden beyaz buhar fışkırır
func p_shakuton_shakkyu(c: Node3D, t: Node3D) -> void:
	busy(c, 0.6)
	var tt = tg(c, t, 24.0)
	after(0.25, func():
		if not live(c):
			return
		var from = hand_pos(c)
		var pr = shot(c, from, aim_at(c, tt, from), 26.0, VFX.scorch_orb(0.55), inf(c, "shakuton_shakkyu", 1.0, {"knock": 4.0, "kind": "heavy", "element": "shakuton", "burn": 2.0}), tt, false, 1.4, func(p, _h):
			VFX.puffs(p, {"amount": 18, "life": 1.0, "size": 0.7, "radius": 0.4, "vmin": 2, "vmax": 4, "dir": Vector3.UP, "spread": 50.0, "add": false,
				"colors": [Color(1, 1, 1, 0.9), Color(0.9, 0.9, 0.95, 0)]})
			_scorch_hit(p, 0.8))
		_scorch_trail(pr, 0.45))
	Sfx.play("fire", c.global_position, 1.2)


## Kavurucu Kılıç: kılıcın ağzı kavurucu chakrayla sarılır; üç kesik, her isabet hedefi içten kurutur (yavaşlatır)
func p_shakuton_shakken(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 7.0)
	busy(c, 1.0)
	_ensure_blade(c, 1.0)
	var ba = bone_attach(c, "RightHand")
	if ba:
		ba.add_child(VFX.scorch_orb(0.3))
		free_after(1.0, ba)
	_jump_at(c, tt, 0.0, 9.0)
	for k in 3:
		after(0.2 + k * 0.18, func():
			if not live(c):
				return
			var d = c.face_dir()
			var hits = _blade_cut(c, c.global_position + Vector3.UP * 1.1, d, -60.0 + k * 30.0, 50.0 + k * 30.0, 1.7, "shakuton_shakken", 0.7, {"element": "shakuton", "burn": 2.0}, Color(1.0, 0.45, 0.48))
			for h in hits:
				if live(h):
					st(h, "slow", 1.5)
					VFX.puffs(h.global_position + Vector3.UP * 1.2, {"amount": 8, "life": 0.8, "size": 0.5, "radius": 0.3, "vmin": 1, "vmax": 3, "dir": Vector3.UP, "spread": 50.0, "add": false,
						"colors": [Color(1, 1, 1, 0.85), Color(0.9, 0.9, 0.95, 0)]}))
	Sfx.play("blade", c.global_position, 1.0)


## Dönen Kavurucu Küreler: üç küre 8 sn bedeninin çevresinde döner; yaklaşanı kavurur, gelen küçük mermileri yakar
func p_shakuton_kaiten_shakkyu(c: Node3D, _t: Node3D) -> void:
	busy(c, 0.6)
	var orbs = []
	for k in 3:
		var o = VFX.scorch_orb(0.45)
		c.add_child(o)
		orbs.append(o)
	if c is Player:
		Buffs.add("kaiten_shakkyu", 8.0, {"armor": 0.15, "_name": "Dönen Kavurucu Küreler", "_desc": "yaklaşanı kavurur"})
	every(8.0, 0.03, func(_i, _k):
		for k in orbs.size():
			var o = orbs[k]
			if is_instance_valid(o):
				var a = _k * TAU * 6.0 + k * TAU / 3.0
				o.position = Vector3(cos(a) * 1.5, 1.2 + sin(a * 2.0) * 0.2, sin(a) * 1.5)
		if _i % 15 == 0 and live(c):
			for e in enemies_near(c, c.global_position, 2.2):
				e.take_hit(inf(c, "shakuton_kaiten_shakkyu", 0.3, {"knock": 5.0, "kind": "light", "element": "shakuton", "burn": 1.0}))
			for p in get_tree().get_nodes_in_group("projectiles"):
				if p.get("shooter") != c and p.global_position.distance_to(c.global_position + Vector3.UP) < 2.0:
					VFX.puffs(p.global_position, {"amount": 6, "life": 0.5, "size": 0.4, "radius": 0.2, "vmin": 1, "vmax": 2, "dir": Vector3.UP, "spread": 60.0, "add": false,
						"colors": [Color(1, 1, 1, 0.8), Color(1, 1, 1, 0)]})
					p.queue_free(), func():
		for o in orbs:
			if is_instance_valid(o):
				o.queue_free())
	Sfx.play("fire", c.global_position, 0.9)


## Shakuton isabeti: alev/patlama yok — kızıl parlama ve hedeften fışkıran beyaz buhar (beden suyu buharlaşır)
func _scorch_hit(at: Vector3, s := 1.0, h: Node3D = null) -> void:
	FX.light(at, Color(1.0, 0.35, 0.35), 3.0 * s, 7.0 * s, 0.2)
	VFX.puffs(at, {"amount": int(22 * s), "life": 1.1, "size": 0.8 * s, "radius": 0.4 * s, "vmin": 2, "vmax": 5, "dir": Vector3.UP, "spread": 55.0, "add": false,
		"colors": [Color(1, 1, 1, 0.95), Color(1.0, 0.85, 0.85, 0.6), Color(0.95, 0.92, 0.92, 0)]})
	if h and live(h):
		# kuruyan beden: 2 sn boyunca hedeften buhar tüter
		every(2.0, 0.2, func(_i, _k):
			if live(h):
				VFX.puffs(h.global_position + Vector3.UP * 1.1, {"amount": 4, "life": 0.9, "size": 0.45, "radius": 0.35, "vmin": 1, "vmax": 2, "dir": Vector3.UP, "spread": 40.0, "add": false,
					"colors": [Color(1, 1, 1, 0.85), Color(1, 1, 1, 0)]}))


## Shakuton küresinin izi: beyazdan kızıla incelen yumuşak kurdele (anime: kürenin arkasındaki parlak iz)
func _scorch_trail(pr: Node3D, w := 0.5) -> void:
	if pr:
		Projectile.trail(pr, [Color(1, 0.97, 0.95, 0.9), Color(1.0, 0.3, 0.32, 0.6), Color(1.0, 0.2, 0.25, 0)], w, 30, 0.35, null, true)
