## Silah meshleri (uç = -Z): her biri ayrı biçim
func weapon_mesh(kind: String) -> ArrayMesh:
	return cached("wpn_" + kind, func():
		var b = MB.new()
		var steel = Color(0.78, 0.8, 0.86)
		var dark = Color(0.22, 0.2, 0.22)
		var wrap = Color(0.55, 0.18, 0.15)
		match kind:
			"kunai":
