	var cone = mesh_of(rb)
	var lb = MB.new()
	lb.add("sphere", Vector3(0, 1.55, 0), Vector3(1.1, 0.35, 1.1), Color.WHITE, Vector3.ZERO, 14)
	var pool = mesh_of(lb, VFX.lava_mat("molten"))
