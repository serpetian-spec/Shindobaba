	"kanat": {"name": "Kanatlı Form", "skin": Color(0.56, 0.52, 0.6), "desc": "Sırttan el kanatlar: uçabilirsin (Space/Ctrl)",
		"mods": {"melee": 1.25, "jutsu": 1.2, "speed": 1.15}},
