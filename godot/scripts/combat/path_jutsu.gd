## Çoklu Shuriken Klonu: tek shuriken havada yüzlerce kopyaya bölünüp yağmur gibi iner
func p_sarutobi_shuriken_tajuu(c: Node3D, t: Node3D) -> void:
	# kanon (Hiruzen): bir-iki gerçek shuriken fırlatılır, havada küçük bir dumanla yüzlercesine bölünür ve hedef bölgesine yağar.
	# shuriken modeli oyuncunun fırlattığıyla aynı (CharacterModel._w_star), görünür boyda ve dönen
	busy(c, 0.9)
	var tt = tg(c, t, 28.0)
	var at = gp(tt.global_position if tt else c.global_position + fwd(c, t) * 12.0)
	anim(c, "throw", 1.4)
	var mk = func(scale: float) -> Node3D:
		var sb = MB.new()
		CharacterModel._w_star(sb, Vector3.ZERO, 0.19 * scale, 0.06 * scale, 4, Color(0.62, 0.64, 0.68), Color(0.15, 0.15, 0.17))
		var b = MB.new()
		b.add_mesh(sb, Transform3D(Basis(Vector3.RIGHT, PI * 0.5), Vector3.ZERO))
		return mesh_of(b, Props.toon())
	var split = []
	after(0.15, func():
		if not live(c):
			return
		for q in 2:
			var from = hand_pos(c, true)
			var mid = from.lerp(at + Vector3.UP * 1.2, 0.35) + Vector3.UP * (1.2 + q * 0.4)
			var sh = mk.call(1.6)
			scene_add(sh, from)
			var tw = sh.create_tween()
			tw.tween_property(sh, "global_position", mid, 0.22)
			tw.tween_callback(sh.queue_free)
			var spin = sh.create_tween().set_loops(8)
			spin.tween_property(sh, "rotation:y", TAU, 0.05).as_relative()
			split.append(mid))
	after(0.4, func():
		if not live(c) or split.is_empty():
			return
		for mp in split:
			FX.smoke_puff(mp, 0.7, 8)   # Kage Bunshin dumanı: bölünme anı
		for k in 70:
			var from: Vector3 = split[k % split.size()] + Vector3(randf_range(-0.8, 0.8), randf_range(-0.5, 0.5), randf_range(-0.8, 0.8))
			var goal = at + Vector3(randf_range(-4.0, 4.0), randf_range(0.3, 1.6), randf_range(-4.0, 4.0))
			var pr = shot(c, from, (goal - from).normalized(), randf_range(30.0, 38.0), mk.call(1.7), inf(c, "sarutobi_shuriken_tajuu", 0.065, {"knock": 1.0, "kind": "light", "bleed": 1.0}), null, false, 1.0)
			pr.spin = Vector3(0, 28.0, 0))
	Sfx.play("throw", c.global_position, 1.0)


## Şimşek Canavarı İz Süren Diş: kılıç ucundan şimşek tazısı fırlar, hedefi izleyip ısırır
func p_hatake_raiju_tsuiga(c: Node3D, t: Node3D) -> void:
	# anime (Kakashi): Raikiri chakrası yere yakın dörtnala koşan, kırmızı gözlü dev bir şimşek tazısına döner — gövdesi
	# sürekli çatırdayan dallı şimşeklerle sarılı, hedefe kilitlenip ısırır. Köpek gövdesi ortak RantonArt.hound (eklemli dörtnal),
	# raiton görünüşü: gövde boyunca çakan beyaz-mavi şimşek dalları + kırmızı gözler (Ranton Kōga'nın pürüzsüz ışık tazısından ayrı).
	busy(c, 0.8)
	var tt = tg(c, t, 30.0)
	_rai_hand(c, 0.8)
	after(0.3, func():
		if not live(c):
			return
		var d = fwd(c, tt)
		var head = Node3D.new()
		var hound = RantonArt.hound(3.2)   # anime: insan boyunu aşan dev tazı
		hound.position.y = -1.3
		head.add_child(hound)
		var eb = MB.new()
		for sx in [-1.0, 1.0]:
			eb.add("sphere", Vector3(sx * 0.075, 0.71, 0.82) * 3.2, Vector3(0.07, 0.045, 0.05) * 3.2, Color(1.0, 0.15, 0.12), Vector3(0, 0, sx * -15.0), 8)
		var eyes = MeshInstance3D.new()
		eyes.mesh = eb.build(null)
		var em = StandardMaterial3D.new()
		em.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		em.albedo_color = Color(1.0, 0.15, 0.12)
		eyes.material_override = em
		eyes.position.y = -1.3
		head.add_child(eyes)
		var pr = shot(c, gp(c.global_position + d) + Vector3.UP * 1.3, d, 24.0, head, inf(c, "hatake_raiju_tsuiga", 2.0, {"knock": 10.0, "kind": "heavy", "element": "raiton", "stun": 1.2}), tt, false, 2.0, func(p, _h):
			impact_fx("raiton", RAI, p, 1.6))
		every(2.0, 0.035, func(_i, _k):
			if is_instance_valid(pr):
				var bd = pr.global_basis
				for q in 2:   # gövde boyunca (baş -> kuyruk) çakan dallı şimşekler
					var along = randf_range(-1.8, 1.6)
					var p0 = pr.global_position + bd.z * along + Vector3.UP * randf_range(-0.5, 0.6)
					VFX.bolt(p0, p0 + Vector3(randf_range(-1.4, 1.4), randf_range(-0.6, 1.4), randf_range(-1.4, 1.4)), Color(0.85, 0.95, 1.0) if q == 0 else RAI, 0.08, 0.09, 2), Callable()))
	Sfx.play("chidori", c.global_position, 1.2)


