	for k in n:
		var a = k * TAU / n + randf_range(-0.15, 0.15)
		var land = gp(at + Vector3(cos(a), 0, sin(a)) * randf_range(1.6, 3.4)) + Vector3.UP * 0.03
		var b = MB.new()
