			tw.tween_property(ch, "scale", Vector3.ONE, 0.2)
			tw.tween_interval(1.2)
			tw.tween_property(ch, "scale", Vector3(1, 1, 0.02), 0.2)
			tw.tween_callback(ch.queue_free)
		after(0.22, func():
			if live(tt) and live(c):
				st(tt, "bind", 2.2)
