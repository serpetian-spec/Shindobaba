		Combat.popup_text(e.global_position + Vector3.UP * (e.height + 0.8), "Sezildi", Color(0.9, 0.9, 1.0))
	every(dur, 1.4, func(i, _k):
		if not is_instance_valid(c) or (c is Player and not Buffs.has("hakuja")):
