## Büyük Kedi Pençesi: elde mavi çakradan dev kedi pençesi, girdap çizerek savrulur
func p_daibyo_sogeki(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 7.0)
	var d = _jump_at(c, tt, 3.0, 12.0 if tt else 4.0)
