	tw.tween_callback(husk.queue_free)
	FX.burst(c.global_position + Vector3.UP, {"amount": 26, "life": 0.7, "size": 0.6, "vmin": 2, "vmax": 7, "colors": [Color(0.85, 0.85, 0.75), Color(0.6, 0.7, 0.5, 0)]})
