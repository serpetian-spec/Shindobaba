			tw.tween_interval(0.4)
			tw.tween_property(tent, "scale", Vector3(1, 0.05, 1), 0.2)
			tw.tween_callback(tent.queue_free))
	shake(0.6)
	Sfx.play("earth", c.global_position, 0.7)


