		return
	var a = gp(tt.global_position + Vector3(1.5, 0, 0)) - Vector3.UP * 0.5
	var h = make_snake(a, MITA, 0.8, 12)
	VFX.cracks(gp(tt.global_position), 2.0)
	every(3.0, 1.0 / 40.0, func(_i, k):
		if not (is_instance_valid(h) and live(tt)):
