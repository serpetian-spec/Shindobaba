func p_otsutsuki_tsubasa(c: Node3D, _t: Node3D) -> void:
	busy(c, 0.6)
	var root = Node3D.new()
	c.add_child(root)
	root.position = Vector3(0, 1.4, -0.25)
	for sx in [-1.0, 1.0]:
		for k in 3:
			var f = MeshInstance3D.new()
			var bm = BoxMesh.new()
			bm.size = Vector3(1.6 - k * 0.3, 0.04, 0.35)
			f.mesh = bm
