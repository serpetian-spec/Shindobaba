## Daburu Nikudan Sensha (kanon, Chōji + Chōza ortak tekniği): iki kişi rakibe iki yandan Nikudan Sensha ile dalar, aradakini
## ezip öğütür. ORTAK GEREKİR: yakında (20 m) bir müttefik (takım arkadaşı, gölge klon, çağrı). Her top kendi sahibinin kıyafet
## renginde. Oyuncu ve AI aynı kural.
func p_daburu_nikudan_sensha(c: Node3D, t: Node3D) -> void:
	var partner: Node3D = null
	var best = 21.0
	for f in get_tree().get_nodes_in_group("fighters"):
		if f == c or f.is_dead() or Combat.hostile(c, f) or f is TailedBeast or f.get("team") != c.get("team"):
			continue
		var dd = f.global_position.distance_to(c.global_position)
		if dd < best:
			best = dd
			partner = f
	if partner == null:
		if c is Player:
			Hud.msg("Daburu Nikudan Sensha iki kişilik tekniktir: yakında bir ortak (takım arkadaşı, gölge klon, çağrı) olmalı.", Color(1.0, 0.7, 0.4))
		return
	busy(c, 1.6)
	var tt = tg(c, t, 24.0)
	var goal = gp(tt.global_position if tt else c.global_position + fwd(c, t) * 14.0)
	var users = [c, partner]
	for i in 2:
		var u: Node3D = users[i]
		var ball = _aki_ball(u, 1.6)
		get_tree().current_scene.add_child(ball)
		var side = (goal - c.global_position).cross(Vector3.UP).normalized() * (1.0 if i == 0 else -1.0)
		var start = gp(u.global_position) + Vector3.UP * 1.6
		var mid = goal + side * 1.7 + Vector3.UP * 1.6
		ball.global_position = start
		if u.get("model"):
			u.model.visible = false
		var hitd = {}
		every(1.4, 1.0 / 30.0, func(k, kk):
			if not is_instance_valid(ball):
				return
			var p = start.lerp(mid, minf(1.0, kk * 1.6)) if kk < 0.62 else mid + (goal - c.global_position).normalized() * (kk - 0.62) * 14.0
			ball.global_position = gp(p) + Vector3.UP * 1.6
			ball.rotate_object_local(Vector3.RIGHT, -0.5)
			if is_instance_valid(u):
				u.global_position = gp(ball.global_position)
			if k % 6 == 0:
				WindFX.soft_dust(gp(ball.global_position), {"amount": 4, "life": 0.7, "size": 1.0, "radius": 1.2, "vmin": 2.0, "vmax": 4.0, "dir": Vector3.UP, "spread": 70.0}, WindFX.dust_col(ball.global_position))
				VFX.cracks(gp(ball.global_position), 2.0)
			for e in enemies_near(c, ball.global_position, 2.2):
				if live(e) and Time.get_ticks_msec() - int(hitd.get(e.get_instance_id(), 0)) > 400:
					hitd[e.get_instance_id()] = Time.get_ticks_msec()
					hit(c, e.global_position + Vector3.UP, e.radius + 0.4, inf(c, "daburu_nikudan_sensha", 0.6, {"knock": 6.0, "launch": 2.0, "kind": "heavy", "pierce_guard": true})), func():
			if is_instance_valid(ball):
				FX.smoke_puff(ball.global_position, 1.0, 10)
				ball.queue_free()
			if is_instance_valid(u) and u.get("model"):
				u.model.visible = true)
	Sfx.play("whoosh", c.global_position, 0.6)


# ================================================================== VİDEO MOKUTON: eksik ahşap teknikleri (anime derlemesine göre)
const WOOD_C := Color(0.5, 0.36, 0.22)

## Yerden fışkıran, kıvrılarak büyüyen tahta gövde (kök/dal): dur sonra geri çekilir
func _wood_trunk(from: Vector3, to: Vector3, r: float, dur: float, delay := 0.0, bend := 0.5) -> Node3D:
	# kıvrık organik ahşap gövde: tabandan büyüyerek fışkırır (disk yığını değil, kabuk lifli pürüzsüz tüp)
	var root = Node3D.new()
	scene_add(root, gp(from))
	var mi = MeshInstance3D.new()
	mi.mesh = _wood_tube_mesh(to - gp(from), r, bend)
	root.add_child(mi)
	root.scale = Vector3.ONE * 0.02
	root.visible = delay <= 0.0
	var tw = root.create_tween()
	tw.tween_interval(delay)
	tw.tween_callback(func(): root.visible = true)
	tw.tween_property(root, "scale", Vector3.ONE, 0.4).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tw.tween_interval(dur)
	tw.tween_property(root, "scale", Vector3(0.5, 0.02, 0.5), 0.45).set_ease(Tween.EASE_IN)
	tw.tween_callback(root.queue_free)
	after(delay, func():
		VFX.debris(gp(from), EARTH, 5, 6.0, 0.3)
		VFX.cracks(gp(from), 1.6))
	return root


## Kabuk deseni: boyuna akan koyu lif çizgileri, ara ara düğüm halkası, üstte hafif ışık
func _bark_fn(base: Color) -> Callable:
	return func(t: float, ang: float, _sd) -> Color:
		var g = sin(ang * 6.0 + t * 4.0 + sin(t * 9.0) * 0.6)
		var col = base.darkened(0.3) if g > 0.78 else base
		if fmod(t * 7.0 + 0.3, 1.0) < 0.05:
			col = col.darkened(0.15)
		return col.lightened(0.07) if ang > 0.7 else col


## Yerel uzayda 0 -> d arası kıvrık gövde mesh'i; tabanda yayılan kök saçakları
func _wood_tube_mesh(d: Vector3, r: float, bend := 0.5, roots := 3) -> Mesh:
	var b = MB.new()
	var L = maxf(d.length(), 0.1)
	var up = d / L
	var s1 = up.cross(Vector3.FORWARD if absf(up.z) < 0.9 else Vector3.RIGHT).normalized()
	var s2 = up.cross(s1)
	var ph = randf() * TAU
	var pts = []
	var rad = []
	for i in 6:
		var t = i / 5.0
		var off = (s1 * cos(ph + t * 2.4) + s2 * sin(ph + t * 2.4)) * sin(t * PI) * bend * L * 0.14
		pts.append(d * t + off)
		rad.append(r * lerpf(1.3, 0.55, t))
	Loft.tube(b, pts, rad, WOOD_C, 12, 4, false, true, _bark_fn(WOOD_C))
	for k in roots:
		var a = ph + TAU * k / roots + randf() * 0.5
		var o = s1 * cos(a) + s2 * sin(a)
		Loft.tube(b, [up * r * 1.3 + o * r * 0.5, o * r * 1.7 + up * r * 0.25, o * r * 2.8 - up * r * 0.35], [r * 0.5, r * 0.32, r * 0.08], WOOD_C.darkened(0.08), 8, 3, false, true)
	return b.build(Props.bark_toon())


func _wood_house(at: Vector3, yaw: float, dur: float, big := false) -> Node3D:
	if big:
		return _wood_house_big(at, yaw, dur)
	var root = Node3D.new()
	scene_add(root, gp(at))
	root.rotation.y = yaw
	var b = MB.new()
	b.add("box", Vector3(0, 1.4, 0), Vector3(4.0, 2.8, 3.2), WOOD_C)
	b.add("prism", Vector3(0, 3.3, 0), Vector3(4.6, 1.2, 3.8), WOOD_C.darkened(0.2))
	for sx in [-1.0, 1.0]:
		for sz in [-1.0, 1.0]:
			b.add("cyl", Vector3(sx * 1.9, 1.4, sz * 1.5), Vector3(0.35, 2.9, 0.35), WOOD_C.darkened(0.25), Vector3.ZERO, 8)
	b.add("box", Vector3(0, 0.9, -1.62), Vector3(1.0, 1.8, 0.05), WOOD_C.darkened(0.45))
	root.add_child(mesh_of(b))
	var sb = StaticBody3D.new()
	var cs = CollisionShape3D.new()
	var sh = BoxShape3D.new()
	sh.size = Vector3(4.0, 2.8, 3.2)
	cs.shape = sh
	cs.position = Vector3(0, 1.4, 0)
	sb.add_child(cs)
	root.add_child(sb)
	root.scale = Vector3(1, 0.02, 1)
	var tw = root.create_tween()
	tw.tween_property(root, "scale", Vector3.ONE, 0.5).set_trans(Tween.TRANS_BACK)
	tw.tween_interval(dur)
	tw.tween_property(root, "scale", Vector3(1, 0.02, 1), 0.5)
	tw.tween_callback(root.queue_free)
	VFX.debris(gp(at), EARTH, 10, 7.0, 0.35)
	return root


## Shichūka evi (ref: iki katlı Japon evi): taş temel, dikey tahta kaplama, shōji pencereler, iki kat koyu kiremit saçak.
## İçine girilir (önde kapı boşluğu); duvarlar ve üst kat çarpışır.
func _wood_house_big(at: Vector3, yaw: float, dur: float) -> Node3D:
	var root = Node3D.new()
	scene_add(root, gp(at))
	root.rotation.y = yaw
	var b = MB.new()
	var W = 7.0
	var D = 5.0
	var H1 = 3.0
	var plank = WOOD_C.darkened(0.12)
	var roof = Color(0.26, 0.28, 0.32)
	var shoji = Color(0.93, 0.9, 0.8)
	b.add("box", Vector3(0, 0.2, 0), Vector3(W + 0.6, 0.4, D + 0.6), Color(0.55, 0.53, 0.5))   # taş temel
	b.add("box", Vector3(0, 0.4 + H1 * 0.5, D * 0.5 - 0.1), Vector3(W, H1, 0.2), WOOD_C)        # arka duvar
	for sx in [-1.0, 1.0]:
		b.add("box", Vector3(sx * (W * 0.5 - 0.1), 0.4 + H1 * 0.5, 0), Vector3(0.2, H1, D), WOOD_C)   # yan duvarlar
		b.add("box", Vector3(sx * W * 0.32, 0.4 + H1 * 0.5, -D * 0.5 + 0.1), Vector3(W * 0.36, H1, 0.2), WOOD_C)   # ön duvar (ortada kapı)
		b.add("box", Vector3(sx * W * 0.32, 0.4 + H1 * 0.55, -D * 0.5 - 0.02), Vector3(W * 0.22, H1 * 0.4, 0.04), shoji)   # shōji pencere
		for k in 3:   # pencere kafesi
			b.add("box", Vector3(sx * W * 0.32 + (k - 1) * W * 0.07, 0.4 + H1 * 0.55, -D * 0.5 - 0.05), Vector3(0.05, H1 * 0.4, 0.03), plank)
	for k in 11:   # dikey tahta çizgileri (ön/arka)
		var x = -W * 0.5 + 0.3 + k * (W - 0.6) / 10.0
		if absf(x) > 0.9:
			b.add("box", Vector3(x, 0.4 + H1 * 0.5, -D * 0.5 - 0.01), Vector3(0.06, H1, 0.03), plank)
		b.add("box", Vector3(x, 0.4 + H1 * 0.5, D * 0.5 + 0.01), Vector3(0.06, H1, 0.03), plank)
	for sx in [-1.0, 1.0]:
		for sz in [-1.0, 1.0]:
			b.add("cyl", Vector3(sx * (W * 0.5 - 0.05), 0.4 + H1 * 0.5, sz * (D * 0.5 - 0.05)), Vector3(0.3, H1, 0.3), WOOD_C.darkened(0.25), Vector3.ZERO, 8)
	b.add("box", Vector3(0, 0.4 + H1 + 0.08, 0), Vector3(W + 0.2, 0.16, D + 0.2), plank)          # kat döşemesi
	b.add("prism", Vector3(0, 0.4 + H1 + 0.55, 0), Vector3(W + 1.8, 0.8, D + 1.8), roof)           # alt saçak
	var y2 = 0.4 + H1 + 0.6
	b.add("box", Vector3(0, y2 + 1.2, 0), Vector3(W * 0.78, 2.4, D * 0.8), WOOD_C)                   # üst kat
	for sx in [-1.0, 1.0]:
		b.add("box", Vector3(sx * W * 0.2, y2 + 1.3, -D * 0.4 - 0.02), Vector3(W * 0.22, 1.0, 0.04), shoji)
	b.add("prism", Vector3(0, y2 + 2.4 + 0.75, 0), Vector3(W * 0.78 + 1.8, 1.5, D * 0.8 + 1.8), roof)   # üst çatı
	b.add("box", Vector3(0, y2 + 2.4 + 1.5, 0), Vector3(W * 0.8 + 1.8, 0.14, 0.3), roof.darkened(0.3))   # mahya
	root.add_child(mesh_of(b))
	var sb = StaticBody3D.new()
	for box in [[Vector3(0, 0.4 + H1 * 0.5, D * 0.5 - 0.1), Vector3(W, H1, 0.2)], [Vector3(-W * 0.5 + 0.1, 0.4 + H1 * 0.5, 0), Vector3(0.2, H1, D)],
			[Vector3(W * 0.5 - 0.1, 0.4 + H1 * 0.5, 0), Vector3(0.2, H1, D)], [Vector3(-W * 0.32, 0.4 + H1 * 0.5, -D * 0.5 + 0.1), Vector3(W * 0.36, H1, 0.2)],
			[Vector3(W * 0.32, 0.4 + H1 * 0.5, -D * 0.5 + 0.1), Vector3(W * 0.36, H1, 0.2)], [Vector3(0, y2 + 1.2, 0), Vector3(W * 0.78, 2.4, D * 0.8)]]:
		var cs = CollisionShape3D.new()
		var sh = BoxShape3D.new()
		sh.size = box[1]
		cs.shape = sh
		cs.position = box[0]
		sb.add_child(cs)
	root.add_child(sb)
	root.scale = Vector3(1, 0.02, 1)
