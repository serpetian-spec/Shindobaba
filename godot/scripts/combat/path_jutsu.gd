								"colors": [RUBBER, Color(RUBBER.r, RUBBER.g, RUBBER.b, 0)]})
							if live(h):
								h.take_hit(inf(c, "yoton_gomu_kosoku", 0.6, {"knock": 10.0, "launch": 3.0, "kind": "heavy"}))
							gum.queue_free())))
	Sfx.play("water", c.global_position, 0.8)


