					e.apply_status("slow", 0.6)
				if e.has_method("lose_target"):
					e.lose_target(0.5)
				if i % 2 == 0:
					hit(c, e.global_position + Vector3.UP, e.radius + 0.3, inf(c, "suna_arashi_no_jutsu", 0.1, {"knock": 0.5, "kind": "light", "element": "fuuton"})), Callable())
