## Her Şey Acıdır: ahşap fırtınası ile alev dalgası iç içe — dev dallar ve yanan ağaçlar ileriye yığılır
func p_issai_kaiku(c: Node3D, t: Node3D) -> void:
	busy(c, 1.6)
	var d = fwd(c, t)
	var side = d.cross(Vector3.UP)
	var at = c.global_position
	# S rütbe: ağızdan ufku yutan dev alev seli; arkasından zemin yarılıp önündeki geniş alan boyunca yerden
	# alev sütunları fışkırır (geometrik kütük/dal yok), alan uzun süre yanar
	VFX.gather(_mouth_pos(c), FIRE, 1.0)
	after(0.2, func():
		if not live(c):
			return
		anim(c, "push", 1.4)
		for j in 3:
			_flame_jet(c, _mouth_pos(c), (d + side * (j - 1) * 0.22).normalized(), 32.0, 7.0, 1.2, 2.4)
		FX.light(at + d * 14.0 + Vector3.UP * 3.0, Color(1.0, 0.55, 0.15), 12.0, 50.0, 2.5)
		for k in 22:
			after(0.25 + k * 0.05, func():
				var q = gp(at + d * (4.0 + k * 1.5) + side * randf_range(-6.0, 6.0) * (0.4 + k / 22.0))
				VFX.cracks(q, 2.5, Color(0.1, 0.03, 0.01, 0.9), 6.0)
				VFX.puffs(q + Vector3.UP * 0.3, {"amount": 10, "life": 0.8, "size": 1.8, "radius": 0.6, "vmin": 8.0, "vmax": 15.0, "dir": Vector3.UP, "spread": 12.0,
					"damp": 2.0, "gravity": Vector3(0, 2.0, 0), "spin": 60.0, "glow": 1.15, "hot": 0.6, "outline_col": Color(0.7, 0.2, 0.03), "outline": 0.03, "rough": 0.2,
					"colors": [Color(1.0, 0.97, 0.65, 1), Color(1.0, 0.65, 0.15, 1), Color(0.95, 0.35, 0.06, 0.85), Color(0.45, 0.12, 0.04, 0)], "scale_curve": [[0.0, 0.4], [0.3, 1.0], [1.0, 1.3]]})
				VFX.embers(q + Vector3.UP * 2.0, Color(1.0, 0.6, 0.15), 12, 8.0, 0.8)
				if k % 4 == 0:
					VFX.linger(q, "katon", FIRE, 2.2, 6.0)
				for e in enemies_near(c, q, 2.6):
					e.take_hit(inf(c, "issai_kaiku", 0.35, {"knock": 6.0, "launch": 8.0, "kind": "heavy", "element": "katon", "burn": 2.0})))
		Combat.hit_zone(c, at, d, 34.0, 50.0, 5.0, inf(c, "issai_kaiku", 2.6, {"knock": 18.0, "launch": 5.0, "kind": "heavy", "element": "katon", "burn": 4.0}))
		shake(1.6)
		Sfx.play("boom", at + d * 10.0, 0.5))
	Sfx.play("fire", c.global_position, 0.5)


## İzanagi: bir göz kapanır, ışığı söner — 5 sn sonra gerçeklik yeniden yazılır: o sürede kaybedilen can geri gelir
const IZANAGI_DUR := 10.0   # animede ~1 dk / göz; oyunda 10 sn (yoksa ölümsüzlük)


func p_izanagi(c: Node3D, _t: Node3D) -> void:
	# Kanon (Danzō / Obito): kullanıcı İzanagi'yi ÖNCEDEN açar; süre boyunca başına gelen kötü her şey — yara, ölüm —
	# yanılsamaya döner (gerçeği yeniden yazar). Süre bitince kullanılan Sharingan gözü kalıcı olarak ışığını kaybeder.
	busy(c, 0.4)
	var start_hp = float(c.get("hp")) if c.get("hp") != null else 0.0
	var dur = IZANAGI_DUR
	c.set_meta("izanagi_hp", start_hp)
	c.set_meta("izanagi_until", Time.get_ticks_msec() + int(dur * 1000.0))
	if c is Player:
		VFX.screen_lines(0.4, 0.8, Color(0.8, 0.3, 0.3))
		Buffs.add("izanagi", dur, {"_name": "İzanagi", "_desc": "%d sn: ölüm dahil başına gelen her şey yanılsama; sonunda bir Sharingan gözün kararır" % int(dur)})
		Hud.msg("İzanagi: gerçekle yanılsama yer değiştirdi (%d sn). Bedeli bir göz." % int(dur), Color(1, 0.45, 0.45), 5.0)
	else:
		Combat.popup_text(c.global_position + Vector3.UP * 2.6, "İzanagi!", Color(0.9, 0.15, 0.2))
	VFX.shockwave(c.global_position + Vector3.UP, Color(0.85, 0.2, 0.2), 4.0, 0.3, false)
	after(dur, func():
		if not is_instance_valid(c):
			return
		c.remove_meta("izanagi_hp")
		c.remove_meta("izanagi_until")
		var now = float(c.get("hp"))
		if now < start_hp and now > 0.0:
			heal(c, start_hp - now)   # süre içindeki yaralar da yanılsamaydı
		VFX.star(c.global_position + Vector3.UP * 1.5, Color(0.9, 0.2, 0.2), 2.6)
		VFX.shockwave(c.global_position + Vector3.UP, Color(0.6, 0.6, 0.6), 6.0, 0.4, false)
		# bedel: Sharingan gözü kararır
		if c is Player:
			VFX.screen_lines(0.5, 1.2, Color(0.9, 0.9, 0.9))
			if c.combat and c.combat.modes and c.combat.modes.eyes:
				c.combat.modes.eyes.izanagi_cost()
		elif c.has_meta("eyes"):
			c.set_meta("eyes", {"kind": 0, "lvl": 0})
			Combat.popup_text(c.global_position + Vector3.UP * 2.6, "Gözü karardı", Color(0.7, 0.2, 0.25)))
	Sfx.play("genjutsu", c.global_position, 0.8)


## İzanagi süresi içinde ölümcül darbe: ölüm yanılsamaya döner — kullanıcı yeniden yazılmış gerçekte (biraz ötede, açılış canıyla) belirir
static func izanagi_rewrite(c: Node3D) -> bool:
	if c == null or not is_instance_valid(c) or not c.has_meta("izanagi_until"):
		return false
	if Time.get_ticks_msec() > int(c.get_meta("izanagi_until")):
		return false
	c.set("hp", maxf(1.0, float(c.get_meta("izanagi_hp", 1.0))))
	if "dead" in c:
		c.set("dead", false)
	var back = -c.face_dir() if c.has_method("face_dir") else Vector3.BACK
	var side = back.cross(Vector3.UP) * (1.0 if randf() < 0.5 else -1.0)
	FX.smoke_puff(c.global_position + Vector3.UP, 0.6, 8)
	var to = c.global_position + back * 2.5 + side * 2.0
	to.y = Game.jutsu_floor(to.x, to.z)
	c.global_position = to
	Combat.popup_text(c.global_position + Vector3.UP * 2.6, "Yanılsama — İzanagi", Color(0.95, 0.25, 0.3))
	FX.ring(c.global_position + Vector3.UP, Color(0.85, 0.08, 0.1), 3.0, 0.4)
	if c is Player and c.combat:
		c.combat.invuln = 0.6
	return true


## Izanami (kanon, Itachi): kurban iki anın arasında döngüye hapsolur — her seferinde aynı ana geri sarılır; döngüden
## yalnız kaderini kabul ederek çıkar (Kabuto Edo Tensei'yi bıraktı). Bedeli: kullanıcının bir gözü sonsuza dek kararır.
## Oyunda: 6 sn döngü (her 1 sn başa sarılır), sonunda boss olmayan düşman savaşmayı bırakır; boss/oyuncu ağır sersemler.
func p_izanami(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 20.0)
	if tt == null:
		if c is Player:
			Hud.msg("Izanami: döngüye alınacak hedef yok.", Color(0.8, 0.8, 0.8))
		return
	var gm = Eyes.genjutsu_land(c, tt, true)
	if gm <= 0.0:
		return
	busy(c, 0.8)
	_mangekyo(c, 6.0)
	var anchor = tt.global_position
	var white = Color(0.95, 0.92, 0.9)
	Sfx.play("genjutsu", anchor, 0.6)
	if c is Player:
		VFX.screen_lines(0.4, 1.0, Color(0.9, 0.2, 0.25))
	st(tt, "stun", 6.2)
	# kurban oyuncuysa dünyası solar (aynı anı yaşıyor): soluk ak perde döngü boyunca
	if tt is Player and Game.world and Game.world.env:
		Game.world.env.flash_tint(Color(0.92, 0.9, 0.86, 0.3), 6.0)
	var echoes: Array = []
	# döngü: her saniye kurban aynı ana geri sarılır — terk ettiği an donmuş ak bir kopya olarak kalır, kopyalar birikir
	for k in 6:
		after(k * 1.0, func():
			if not live(tt):
				return
			var from = tt.global_position
			if k > 0:
				# kopya kurbanın ardında, her döngüde biraz daha geride ve sırayla sağa-sola (iz gibi okunur); eskiler solar
				var bk = -tt.face_dir() if tt.has_method("face_dir") else Vector3.BACK
				var sd = bk.cross(Vector3.UP) * (0.55 if k % 2 == 0 else -0.55)
				for e in echoes:
					if is_instance_valid(e):
						e.transparency = minf(0.85, e.transparency + 0.12)
				echoes.append_array(_izanami_echo(tt, 0.7, bk * (0.6 + 0.55 * k) + sd))
			tt.global_position = anchor
			if tt.get("model"):
				tt.model.play(["hit", "block", "idle", "hit", "crouch", "idle"][k], 0.02, 1.2, true)
				var m = tt.model
				var tw = m.create_tween()
				for f in 3:
					tw.tween_callback(func(): if is_instance_valid(m): m.visible = false)
					tw.tween_interval(0.04)
					tw.tween_callback(func(): if is_instance_valid(m): m.visible = true)
					tw.tween_interval(0.05)
			for n in 10:   # geri sarma çizgileri (zamanda geri akış): kopyadan bedene akar
				var q = Vector3(randf_range(-0.6, 0.6), randf_range(0.2, 1.9), randf_range(-0.6, 0.6))
				WindFX.streak(func(u: float) -> Vector3: return anchor + q + (from - anchor) * (1.0 - u) + Vector3.UP * sin(u * PI) * 0.4, 0.4, 0.05, white, n * 0.02, 10)
			VFX.star(anchor + Vector3.UP * 1.2, white, 1.6, 0.16)
			VFX.puffs(anchor + Vector3.UP, {"amount": 14, "life": 0.7, "size": 0.08, "radius": 0.9, "vmin": 0.3, "vmax": 1.2, "dir": Vector3.DOWN, "spread": 180.0, "add": true,
				"colors": [Color(1, 1, 1, 0.9), Color(0.95, 0.9, 0.9, 0)]})
			if tt is Player:
				VFX.screen_lines(0.3, 0.8, Color(0.95, 0.93, 0.9))
				if Game.world and Game.world.env:
					Game.world.env.screen_flash(0.35)
			Sfx.play("genjutsu", anchor, 0.35))   # kanon: Izanami hasar vermez, yalnız hapseder (vuruş kilidi kırıp kurbanı yere yatırıyordu)
	after(6.1, func():
		for e in echoes:   # döngü kırılır: donmuş anlar ak toz olup dağılır
			if is_instance_valid(e):
				VFX.puffs(e.global_position + Vector3.UP, {"amount": 10, "life": 0.9, "size": 0.1, "radius": 0.5, "vmin": 0.5, "vmax": 2.0, "dir": Vector3.UP, "spread": 120.0, "add": true,
					"colors": [Color(1, 1, 1, 0.8), Color(0.9, 0.9, 0.95, 0)]})
				var tw = e.create_tween()
				tw.tween_property(e, "transparency", 1.0, 0.5)
				tw.tween_callback(e.queue_free)
		if not live(tt):
			return
		if not (tt is Player) and not tt.has_meta("boss") and "team" in tt:
			# kaderini kabul etti: savaşmayı bırakır
			tt.team = "neutral"
			tt.set("target", null)
			if tt.get("model"):
				tt.model.play("idle", 0.2)
			Combat.popup_text(tt.global_position + Vector3.UP * 2.6, "Kaderini kabul etti...", Color(0.95, 0.85, 0.85))
		else:
			st(tt, "stun", 2.5)
			st(tt, "fear", 4.0)
			Combat.popup_text(tt.global_position + Vector3.UP * 2.6, "Döngüden kurtuldu", Color(0.95, 0.85, 0.85)))
	# kanon bedeli: bir göz sonsuza dek kararır (Izanagi ile aynı sistem; düşman da gözünü kaybeder)
	if c is Player and c.combat and c.combat.modes and c.combat.modes.eyes:
		c.combat.modes.eyes.izanagi_cost("İzanami")
	elif c.has_meta("eyes"):
		c.remove_meta("eyes")
		Combat.popup_text(c.global_position + Vector3.UP * 2.6, "Gözü karardı", Color(0.7, 0.2, 0.25))


## Izanami anı: kurbanın o anki pozu donmuş, ak-yarı saydam bir kopya olarak dünyada kalır (iskelet pozundan pişirilir)
func _izanami_echo(tt: Node3D, alpha: float, shift := Vector3.ZERO) -> Array:
	var out: Array = []
	var m = tt.get("model")
	if m == null or not is_instance_valid(m):
		return out
	var mat = StandardMaterial3D.new()
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.albedo_color = Color(0.78, 0.84, 1.0, alpha)
	mat.emission_enabled = true
	mat.emission = Color(0.75, 0.82, 1.0)
	mat.emission_energy_multiplier = 0.9
	mat.rim_enabled = true
	mat.rim = 1.0
	mat.rim_tint = 0.2
	mat.roughness = 0.4
	for mi in m.find_children("*", "MeshInstance3D", true, false):
		var src = mi as MeshInstance3D
		if src.mesh == null or not src.is_visible_in_tree():
			continue
		var mesh: Mesh = src.mesh
		if src.skin != null or src.get_node_or_null(src.skeleton) is Skeleton3D:
			var baked = src.bake_mesh_from_current_skeleton_pose()
			if baked:
				mesh = baked
		var e = MeshInstance3D.new()
		e.mesh = mesh
		e.material_override = mat
		e.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		get_tree().current_scene.add_child(e)
		e.global_transform = src.global_transform
		e.global_position += shift
		e.transparency = 1.0
		e.create_tween().tween_property(e, "transparency", 0.0, 0.15)
		out.append(e)
	return out


## Cehennem Kralı (Meifu no Ō) başı (referans: Narutopedia King of Hell, Soul ripping technique, Paths Restored):
## gri-beyaz yüz, gözleri ve burnu kaplayan dikey mor bant, Rinnegan gözler, iri burun; önünde sarı 王 yazılı siyah şapka,
## şapkadan geriye kıvrılan iki uzun beyaz tüy; arkada açılan bordo yüksek yaka; ağzı örten beyaz pilili kâğıt örtü —
## örtü kalkınca dişli dev ağız. Boy ~7 m. Ön -Z. Dönen: {"root", "flap", "mouth"(yerel)}
func _king_head() -> Dictionary:
	var root = Node3D.new()
	var b = MB.new()
	var SK = Color(0.86, 0.86, 0.9)
	var PUR = Color(0.38, 0.2, 0.45)
	var COL = Color(0.62, 0.16, 0.2)
	var COL_IN = Color(0.42, 0.1, 0.14)
	var BLK = Color(0.08, 0.07, 0.09)
	var HAIR = Color(0.82, 0.74, 0.55)
	var LINE = Color(0.2, 0.18, 0.22)
	# yüksek kırmızı yaka: başı arkadan çanak gibi saran, dışa açılan paneller (iç yüzü koyu)
	for k in 15:
		var ang = lerpf(-1.75, 1.75, k / 14.0)
		var dirv = Vector3(sin(ang), 0, cos(ang))
		var pp = dirv * 2.6 + Vector3(0, 3.3, 0.5)
		var yaw = rad_to_deg(atan2(dirv.x, dirv.z))
		b.add("box", pp, Vector3(1.15, 6.4 - absf(ang) * 0.7, 0.18), COL, Vector3(-14, yaw, 0))
		b.add("box", pp - dirv * 0.12, Vector3(1.1, 6.2 - absf(ang) * 0.7, 0.08), COL_IN, Vector3(-14, yaw, 0))
	# geniş maske yüz: alında dar, yanaklarda ve çenede geniş
	Loft.blob(b, Vector3(0, 3.4, 0.1), Vector3(0, 1, 0), 4.4, [Vector2(0.9, 1.9), Vector2(1.05, 2.35), Vector2(1.1, 2.4), Vector2(1.0, 2.1), Vector2(0.8, 1.4)], SK, 20)   # yassı, geniş maske yüz (dikey eksende Vector2.x = derinlik)
	# mor bölge: gözleri ve yanakları kaplayan maske lekesi (burun kemeri üstünde açık)
	b.add("sphere", Vector3(0, 4.05, -0.72), Vector3(4.3, 3.0, 0.9), PUR, Vector3.ZERO, 18)
	# basık, iri burun: alından iner, genişler, iki burun deliği
	Loft.tube(b, [Vector3(0, 4.9, -1.12), Vector3(0, 4.2, -1.24), Vector3(0, 3.55, -1.4), Vector3(0, 3.3, -1.34)], [Vector2(0.22, 0.12), Vector2(0.3, 0.16), Vector2(0.46, 0.24), Vector2(0.5, 0.2)], SK.darkened(0.04), 10, 3)
	for sx in [-1.0, 1.0]:
		b.add("sphere", Vector3(sx * 0.24, 3.3, -1.5), Vector3(0.15, 0.09, 0.06), LINE, Vector3.ZERO, 8)
	# Rinnegan gözler: açık mor zemin, koyu halkalar, çatık kaş
	for sx in [-1.0, 1.0]:
		var ep = Vector3(sx * 0.8, 4.25, -1.2)
		b.add("sphere", ep, Vector3(0.7, 0.42, 0.12), Color(0.85, 0.8, 0.95), Vector3(0, sx * 18, 0), 12)
		for q in 3:
			b.add("torus", ep + Vector3(0, 0, -0.04 - q * 0.004), Vector3(0.16 + q * 0.11, 0.16 + q * 0.11, 0.16 + q * 0.11), Color(0.34, 0.22, 0.42), Vector3(90, sx * 18, 0), 14)
		b.add("box", ep + Vector3(-sx * 0.02, 0.36, -0.03), Vector3(0.85, 0.1, 0.06), BLK, Vector3(0, sx * 18, sx * -14))
	# saç: şapkanın altından iki yana dökülen uzun bej tutamlar
	for sx in [-1.0, 1.0]:
		for k in 3:
			var x0 = sx * (1.55 + k * 0.22)
			Loft.tube(b, [Vector3(x0, 5.6, -0.2 + k * 0.25), Vector3(x0 + sx * 0.35, 4.0, 0.1 + k * 0.2), Vector3(x0 + sx * 0.3, 2.2, 0.3 + k * 0.15), Vector3(x0 + sx * 0.15, 1.0, 0.4)],
				[Vector2(0.08, 0.32), Vector2(0.09, 0.38), Vector2(0.08, 0.32), Vector2(0.03, 0.1)], HAIR.darkened(k * 0.06), 6, 3, true, true, Callable(), Vector3(0, 0, 1))
	# şapka (taç): sivri tepeli siyah orta parça + şakaklardan dışa açılan siyah kanatlar (beyaz kenarlı)
	b.add("box", Vector3(0, 6.2, -0.1), Vector3(1.5, 1.6, 1.3), BLK, Vector3(-6, 0, 0))
	b.add("cone", Vector3(0, 7.35, -0.3), Vector3(1.0, 0.8, 0.9), BLK, Vector3.ZERO, 4)
	Loft.tube(b, [Vector3(0, 6.05, -0.85), Vector3(0, 6.6, -0.83)], [Vector2(0.62, 0.06), Vector2(0.4, 0.06)], Color(0.95, 0.95, 0.93), 4, 2)   # beyaz alın şeridi
	b.add("box", Vector3(0, 5.65, -0.95), Vector3(1.4, 1.3, 0.1), BLK, Vector3(-6, 0, 0))   # 王 plakası
	for sx in [-1.0, 1.0]:
		var w0 = Vector3(sx * 0.6, 5.9, -0.7)
		var pts = [w0, w0 + Vector3(sx * 0.9, 0.6, 0.1), w0 + Vector3(sx * 1.6, 0.2, 0.25), w0 + Vector3(sx * 1.7, -0.9, 0.2), w0 + Vector3(sx * 1.3, -1.8, 0.0)]
		Loft.tube(b, pts, [Vector2(0.08, 0.95), Vector2(0.08, 1.15), Vector2(0.08, 1.0), Vector2(0.07, 0.7), Vector2(0.04, 0.15)], BLK, 6, 3, true, true, Callable(), Vector3(0, 0, -1))
		Loft.tube(b, [p0_offset(pts[1], -0.08), p0_offset(pts[2], -0.08), p0_offset(pts[3], -0.08)], [Vector2(0.05, 0.25), Vector2(0.05, 0.3), Vector2(0.04, 0.2)], Color(0.92, 0.92, 0.9), 6, 3, true, true, Callable(), Vector3(0, 0, -1))
	# tüyler: şapka tepesinden yukarı kalkıp dışa ve aşağı kıvrılan kalın beyaz tüy, iki yanında ince saçaklar
	for sx in [-1.0, 1.0]:
		var fp = [Vector3(sx * 0.45, 6.9, -0.2), Vector3(sx * 1.0, 9.2, 0.1), Vector3(sx * 2.0, 10.6, 0.5), Vector3(sx * 3.2, 10.4, 0.8), Vector3(sx * 3.9, 8.8, 0.9)]
		Loft.tube(b, fp, [0.12, 0.11, 0.1, 0.08, 0.03], Color(0.96, 0.96, 0.94), 6, 4)
		for q in 60:
			var u = q / 59.0
			var i0 = mini(3, int(u * 4.0))
			var pp: Vector3 = (fp[i0] as Vector3).lerp(fp[i0 + 1], u * 4.0 - i0)
			var nx: Vector3 = ((fp[mini(4, i0 + 1)] as Vector3) - (fp[i0] as Vector3)).normalized()
			var side = nx.cross(Vector3(0, 0, 1)).normalized()
			for sd in [-1.0, 1.0]:
				Loft.tube(b, [pp, pp + side * sd * 0.22 - nx * 0.14], [0.025, 0.006], Color(0.9, 0.9, 0.88), 3, 1)
	# ağız içi (örtü kalkınca): kara gırtlak, üstte iri kare dişler
	b.add("sphere", Vector3(0, 1.9, -0.85), Vector3(2.6, 2.0, 1.0), Color(0.05, 0.02, 0.04), Vector3.ZERO, 14)
	for k in 9:
		var x = lerpf(-1.1, 1.1, k / 8.0)
		b.add("box", Vector3(x, 2.85, -1.22 + absf(x) * 0.3), Vector3(0.24, 0.38, 0.14), Color(0.97, 0.96, 0.93))
	var mi = MeshInstance3D.new()
	mi.mesh = b.build(Props.toon())
	root.add_child(mi)
	var kanji = Label3D.new()
	kanji.text = "王"
	kanji.font_size = 160
	kanji.pixel_size = 0.005
	kanji.modulate = Color(0.98, 0.82, 0.2)
	kanji.outline_size = 0
	kanji.position = Vector3(0, 5.6, -1.03)
	kanji.rotation = Vector3(0.1, PI, 0)
	root.add_child(kanji)
	# pilili, dikişli beyaz kâğıt örtü: burnun altından çeneye ağzı kapatır (menteşe üstte)
	var flap = Node3D.new()
	root.add_child(flap)
	flap.position = Vector3(0, 3.05, -1.15)
	var fb = MB.new()
	for k in 17:
		var x = lerpf(-1.7, 1.7, k / 16.0)
		var zc = absf(x) * absf(x) * 0.16
		Loft.tube(fb, [Vector3(x, 0.05, zc), Vector3(x * 1.03, -1.2, zc - 0.05), Vector3(x * 0.95, -2.4, zc + 0.05)], [Vector2(0.17, 0.07), Vector2(0.17, 0.07), Vector2(0.16, 0.06)], Color(0.96, 0.96, 0.94) if k % 2 == 0 else Color(0.86, 0.86, 0.84), 5, 2)
	for row in 5:   # dikiş izleri: pililerin üstünde yatay kısa çizgiler
		var y = -0.3 - row * 0.45
		for k in 12:
			var x = lerpf(-1.4, 1.4, k / 11.0)
			fb.add("box", Vector3(x, y, absf(x) * absf(x) * 0.18 - 0.1), Vector3(0.12, 0.025, 0.02), LINE)
	var fmi = MeshInstance3D.new()
	fmi.mesh = fb.build(Props.toon())
	flap.add_child(fmi)
	return {"root": root, "flap": flap, "mouth": Vector3(0, 2.0, -1.3)}


func p0_offset(v: Vector3, dz: float) -> Vector3:
	return v + Vector3(0, 0, dz)


## Pembe el-dil: ağızdan uzanan, ucunda el olan dil (Cehennem Kralı); a: ağız, b: tutulan nokta
func _hand_tongue(parent: Node3D, a: Vector3, b: Vector3) -> MeshInstance3D:
	var mb = MB.new()
	var PINK = Color(0.82, 0.38, 0.62)
	var mid = a.lerp(b, 0.5) + Vector3.UP * a.distance_to(b) * 0.12
	Loft.tube(mb, [a, a.lerp(mid, 0.5), mid, mid.lerp(b, 0.5), b], [0.32, 0.28, 0.24, 0.2, 0.18], PINK, 10, 3)
	var dv = (b - mid).normalized()
	Loft.blob(mb, b + dv * 0.2, dv, 0.6, [Vector2(0.15, 0.1), Vector2(0.3, 0.14), Vector2(0.28, 0.12)], PINK.darkened(0.08), 8)
	var sd = dv.cross(Vector3.UP).normalized()
	for f in 4:
		var fp = b + dv * 0.45 + sd * lerpf(-0.2, 0.2, f / 3.0)
		Loft.tube(mb, [fp, fp + dv * 0.25 - Vector3.UP * 0.08, fp + dv * 0.38 - Vector3.UP * 0.22], [0.06, 0.05, 0.04], PINK.darkened(0.08), 5, 2)
	var mi = MeshInstance3D.new()
	mi.mesh = mb.build(Props.toon())
	parent.add_child(mi)
	return mi


## Jigokudō (kanon) — Cehennem Kralı iki işlevle çağrılır:
## 1) SORGU: kullanıcı hedefi yakalar (temas), Kral önlerinde yerden mor-pembe alevlerle yükselir, kurban felç olur;
##    ruhu ağzından uzun pembe dil olarak çıkar, Kral'ın el-dili onu kavrar ve yargılar — düşmanın "yalanı" dili koparır:
##    sıradan hedef ölür; güçlü (boss/oyuncu) ölmez ama bitkin düşer (çakra biter, ağır hasar, yavaşlar).
## 2) ONARIM: hedef yoksa Kral kullanıcıyı yutar, birkaç saniye sonra onarılmış hâlde geri çıkarır (can, durum bozuklukları).
## Oyuncu ve AI aynı fonksiyon.
func p_jigokudo(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 6.0)
	busy(c, 2.4)
	var fd: Vector3 = c.face_dir()
	var at = gp(c.global_position + fd * (4.5 if tt else 5.0))
	if tt:   # yakala
		var tw0 = c.create_tween()
		tw0.tween_property(c, "global_position", gp(tt.global_position - _face(c, tt) * 0.9), 0.2)
		at = gp(tt.global_position + _face(c, tt) * 4.5)
	var kh = _king_head()
	var head: Node3D = kh["root"]
	get_tree().current_scene.add_child(head)
	head.global_position = at - Vector3.UP * 8.0
	var face_to = (c.global_position if not tt else tt.global_position) - at
	face_to.y = 0
	head.rotation.y = atan2(face_to.x, face_to.z) + PI   # ön (-Z) çağırana/kurbana
	var flames = func():
		for k in 10:
			var ang = TAU * k / 10.0
			VFX.puffs(at + Vector3(cos(ang) * 2.6, 0.3, sin(ang) * 2.0), {"amount": 6, "life": 0.9, "size": 1.3, "radius": 0.6, "vmin": 2, "vmax": 5, "dir": Vector3.UP, "spread": 18.0, "add": true,
				"colors": [Color(1.0, 0.3, 0.75, 0.9), Color(0.55, 0.05, 0.5, 0.6), Color(0.2, 0.0, 0.25, 0)]})
	flames.call()
	every(4.0, 0.35, func(_i, _k): flames.call(), Callable())
	var tw = head.create_tween()
	tw.tween_property(head, "global_position", at - Vector3.UP * 0.6, 0.6).set_trans(Tween.TRANS_BACK)
	Sfx.play("roar", at, 0.5)
	var flap: Node3D = kh["flap"]
	if tt and live(tt):
		tt.set_meta("gaki_hold", true)
		st(tt, "bind", 3.0)
		if c is Player:
			c.input_locked = 2.4
		Combat.popup_text(tt.global_position + Vector3.UP * 2.6, "Sorgu: yalan söylersen dilin koparılır", Color(0.95, 0.5, 0.8))
		tw.tween_property(flap, "rotation:x", -1.4, 0.4)   # örtü kalkar
		tw.tween_callback(func():
			if not (live(tt) and live(c) and is_instance_valid(head)):
				return
			var mouth_w: Vector3 = head.global_transform * (kh["mouth"] as Vector3)
			var vm: Vector3 = tt.global_position + Vector3.UP * 1.45 + (mouth_w - tt.global_position).normalized() * 0.15
			var root = Node3D.new()
			get_tree().current_scene.add_child(root)
			# kurbanın ruhu ağzından pembe dil olarak uzar; Kral'ın el-dili onu kavrar
			var grip = vm.lerp(mouth_w, 0.45)
			_hand_tongue(root, mouth_w, grip)
			var sm = MB.new()
			Loft.tube(sm, [vm, vm.lerp(grip, 0.5) + Vector3.UP * 0.2, grip], [0.08, 0.13, 0.15], Color(0.92, 0.55, 0.72), 8, 3)
			var soul = MeshInstance3D.new()
			soul.mesh = sm.build(Props.toon())
			root.add_child(soul)
			after(1.2, func():   # yargı
				if is_instance_valid(root):
					root.queue_free()
				if is_instance_valid(tt):
					tt.remove_meta("gaki_hold")
				if not (live(tt) and live(c)):
					return
				var strong = tt is Player or tt.has_meta("boss") or tt is TailedBeast
				VFX.puffs(grip, {"amount": 20, "life": 0.6, "size": 0.4, "radius": 0.4, "vmin": 2, "vmax": 5, "dir": Vector3.UP, "spread": 90.0, "add": true,
					"colors": [Color(1, 0.6, 0.85, 0.9), Color(0.5, 0.1, 0.4, 0)]})
				if strong:
					st(tt, "stun", 1.5)
					if tt is Player:
						tt.chakra = 0.0
						Buffs.add("jigoku_bitkin", 8.0, {"speed": 0.75, "_name": "Bitkin", "_desc": "Cehennem Kralı'nın sorgusu: ruhun yorgun"})
					tt.take_hit(inf(c, "jigokudo", 0.0, {"dmg": float(tt.max_hp) * (0.2 if tt is Player else 0.1), "knock": 0.0, "launch": 0.0, "kind": "light", "pierce_guard": true}))
					Combat.popup_text(tt.global_position + Vector3.UP * 2.6, "Bitkin düştü", Color(0.95, 0.6, 0.85))
				else:
					tt.take_hit(inf(c, "jigokudo", 0.0, {"dmg": float(tt.max_hp) * 4.0, "no_blood": true, "knock": 0.0, "launch": 0.0, "kind": "light", "pierce_guard": true}))
					Combat.popup_text(tt.global_position + Vector3.UP * 2.6, "Yalan — dili koparıldı", Color(0.95, 0.5, 0.8))))
		tw.tween_interval(1.4)
	else:
		# onarım: Kral kullanıcıyı yutar, onarıp geri çıkarır
		tw.tween_property(flap, "rotation:x", -1.4, 0.35)
		tw.tween_callback(func():
			if not live(c) or not is_instance_valid(head):
				return
			var mouth_w: Vector3 = head.global_transform * (kh["mouth"] as Vector3)
			var back = c.global_position
			c.visible = false
			if c is Player:
				c.input_locked = 2.2
			c.set_meta("jigoku_inside", true)
			var tw2 = c.create_tween()
			tw2.tween_property(c, "global_position", mouth_w - Vector3.UP * 0.8, 0.25)
			tw2.tween_interval(1.8)
			tw2.tween_callback(func():
				if not is_instance_valid(c):
					return
				c.global_position = gp(back)
				c.visible = true
				c.remove_meta("jigoku_inside")
				if c.get("statuses") != null:
					c.statuses.clear()
				heal(c, float(c.max_hp) * 0.45)
				Combat.popup_text(c.global_position + Vector3.UP * 2.6, "Beden onarıldı", Color(0.95, 0.6, 0.85))
				VFX.puffs(c.global_position + Vector3.UP, {"amount": 20, "life": 0.6, "size": 0.5, "radius": 0.5, "vmin": 1, "vmax": 3, "dir": Vector3.UP, "spread": 70.0, "add": true,
					"colors": [Color(1, 0.6, 0.85, 0.8), Color(0.5, 0.1, 0.4, 0)]})))
		tw.tween_interval(2.4)
	tw.tween_property(flap, "rotation:x", 0.0, 0.3)
	tw.tween_property(head, "global_position", at - Vector3.UP * 8.0, 0.6)
	tw.tween_callback(head.queue_free)


## Toprak Kin Korkusu: bedenden yüzlerce siyah iplik dokunaç gibi fışkırır — yakındaki düşmanları delip canlarını çalar
func p_jiongu(c: Node3D, t: Node3D) -> void:
	busy(c, 1.0)
	var targets = enemies_near(c, c.global_position, 12.0)
	var tt = tg(c, t, 12.0)
	if tt and not targets.has(tt):
		targets.append(tt)
	var thread = StandardMaterial3D.new()
	thread.albedo_color = Color(0.2, 0.2, 0.23)
	thread.roughness = 0.8
	var t0 = Game.now()
	for k in 22:   # ref: bedenden her yöne dalgalanarak uzanan kalın kara iplik dokunaçları (koni değil)
		var a = k * TAU / 22.0 + randf_range(-0.1, 0.1)
		var L = randf_range(3.5, 6.0)
		var dir = Vector3(cos(a), randf_range(-0.3, 0.7), sin(a)).normalized()
		var base_h = randf_range(0.8, 1.6)
		wavy_tether(func(): return c.global_position + Vector3.UP * base_h if is_instance_valid(c) else Vector3.ZERO,
			func():
				var u = Game.now() - t0
				var ext = clampf(u / 0.25, 0.0, 1.0) * (1.0 - clampf((u - 1.1) / 0.3, 0.0, 1.0))
				return (c.global_position if is_instance_valid(c) else Vector3.ZERO) + Vector3.UP * base_h + dir * L * maxf(0.05, ext),
			randf_range(0.12, 0.18), thread, 1.4, randf_range(0.12, 0.25))
	for e in targets:
