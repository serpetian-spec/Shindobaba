				b.add("cone", Vector3(0, 0, -0.62), Vector3(0.1, 0.4, 0.04), steel, Vector3(-90, 0, 0), 4)
			"tonfa":
				b.add("box", Vector3(0, 0, -0.1), Vector3(0.07, 0.07, 0.75), Color(0.35, 0.22, 0.12))
				b.add("cyl", Vector3(0, -0.12, 0.12), Vector3(0.05, 0.2, 0.05), Color(0.35, 0.22, 0.12), Vector3.ZERO, 6)
			"senbon":
				for k in 3:
					b.add("cyl", Vector3((k - 1) * 0.05, 0, -0.2), Vector3(0.012, 0.6, 0.012), steel, Vector3(90, 0, 0), 4)
		return b)


## Silahı fırlat: from'dan to'ya döne döne uçar; saplandığı yerde kalır (stick), isabet edene hasar
func throw_weapon(c: Node3D, id: String, kind: String, from: Vector3, to: Vector3, speed: float, mul: float, homing: Node3D = null, extra := {}) -> Projectile:
	var d = (to - from).normalized()
	var mi = mi_of(weapon_mesh(kind))
	var info = inf(c, id, mul, {"knock": 2.0, "kind": "light", "hitstop": 0.02}).merged(extra, true)
	var pr = shot(c, from, d, speed, mi, info, homing, false, (from.distance_to(to) / speed) + 0.6)
	pr.radius = 0.35
	pr.stick = true
	if kind in ["shuriken", "fuma", "chakram"]:
		pr.spin = Vector3(0, 28.0, 0)
	elif kind in ["kusari", "ono", "kama", "tonfa"]:
		pr.spin = Vector3(-20.0, 0, 0)
	return pr


## Parşömen: açılmış kâğıt (beyaz, kırmızı kenar) + ahşap rulolar
## Parşömen (makimono): "paper" düğümü (ön yüz -Z) + iki rulo "ra"/"rb" (yerel X ekseni boyunca, y = ±L/2).
## scroll_len ile kâğıt boyu değişir (eller ayrıldıkça açılır); rulolar ölçeklenmez.
func scroll_node(w: float, h: float) -> Node3D:
	var pmesh = cached("scroll3p_%d_%d" % [int(w * 100), int(h * 100)], func():
		# gerçek makimono: hafif kavisli kâğıt (ön yüz -Z), iki uçta kalın kâğıt rulosu + içinden geçen ahşap çubuk,
		# çubuk uçlarında kırmızı laka topuz + altın halka; önde kırmızı kenar şeritleri, sütun sütun mürekkep yazı, ortada kırmızı mühür
		var b = MB.new()
		var paper = Color(0.96, 0.93, 0.83)
		var red = Color(0.72, 0.14, 0.13)
		var ink = Color(0.12, 0.09, 0.08)
		var bow = func(y: float) -> float: return 0.035 * cos(y / (h * 0.5) * PI * 0.5)   # ortası geriye kavisli
		var N = 10
		for i in N:
			var y0 = -h * 0.5 + h * (i + 0.5) / N
			b.add("box", Vector3(0, y0, bow.call(y0)), Vector3(w * 0.96, h / N + 0.004, 0.008), paper)
		var fz = func(y: float) -> float: return bow.call(y) - 0.006
		for sy in [-1.0, 1.0]:
			var by = sy * (h * 0.5 - h * 0.17)
			b.add("box", Vector3(0, by, fz.call(by)), Vector3(w * 0.96, h * 0.07, 0.004), red)
			b.add("box", Vector3(0, by - sy * h * 0.06, fz.call(by)), Vector3(w * 0.9, h * 0.012, 0.004), ink)
		# dikey yazı sütunları (kısa fırça darbeleri)
		for col in 6:
			var x = -w * 0.38 + col * w * 0.152
			if absf(x) < w * 0.12:
				continue   # mühre yer
			var yy = h * 0.25
			var k = 0
			while yy > -h * 0.27:
				var L = h * (0.025 + 0.035 * float((col * 7 + k * 3) % 4) / 3.0)
				b.add("box", Vector3(x, yy - L * 0.5, fz.call(yy)), Vector3(w * 0.035, L, 0.004), ink)
				yy -= L + h * 0.022
				k += 1
		# ortada kırmızı mühür (daire) + içinde mürekkep işaret
		b.add("cyl", Vector3(0, 0, fz.call(0.0) - 0.002), Vector3(w * 0.22, 0.004, w * 0.22), red, Vector3(90, 0, 0), 20)
		b.add("cyl", Vector3(0, 0, fz.call(0.0) - 0.004), Vector3(w * 0.18, 0.004, w * 0.18), paper, Vector3(90, 0, 0), 20)   # hanko: içte ince halka
		b.add("cyl", Vector3(0, 0, fz.call(0.0) - 0.006), Vector3(w * 0.165, 0.004, w * 0.165), red, Vector3(90, 0, 0), 20)
		for st in [[0.0, 0.035, 0.11, 0.018, 0.0], [0.0, -0.005, 0.09, 0.016, 0.0], [-0.012, -0.01, 0.016, 0.12, 0.0], [0.03, -0.04, 0.016, 0.06, 35.0], [-0.032, -0.042, 0.016, 0.055, -35.0]]:
			b.add("box", Vector3(st[0] * w * 2.0, st[1] * w * 2.0, fz.call(0.0) - 0.008), Vector3(st[2] * w, st[3] * w, 0.004), ink, Vector3(0, 0, st[4]))   # mürekkep "封" benzeri işaret
		return b)
	var rmesh = cached("scroll3r_%d" % int(w * 100), func():
		var b = MB.new()
		var paper = Color(0.96, 0.93, 0.83)
		var red = Color(0.72, 0.14, 0.13)
		var ry = 0.0
		b.add("cyl", Vector3(0, ry, 0.0), Vector3(0.075, w, 0.075), paper.darkened(0.08), Vector3(0, 0, 90), 14)
		b.add("cyl", Vector3(0, ry, 0.0), Vector3(0.079, w * 0.1, 0.079), red, Vector3(0, 0, 90), 14)   # rulo bağı
		b.add("cyl", Vector3(0, ry, 0.0), Vector3(0.032, w + 0.12, 0.032), Color(0.36, 0.2, 0.1), Vector3(0, 0, 90), 10)
		for sx in [-1.0, 1.0]:
			b.add("cyl", Vector3(sx * (w * 0.5 + 0.03), ry, 0.0), Vector3(0.05, 0.014, 0.05), Color(0.85, 0.68, 0.25), Vector3(0, 0, 90), 12)
			b.add("sphere", Vector3(sx * (w * 0.5 + 0.068), ry, 0.0), Vector3(0.058, 0.058, 0.058), Color(0.62, 0.1, 0.1), Vector3.ZERO, 10)

		return b)
	var root = Node3D.new()
	root.set_meta("h", h)
	var pm = mi_of(pmesh)
	pm.name = "paper"
	root.add_child(pm)
	for nm in ["ra", "rb"]:
		var r = mi_of(rmesh)
		r.name = nm
		r.position.y = h * 0.5 if nm == "ra" else -h * 0.5
		root.add_child(r)
	return root


## Kâğıdın açık boyu (rulolar arası)
func scroll_len(sc: Node3D, L: float) -> void:
	if not is_instance_valid(sc):
		return
	var h = float(sc.get_meta("h", 1.0))
	sc.get_node("paper").scale.y = maxf(0.001, L / h)
	sc.get_node("paper").visible = L > 0.02
	sc.get_node("ra").position.y = L * 0.5
	sc.get_node("rb").position.y = -L * 0.5


## Elde açılan parşömen: rulolar iki elde, kâğıt ellerin arasında (eller ayrıldıkça açılır); dur boyunca ellere bağlı.
## Rulo ekseni yukarı, yazılı yüz atanın önüne bakar. Atan ölürse/silinirse parşömen de gider.
func hold_scroll(c: Node3D, dur: float, w := 0.42, h := 0.6) -> Node3D:
	var sc = scroll_node(w, h)
	scene_add(sc, live_hand(c, true))
	scroll_len(sc, 0.0)
	every(dur, 1.0 / 60.0, func(_i, _k):
		if not (is_instance_valid(sc) and is_instance_valid(c)):
			return
		var a = live_hand(c, false)
		var b = live_hand(c, true)
		var d = b - a
		var L = d.length()
		var fdir: Vector3 = c.face_dir()
		var y = d / L if L > 0.01 else fdir.cross(Vector3.UP).normalized()
		var x = Vector3.UP - y * Vector3.UP.dot(y)
		x = x.normalized() if x.length() > 0.05 else fdir
		var z = x.cross(y)
		if z.dot(fdir) > 0.0:
			y = -y
			z = -z
		sc.global_transform = Transform3D(Basis(x, y, z), (a + b) * 0.5)
		scroll_len(sc, clampf(L - 0.1, 0.0, h * 2.2)), func():
		pass)
	return sc


## Kapalı parşömen elde (rulo dik): dur boyunca o ele bağlı
func hold_closed_scroll(c: Node3D, right: bool, dur: float, w := 0.42) -> Node3D:
	var sc = scroll_node(w, 0.4)
	scene_add(sc, live_hand(c, right))
	scroll_len(sc, 0.0)
	every(dur, 1.0 / 60.0, func(_i, _k):
		if is_instance_valid(sc) and is_instance_valid(c):
			sc.global_position = live_hand(c, right)
			sc.global_rotation = Vector3(0, 0, PI * 0.5) + Vector3(0, atan2(c.face_dir().x, c.face_dir().z), 0))
	return sc


## Hazırlık kancaları (CastAnim._begin çağırır, release_t = mühür + hazırlık süresi): parşömen hazırlıkta ele gelir
func form_buki_kuchiyose(c: Node3D, rt: float) -> void:
	var sc = hold_scroll(c, rt + 1.3, 0.42, 0.7)
	c.set_meta("pj_scroll", sc)
	after(rt + 1.35, func():
		if is_instance_valid(sc):
			fade_free(sc, 0.0, 0.25))


func form_sogu_tensasai(c: Node3D, rt: float) -> void:
	c.set_meta("pj_scroll", hold_scroll(c, rt + 0.02, 0.42, 0.7))


func form_soshoryu(c: Node3D, rt: float) -> void:
	# eğilip iki kapalı parşömeni yere koyar
	for r in [true, false]:
		var sc = hold_closed_scroll(c, r, rt)
		free_after(rt, sc)


func _held(c: Node3D) -> Node3D:
	if c.has_meta("pj_scroll"):
		var sc = c.get_meta("pj_scroll")
		c.remove_meta("pj_scroll")
		if is_instance_valid(sc):
			return sc
	return null


## Silah Yağmuru: önünde parşömen açılır, on iki farklı silah art arda fırlar
func p_buki_kuchiyose(c: Node3D, t: Node3D) -> void:
	var d = Jutsu._aim(c, t)
	var fd = fwd(c, t)
	busy(c, 1.2)
	var sc = _held(c)
	if sc == null:   # koreografisiz çağrı (AI kısa yol): parşömen yine elde açılır
		sc = hold_scroll(c, 1.3, 0.42, 0.7)
		fade_free(sc, 1.3, 0.25)
	Sfx.play("poof", sc.global_position, 1.1)
	var tt = tg(c, t, 35.0)
	for k in 12:
		var kind: String = WEAPON_KINDS[k]
		after(0.18 + k * 0.07, func():
			if not is_instance_valid(sc):
				return
			# kâğıdın üstündeki mühürlerden biri: silah kâğıttan dışarı fırlar
			var from = sc.global_position + sc.global_basis.y * randf_range(-0.3, 0.3) + sc.global_basis.x * randf_range(-0.15, 0.15) - sc.global_basis.z * 0.15
			var to = (tt.global_position + Vector3.UP * tt.height * 0.5 + Vector3(randf_range(-0.6, 0.6), randf_range(-0.3, 0.4), randf_range(-0.6, 0.6))) if tt and live(tt) else from + d * 30.0 + Vector3(randf_range(-2, 2), randf_range(-1, 1), randf_range(-2, 2))
			throw_weapon(c, "buki_kuchiyose", kind, from, to, 48.0, 0.28 if kind not in ["fuma", "ono", "kusari"] else 0.45, tt if tt and live(tt) else null)
			Sfx.play("kunai", from, randf_range(0.9, 1.3), 0.6))


## Demir Pençe Zinciri: zincir hedefe dolanıp onu sana çeker; hedef yoksa zemine saplanıp seni oraya çeker (kanca)
func p_tesso_kusari(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 26.0)
	var from = hand_pos(c, true)
	var to = tt.global_position + Vector3.UP * tt.height * 0.5 if tt else gp(Jutsu._aim_ground(c, t, 18.0, 26.0)) + Vector3.UP * 0.2
	busy(c, 0.9)
	anim(c, "throw", 1.4)
	var claw_mesh = cached("tesso_claw", func():
		# demir pençe: zincir halkalı göbek + üç kalın kavisli kanca (uçları içe kıvrık, kenarları parlak çelik)
		var b = MB.new()
		var iron = Color(0.26, 0.25, 0.28)
		var steel = Color(0.78, 0.8, 0.86)
		b.add("torus", Vector3(0, 0, 0.2), Vector3(0.14, 0.04, 0.14), iron, Vector3(0, 90, 0), 10)   # zincir halkası
		Loft.blob(b, Vector3(0, 0, 0.12), Vector3(0, 0, -1), 0.32, [Vector2(0.06, 0.06), Vector2(0.13, 0.13), Vector2(0.12, 0.12), Vector2(0.08, 0.08)], iron, 10)   # göbek
		for k in 3:
			var a = k * TAU / 3.0 + PI * 0.5
			var r = Vector3(cos(a), sin(a), 0)
			Loft.tube(b, [r * 0.08 + Vector3(0, 0, -0.12), r * 0.2 + Vector3(0, 0, -0.26), r * 0.24 + Vector3(0, 0, -0.44), r * 0.16 + Vector3(0, 0, -0.58), r * 0.05 + Vector3(0, 0, -0.62)], [0.055, 0.05, 0.04, 0.025, 0.004], steel.darkened(0.15), 6, 4)
		return b)
	var claw = mi_of(claw_mesh)
	scene_add(claw, from)
	toward(claw, to - from)
	var chain_mat = Props.toon_color(Color(0.35, 0.34, 0.38))
	tether(func(): return hand_pos(c, true) if is_instance_valid(c) else from, func(): return claw.global_position if is_instance_valid(claw) else from, 0.07, chain_mat, 1.25)
	Sfx.play("clink", from, 1.2)
	var tw = claw.create_tween()
	tw.tween_property(claw, "global_position", to, 0.22)
	tw.tween_callback(func():
		if tt and live(tt):
			hit(c, to, tt.radius + 0.5, inf(c, "tesso_kusari", 0.7, {"knock": 0.0, "kind": "heavy", "hitstop": 0.06}))
			st(tt, "bind", 0.6)
			Combat.popup_text(to + Vector3.UP, "Zincirlendi!", Color(0.85, 0.85, 0.9))
			after(0.15, func():
				if live(tt):
					pull_to(c, tt, 0.35, 1.4)
					st(tt, "stun", 2.0))
			every(0.6, 1.0 / 30.0, func(_i, _k):
				if live(tt) and is_instance_valid(claw):
					claw.global_position = tt.global_position + Vector3.UP * tt.height * 0.5, func():
				if is_instance_valid(claw):
					claw.queue_free())
		else:
			FX.dust(gp(to), 0.6)
			VFX.cracks(gp(to), 1.2)
			# kanca: seni zincirin ucuna çeker
			var start = c.global_position
			if c is Player:
				c.combat.invuln = 0.4
			every(0.35, 1.0 / 40.0, func(_i, k):
				if is_instance_valid(c):
					c.global_position = start.lerp(gp(to), k) + Vector3.UP * sin(k * PI) * 2.0, func():
				if is_instance_valid(claw):
					claw.queue_free()))


const HELIX_R := 3.4
const HELIX_H := 21.0
const HELIX_TURNS := 1.7


## Sōshōryū sarmalı: s (0..1) boyunca nokta (yerel, taban merkezli); off: yarıçapa ek (dış/iç yüz)
func _helix_pt(s: float, phase: float, off: float) -> Vector3:
	var a = s * TAU * HELIX_TURNS + phase
	var r = HELIX_R + s * 1.2 + off
	return Vector3(cos(a) * r, 0.4 + s * HELIX_H, sin(a) * r)


## Sarmal parşömen şeridi: genişlik silindir yüzeyinde, yola dik (anime: geniş kağıt bant); UV.x = uzunluk, UV.y = en
func _helix_ribbon(phase: float, off: float) -> ArrayMesh:
	var key = "helix_%d_%d" % [int(phase * 100), int(off * 1000)]
	if _mcache.has(key):
		return _mcache[key]
	var st = SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var N = 120
	var W = 1.5
	var prev: Array = []
	for i in N + 1:
		var s = float(i) / N
		var p = _helix_pt(s, phase, off)
		var tg = (_helix_pt(minf(1.0, s + 0.005), phase, off) - _helix_pt(maxf(0.0, s - 0.005), phase, off)).normalized()
		var rad = Vector3(p.x, 0, p.z).normalized()
		var wv = tg.cross(rad).normalized() * W * 0.5
		var cur = [p - wv, p + wv, s]
		if not prev.is_empty():
			for v in [[prev[0], prev[2], 0.0], [prev[1], prev[2], 1.0], [cur[1], s, 1.0], [prev[0], prev[2], 0.0], [cur[1], s, 1.0], [cur[0], s, 0.0]]:
				st.set_uv(Vector2(v[1], v[2]))
				st.set_normal(rad)
				st.add_vertex(v[0])
		prev = cur
	_mcache[key] = st.commit()
	return _mcache[key]


static var _rib_sh: Shader
func _ribbon_shader() -> Shader:
	if _rib_sh == null:
		_rib_sh = Shader.new()
		_rib_sh.code = """
shader_type spatial;
render_mode cull_disabled, unshaded, depth_draw_opaque;
uniform bool outer = true;
uniform float reveal = 0.0;
uniform float alpha = 1.0;
uniform vec3 red : source_color = vec3(0.76, 0.32, 0.38);
uniform vec3 yellow : source_color = vec3(0.98, 0.92, 0.55);
uniform vec3 paper : source_color = vec3(0.97, 0.95, 0.9);
uniform vec3 ink : source_color = vec3(0.22, 0.12, 0.12);
void fragment() {
	if (UV.x > reveal) discard;
	float e = abs(UV.y - 0.5);
	vec3 c = outer ? (e < 0.13 ? yellow : red) : paper;
	if (e > 0.45) c = ink;   // anime kenar çizgisi
	ALBEDO = c;
	ALPHA = alpha;
}
"""
	return _rib_sh


## Sōshōryū (anime): yere konan iki parşömen ikiz ejderha gibi çift sarmal çizip göğe açılır; atan aralarında 15 m yükselir,
## kollar iki yana açık havada döner ve dönerken iki elinden sırayla silah fırlatır — silahlar düşmanın tam üstüne yağar.
func p_soshoryu(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 34.0)
	var fd = fwd(c, t)
	var aim0 = gp(Jutsu._aim_ground(c, t, 12.0, 30.0))
	var tpos = func() -> Vector3: return tt.global_position + Vector3.UP * tt.height * 0.4 if tt and live(tt) else aim0
	busy(c, 3.2)
	if c is Player:
		c.combat.invuln = 3.2
	var base = c.global_position
	VFX.slowmo(0.6, 0.5)
	Sfx.play("poof", base, 0.8)
	# anime: iki dev parşömen (dışı kırmızı + sarı orta çizgi, içi beyaz) çift sarmal çizerek göğe açılır; ucunda rulo döner
	for k in 2:
		var rib = Node3D.new()
		scene_add(rib, base)
		var mats: Array = []
		for outer in [true, false]:
			var m = ShaderMaterial.new()
			m.shader = _ribbon_shader()
			m.set_shader_parameter("outer", outer)
			var mi = mi_of(_helix_ribbon(k * PI, 0.035 if outer else -0.035), m)
			rib.add_child(mi)
			mats.append(m)
		var head = scroll_node(0.5, 0.35)
		scene_add(head, base)
		head.scale = Vector3.ONE * 3.0
		every(1.0, 1.0 / 40.0, func(_i, kk):
			var rv = 1.0 - pow(1.0 - kk, 2.0)   # hızlı açılır, tepede yavaşlar
			for m in mats:
				m.set_shader_parameter("reveal", rv)
			if is_instance_valid(head):
				head.global_position = base + _helix_pt(rv, k * PI, 0.0)
				head.look_at(base + _helix_pt(minf(1.0, rv + 0.02), k * PI, 0.0) + Vector3(0.001, 0, 0), Vector3.UP)
				head.rotate_object_local(Vector3.RIGHT, kk * 40.0), func():
			if is_instance_valid(head):
				head.queue_free())
		var tw = rib.create_tween()
		tw.tween_interval(2.2)
		tw.tween_method(func(v):
			for m in mats:
				m.set_shader_parameter("alpha", v), 1.0, 0.0, 0.5)
		tw.tween_callback(rib.queue_free)
	# iki elde kunai
	var held: Array = []
	for bn in ["RightHand", "LeftHand"]:
		var at = bone_attach(c, bn)
		if at:
			var km = mi_of(weapon_mesh("kunai"))
			at.add_child(km)
			km.rotation_degrees = Vector3(90, 0, 0)
			km.scale = Vector3.ONE * 1.2
			held.append(at)
	var TOP = 15.0
	var spin = {"a": 0.0}
	# yükseliş (sarmal açılırken ortadan), sonra tepede dönerek atış, sonra serbest düşüş
	every(2.6, 1.0 / 60.0, func(_i, kk):
		if not live(c):
			return
		var tsec = kk * 2.6
		var h = TOP * (1.0 - pow(1.0 - clampf(tsec / 0.85, 0.0, 1.0), 3.0)) + sin(tsec * 5.0) * 0.25 * clampf(tsec - 0.85, 0.0, 1.0)
		c.global_position = base + Vector3.UP * h
		if "velocity" in c:
			c.velocity = Vector3.ZERO
		# dönüş: yükselirken hızlanır, tepede sürekli (anime: kollar açık topaç gibi döner)
		spin["a"] += (6.0 + 8.0 * clampf(tsec / 0.85, 0.0, 1.0)) / 60.0
		if "facing" in c:
			c.facing = spin["a"]
		elif c.get("model"):
			c.model.rotation.y = spin["a"], func():
		if live(c) and "velocity" in c:
			c.velocity = Vector3(0, -4.0, 0)
		for at in held:
			if is_instance_valid(at):
				at.queue_free())
	# atışlar: tepeye varınca, dönüşün her yarım turunda öndeki el fırlatır (sağ/sol sırayla)
	for k in 30:
		after(0.85 + k * 0.055, func():
			if not live(c):
				return
			var right = k % 2 == 0
			var from = live_hand(c, right)
			var to = tpos.call() + Vector3(randf_range(-0.7, 0.7), randf_range(-0.3, 0.3), randf_range(-0.7, 0.7))
			WindFX.streak(func(q: float) -> Vector3: return from.lerp(to, q), 0.35, 0.07, Color(1, 1, 1))
			var pr = throw_weapon(c, "soshoryu", WEAPON_KINDS[k % WEAPON_KINDS.size()], from, to, 58.0, 0.1, tt if tt and live(tt) else null)
			pr.on_hit = func(pos: Vector3, _tg: Node3D) -> void:
				hit(c, pos, 1.2, inf(c, "soshoryu", 0.1, {"knock": 2.0, "kind": "light"}))
				FX.dust(pos, 0.3)
			if k % 4 == 0:
				Sfx.play("kunai", from, randf_range(0.9, 1.3), 0.7))
	after(2.55, func():
		FX.ring(gp(tpos.call()) + Vector3.UP * 0.1, Color(0.95, 0.9, 0.8), 6.0, 0.5, true)
		shake(0.4))


## Demir Yelpaze: dev demir yelpaze açılır, 6 sn mermileri durdurur; kapanırken savurduğu rüzgar düşmanları uçurur
func p_tekkosen(c: Node3D, t: Node3D) -> void:
	var fd = fwd(c, t)
	busy(c, 0.6)
	var mesh = cached("tekkosen", func():
		# gerçek tessen: kesintisiz yelpaze yaprağı (dar dilimler, aralıksız, hafif körük katlı), ince koyu demir kaburgalar,
		# dış kenarda kırmızı şerit + metal çerçeve, menteşe pimi (eski hali: arası açık kalın kalaslar + uçlarda altın topuzlar)
		var b = MB.new()
		var A0 = -78.0; var A1 = 78.0
		var NS = 40
		for k in NS:
			var a = deg_to_rad(lerpf(A0, A1, (k + 0.5) / NS))
			var da = deg_to_rad((A1 - A0) / NS)
			var fold = 0.04 if k % 2 == 0 else -0.04   # körük katı
			for band in 3:
				var r0 = 1.0 + band * 1.15
				var r1 = r0 + 1.15
				var rm = (r0 + r1) * 0.5
				var col = Color(0.36, 0.37, 0.42).darkened(0.08 * (k % 2)) if band < 2 else Color(0.62, 0.12, 0.12).darkened(0.08 * (k % 2))
				b.add("box", Vector3(sin(a) * rm, cos(a) * rm, fold), Vector3(rm * da * 1.08, r1 - r0 + 0.02, 0.03), col, Vector3(0, 0, -rad_to_deg(a)))
		for k in 13:   # kaburgalar (önde ve arkada)
			var a = deg_to_rad(lerpf(A0, A1, k / 12.0))
			for z in [0.05, -0.05]:
				b.add("box", Vector3(sin(a) * 2.3, cos(a) * 2.3, z), Vector3(0.07, 4.6, 0.03), Color(0.14, 0.13, 0.15), Vector3(0, 0, -rad_to_deg(a)))
		for k in 30:   # dış metal çerçeve
			var a = deg_to_rad(lerpf(A0, A1, (k + 0.5) / 30.0))
			b.add("box", Vector3(sin(a) * 4.47, cos(a) * 4.47, 0), Vector3(4.47 * deg_to_rad((A1 - A0) / 30.0) * 1.05, 0.08, 0.07), Color(0.55, 0.55, 0.58), Vector3(0, 0, -rad_to_deg(a)))
		b.add("cyl", Vector3(0, 0, 0), Vector3(0.32, 0.2, 0.32), Color(0.75, 0.62, 0.3), Vector3(90, 0, 0), 12)   # menteşe pimi
		return b)
	var fan = mi_of(mesh)
	fan.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
	var root = Node3D.new()
	scene_add(root, gp(c.global_position + fd * 2.4))
	toward(root, -fd)
	root.add_child(fan)
	fan.position = Vector3(0, 0.4, 0)
	fan.scale = Vector3(0.05, 1, 1)
	var tw = fan.create_tween()
	tw.tween_property(fan, "scale", Vector3.ONE, 0.25).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	var sb = StaticBody3D.new()
	sb.collision_layer = 1
	var cs = CollisionShape3D.new()
	var bx = BoxShape3D.new()
	bx.size = Vector3(8.0, 4.8, 0.8)
	cs.shape = bx
	cs.position = Vector3(0, 2.6, 0)
	sb.add_child(cs)
	root.add_child(sb)
	Sfx.play("clink", root.global_position, 0.6)
	every(6.0, 0.05, func(_i, _k):
		if not is_instance_valid(root):
			return
		for pr in get_tree().get_nodes_in_group("projectiles"):
			if pr is Projectile and is_instance_valid(pr) and pr.shooter != c and pr.global_position.distance_to(root.global_position + Vector3.UP * 2.5) < 4.8:
				FX.hit_spark(pr.global_position, Color(1, 0.9, 0.6), 1.0)
				Sfx.play("clink", pr.global_position, 1.3, 0.6)
				pr.queue_free(), func():
		if not is_instance_valid(root):
			return
		var t2 = fan.create_tween()
		t2.tween_property(fan, "rotation:y", PI * 0.5, 0.2)
		t2.tween_callback(root.queue_free)
		var wd = fd
		if is_instance_valid(c):
			wd = c.face_dir()
		VFX.shockwave(root.global_position + Vector3.UP * 1.5, Color(0.85, 0.95, 1.0), 12.0, 0.35, false, wd)
		Sfx.play("wind", root.global_position, 0.9)
		for e in enemies_near(c, root.global_position + wd * 6.0, 8.0):
			hit(c, e.global_position + Vector3.UP, e.radius + 0.5, inf(c, "tekkosen", 0.9, {"knock": 24.0, "launch": 9.0, "kind": "heavy", "hitstop": 0.05})))


## Telli Silah Fırtınası: 10 silah tellerle etrafında döner; her 0.45 sn ikisi en yakın düşmanlara saplanıp geri döner, tele dolanan bağlanır
func p_ito_buki_arashi(c: Node3D, _t: Node3D) -> void:
	var dur = 7.0
	busy(c, 0.5)
	var wire = glow(Color(0.75, 0.9, 1.0), 0.75)
	var ws = []
	for k in 10:
		var w = Node3D.new()
		w.add_child(mi_of(weapon_mesh(WEAPON_KINDS[k % WEAPON_KINDS.size()])))
		scene_add(w, c.global_position + Vector3.UP)
		ws.append({"n": w, "a": TAU * k / 10.0, "busy": 0.0})
		var wn = w
		tether(func(): return hand_pos(c, k % 2 == 0) if is_instance_valid(c) else Vector3.ZERO, func(): return wn.global_position if is_instance_valid(wn) else Vector3.ZERO, 0.025, wire, dur)
	Sfx.play("whoosh", c.global_position, 0.9)
	var acc = {"t": 0.0}
	every(dur, 1.0 / 30.0, func(_i, kk):
		if not is_instance_valid(c):
			return
		acc["t"] += 1.0 / 30.0
		var tt = Time.get_ticks_msec() * 0.001
		for w in ws:
			var n: Node3D = w["n"]
			if not is_instance_valid(n):
				continue
			if w["busy"] > 0.0:
				w["busy"] -= 1.0 / 30.0
				continue
			var a = w["a"] + tt * 3.2
			var rest = c.global_position + Vector3(cos(a) * 3.2, 1.2 + sin(tt * 2.0 + w["a"]) * 0.5, sin(a) * 3.2)
			n.global_position = n.global_position.lerp(rest, 0.35)
			toward(n, Vector3(-sin(a), 0, cos(a)))
			for e in enemies_near(c, n.global_position, 0.9):
				hit(c, n.global_position, 1.0, inf(c, "ito_buki_arashi", 0.08, {"knock": 1.5, "kind": "light", "hitstop": 0.0}))
		if acc["t"] >= 0.45:
			acc["t"] = 0.0
			var near = enemies_near(c, c.global_position, 16.0)
			if near.is_empty():
				return
			var sent = 0
			for w in ws:
				if sent >= 2 or w["busy"] > 0.0 or not is_instance_valid(w["n"]):
					continue
				var e = near[(sent + int(tt * 10.0)) % near.size()]
				var n: Node3D = w["n"]
				w["busy"] = 0.5
				sent += 1
				var from = n.global_position
				var to = e.global_position + Vector3.UP * e.height * 0.5
				var tw = n.create_tween()
				tw.tween_property(n, "global_position", to, 0.14)
				tw.tween_callback(func():
					if live(e):
						hit(c, to, e.radius + 0.5, inf(c, "ito_buki_arashi", 0.32, {"knock": 2.0, "kind": "light", "hitstop": 0.03}))
						st(e, "bind", 0.6)
						Sfx.play("kunai", to, 1.2, 0.5))
				tw.tween_property(n, "global_position", from, 0.2), func():
		for w in ws:
			if is_instance_valid(w["n"]):
				FX.smoke_puff(w["n"].global_position, 0.3, 4)
				w["n"].queue_free())


## Dev demir topuz gövdesi (Tenten): koyu demir küre + köşeli dikenler + halka (önbellekli)
func _tetsuzan_mesh() -> ArrayMesh:
	return cached("tetsuzan", func():
		var b = MB.new()
		# ref (Tenten "Gigantic Iron Ball"): neredeyse siyah dev demir top, her yanında kalın kısa köşeli dikenler (aynı koyu demir)
		b.add_grad("sphere", Vector3.ZERO, Vector3(7.0, 7.0, 7.0), Color(0.2, 0.2, 0.22), Color(0.1, 0.1, 0.11), Vector3.ZERO, 16)
		for k in 40:
			var a = k * 2.4
			var y = -0.95 + 1.9 * float(k) / 39.0
			var r = sqrt(maxf(0.0, 1.0 - y * y))
			var dir = Vector3(cos(a) * r, y, sin(a) * r).normalized()
			var basis = Basis(Quaternion(Vector3.UP, dir))
			var e = basis.get_euler()
			b.add("cone", dir * 3.55, Vector3(1.25, 1.5, 1.25), Color(0.17, 0.17, 0.19).lightened(0.05 * (k % 3)), Vector3(rad_to_deg(e.x), rad_to_deg(e.y), rad_to_deg(e.z)), 4)
		b.add("box", Vector3(0, 3.6, 0), Vector3(0.6, 1.4, 0.6), Color(0.3, 0.28, 0.3))
		b.add("torus", Vector3(0, 4.5, 0), Vector3(1.4, 1.4, 1.4), Color(0.3, 0.28, 0.3), Vector3(90, 0, 0), 10)
		return b)


## Dev Demir Topuz: gökte çağırma çemberi açılır, çivili dev topuz düşüp krater açar
func p_kuchiyose_tetsuzan(c: Node3D, t: Node3D) -> void:
	var center = gp(Jutsu._aim_ground(c, t, 14.0, 32.0))
	busy(c, 0.8)
	var sky = center + Vector3.UP * 28.0
	summon_circle(gp(c.global_position + c.face_dir() * 1.2), 3.0, Color(0.85, 0.3, 0.25), 1.0)   # kanon kuchiyose mührü: avuç yere
	ground_disc(sky, 6.0, Color(0.85, 0.3, 0.25), 1.0, 2, 12).global_position = sky
	ground_disc(center, 8.0, Color(1.0, 0.4, 0.3), 1.0, 1, 0)
	Sfx.play("poof", sky, 0.6)
	var mesh = _tetsuzan_mesh()
	var ball = mi_of(mesh)
	ball.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
	scene_add(ball, sky)
	ball.scale = Vector3.ONE * 0.2
	var tw = ball.create_tween()
	tw.tween_property(ball, "scale", Vector3.ONE, 0.3).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tw.tween_property(ball, "global_position", center + Vector3.UP * 2.2, 0.45).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	tw.tween_callback(func():
		VFX.slowmo(0.5, 0.25)
		shake(1.3)
		VFX.cracks(center, 14.0)
		VFX.debris(center, Color(0.45, 0.38, 0.3), 30, 18.0, 0.9)
		FX.dust(center, 3.5)
		VFX.shockwave(center + Vector3.UP * 0.3, Color(0.85, 0.75, 0.6), 28.0, 0.5, true)
		Sfx.play("boom", center, 0.6)
		hit(c, center + Vector3.UP, 8.5, inf(c, "kuchiyose_tetsuzan", 2.4, {"knock": 18.0, "launch": 12.0, "kind": "heavy", "hitstop": 0.14})))
	tw.tween_interval(3.0)
	tw.tween_callback(func(): FX.smoke_puff(ball.global_position, 3.0, 18))
	tw.tween_property(ball, "scale", Vector3.ONE * 0.01, 0.3)
	tw.tween_callback(ball.queue_free)


## Bashōsen: palmiye yaprağı biçimli efsanevi yelpaze elde belirir; her sargı ayrı bir doğa — ek chakra emer
func bashosen_fan(c: Node3D, el_col: Color) -> Node3D:
	# anime Bashōsen (kuşanılan silahla aynı model): kırmızı uçlu beyaz tüy yelpaze; savuruşta tüylerden element parıltısı saçılır
	var root = Node3D.new()
	var mi = MeshInstance3D.new()
	mi.mesh = CharacterModel.weapon_mesh("bashosen")
	mi.rotation_degrees = Vector3(-90, 0, 0)   # silah +Z boyunca kurulu; eski yelpaze +Y idi
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	root.add_child(mi)
	after(0.2, func():
		if is_instance_valid(root):
			FX.burst(root.global_position + Vector3.UP * 0.8, {"amount": 24, "life": 0.5, "tex": FX.tex_spark, "add": true, "size": 0.25, "radius": 0.8, "vmin": 2, "vmax": 5,
				"colors": [Color(1, 1, 1, 1), el_col, Color(el_col.r, el_col.g, el_col.b, 0)]}))
	# tekniği atarken sırttaki (kınındaki) Bashōsen gizlenir: aynı anda hem elde hem sırtta görünmesin
	var md = c.get("model")
	var hidden = []
	if md and "weapons" in md:
		for w in md.weapons:
			if String(w.get("id", "")) == "bashosen" and is_instance_valid(w["node"]) and w["node"].visible:
				w["node"].visible = false
				hidden.append(w["node"])
	after(1.9, func():
		for n in hidden:
			if is_instance_valid(n):
				n.visible = true)
	var ba = bone_attach(c, "RightHand")
	if ba:
		ba.add_child(root)
		root.rotation_degrees = Vector3(-90, 0, 0)
	else:
		scene_add(root, hand_pos(c, true))
	root.scale = Vector3.ONE * 0.05
	var tw = root.create_tween()
	tw.tween_property(root, "scale", Vector3.ONE * 1.25, 0.25).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tw.tween_interval(1.4)
	tw.tween_property(root, "scale", Vector3.ONE * 0.05, 0.25)
	tw.tween_callback(func():
		if is_instance_valid(ba):
			ba.queue_free()
		elif is_instance_valid(root):
			root.queue_free())
	if c is Player:
		c.chakra = maxf(0.0, c.chakra - c.max_chakra * 0.15)
		Combat.popup_text(c.global_position + Vector3.UP * 2.4, "Bashōsen chakranı emiyor!", Color(0.95, 0.85, 0.5))
	busy(c, 1.1)
	anim(c, "slash_a", 1.0)
	return root


func p_bashosen_kaze_no_maki(c: Node3D, t: Node3D) -> void:
	var d = fwd(c, t)
	bashosen_fan(c, Color(0.7, 1.0, 0.85))
	after(0.35, func():
		var tor = Node3D.new()   # hortumun görünmez merkezi; görüntü akım çizgisi girdabı + toz
		var start = gp(c.global_position + d * 4.0)
		scene_add(tor, start + Vector3.UP * 13.0)
		WindFX.gust(c.global_position + Vector3.UP * 1.2, d, 16.0, 5.0)
		Sfx.play("wind", start, 0.6)
		shake(0.6)
		var hits = {}
		every(3.0, 1.0 / 30.0, func(i, k):
			if not is_instance_valid(tor):
				return
			var p = gp(start + d * (k * 42.0)) + Vector3.UP * 13.0
			tor.global_position = p
			tor.rotate_y(0.6)
			var base = p - Vector3.UP * 12.0
			if i % 4 == 0:   # gövde: iç içe üç katman (dar hızlı + geniş yavaş), arada toz
				WindFX.swirl(base, 3.0, 20.0, 0.45, 10, Color(0.88, 1.0, 0.94, 0.9), i % 16 == 0)
				WindFX.swirl(base + Vector3.UP * 4.0, 5.0, 14.0, 0.6, 12, Color(0.8, 0.95, 1.0, 0.7), false)
			if i % 6 == 0:   # tabandan kıvrılarak çıkan uzun akım çizgileri (anime: yelpaze rüzgârının sarmal hatları)
				var ph = randf() * TAU
				var bp = base
				WindFX.streak(func(q: float) -> Vector3: return bp + Vector3(cos(ph + q * 7.0) * (2.0 + q * 4.0), q * 16.0, sin(ph + q * 7.0) * (2.0 + q * 4.0)),
					0.7, 0.12, Color(0.92, 1.0, 0.96), 0.0, 28)
			for e in enemies_near(c, base, 6.5):
				if live(e):
					e.global_position = e.global_position.lerp(base + Vector3.UP * minf(10.0, 2.0 + hits.get(e, 0) * 0.4), 0.15)
					hits[e] = hits.get(e, 0) + 1
					if hits[e] % 6 == 1:
						hit(c, e.global_position + Vector3.UP, e.radius + 0.6, inf(c, "bashosen_kaze_no_maki", 0.35, {"element": "fuuton", "knock": 4.0, "launch": 4.0, "kind": "heavy"})), func():
			if is_instance_valid(tor):
				fade_free(tor, 0.0, 0.4)))


func p_bashosen_hi_no_maki(c: Node3D, t: Node3D) -> void:
	var d = fwd(c, t)
	var side = d.cross(Vector3.UP).normalized()
	bashosen_fan(c, Color(1.0, 0.55, 0.15))
	after(0.35, func():
		var wall = Node3D.new()
		var start = gp(c.global_position + d * 4.0)
		scene_add(wall, start)
		toward(wall, d)
		for n in 11:
			var cm = CylinderMesh.new()
			cm.top_radius = 0.3; cm.bottom_radius = 1.2; cm.height = 1.0; cm.radial_segments = 12; cm.rings = 4
			cm.cap_top = false; cm.cap_bottom = false
			var col = VFX._mi(cm, VFX.mat_fire("fire", 3.2, 1.8, 0.4, 1.4, 0.24, Vector3.UP, true))
			wall.add_child(col)
			var hh = 8.0 - absf(n - 5) * 0.55
			col.position = Vector3((n - 5) * 2.1, hh * 0.5, absf(n - 5) * 0.35)
			col.scale = Vector3(2.0, 0.1, 2.0)
			var ct = col.create_tween()
			ct.tween_interval(absf(n - 5) * 0.03)
			ct.tween_property(col, "scale", Vector3(2.0, hh, 2.0), 0.25).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		Sfx.play("fire", start, 0.6)
		shake(0.7)
		var hits = {}
		every(2.4, 1.0 / 30.0, func(i, k):
			if not is_instance_valid(wall):
				return
			var p = gp(start + d * (k * 36.0))
			wall.global_position = p
			if i % 3 == 0:
				VFX.embers(p + side * randf_range(-10, 10) + Vector3.UP * 2.0, Color(1, 0.55, 0.15), 10, 10.0)
				if i % 9 == 0:
					VFX.black_smolder(p + side * randf_range(-9, 9), 1.6, 3.0)
			for e in enemies_near(c, p + Vector3.UP, 11.5):
				var rel = e.global_position - p
				if absf(rel.dot(d)) < 2.5 and not hits.has(e):
					hits[e] = true
					hit(c, e.global_position + Vector3.UP, e.radius + 0.6, inf(c, "bashosen_hi_no_maki", 1.6, {"element": "katon", "burn": 6.0, "knock": 12.0, "launch": 5.0, "kind": "heavy"})), func():
			if is_instance_valid(wall):
				fade_free(wall, 0.0, 0.4)))


func p_bashosen_rai_no_maki(c: Node3D, t: Node3D) -> void:
