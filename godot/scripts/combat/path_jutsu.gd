## Kalp Çalma: iplikli el göğse dalar, atan kalp sökülür; azami can artar
func p_kakuzu_kalp_calma(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 8.0)
	busy(c, 1.0)
	if tt == null:
		return
	_jump_at(c, tt, 0.4, 8.0)
	after(0.35, func():
		if not (live(c) and live(tt)):
			return
		var heart = MeshInstance3D.new()
