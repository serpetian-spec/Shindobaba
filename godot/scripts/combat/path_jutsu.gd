## Kavurma Aşırı Buhar Cinayeti: etrafta güneş gibi parlayan ısı küreleri döner, hedefe çarpıp vücut suyunu buharlaştırır
func p_shakuton_kajosatsu(c: Node3D, t: Node3D) -> void:
	busy(c, 1.0)
	var tt = tg(c, t, 26.0)
	var orbs = []
	# anime: küreler iki yanda, avuçların hizasında (önüne gelip bedeni örtmez); kuyrukları dışa-geriye kıvrılır
	var fd = c.face_dir()
	var sd = fd.cross(Vector3.UP).normalized()
	var spots = [sd * 1.6 + Vector3.UP * 1.9, -sd * 1.6 + Vector3.UP * 1.9, sd * 1.3 + Vector3.UP * 0.9 - fd * 0.3, -sd * 1.3 + Vector3.UP * 0.9 - fd * 0.3]
	for k in 4:
		var o = VFX.scorch_orb(0.7)
		c.add_child(o)
		o.global_position = c.global_position + spots[k]
		var out = (spots[k] * Vector3(1, 0, 1)).normalized() - fd * 0.5
		o.look_at(o.global_position + out, Vector3.UP)
		orbs.append(o)
	for k in 4:
		after(0.4 + k * 0.12, func():
			var o = orbs[k]
			if not (live(c) and is_instance_valid(o)):
				return
			var from = o.global_position
			o.queue_free()
			var pr = shot(c, from, aim_at(c, tt, from), 24.0, VFX.scorch_orb(0.7), inf(c, "shakuton_kajosatsu", 0.9, {"knock": 4.0, "kind": "heavy", "element": "shakuton", "burn": 4.0}), tt, false, 1.6, func(p, h):
				VFX.puffs(p, {"amount": 30, "life": 1.2, "size": 0.9, "radius": 0.6, "vmin": 2, "vmax": 5, "dir": Vector3.UP, "spread": 50.0, "add": false,
					"colors": [Color(1, 1, 1, 0.9), Color(0.9, 0.9, 0.95, 0)]})
				_scorch_hit(p, 1.2, h)
				if h and live(h):
					st(h, "slow", 2.0))
			_scorch_trail(pr, 0.6))
	Sfx.play("fire", c.global_position, 1.0)


