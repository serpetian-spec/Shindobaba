## Buz Kırlangıç Fırtınası: onlarca buz kırlangıç ayna gibi parlayıp hedefe dalar
func p_hyoton_tsubame_fubuki(c: Node3D, t: Node3D) -> void:
	busy(c, 1.0)
	var tt = tg(c, t, 28.0)
	var d = fwd(c, tt)
	# buz kırlangıçlar ellerden kar tipisiyle doğup caster'ın çevresinde dönen bir sürü kurar, sonra tek tek hedefe dalar
	VFX.fog(c.global_position + Vector3.UP * 1.4, {"amount": 14, "life": 1.2, "size": 1.4, "radius": 1.0, "vmin": 0.5, "vmax": 1.5, "dir": Vector3.UP, "spread": 90.0,
		"colors": [Color(0.95, 0.98, 1.0, 0.0), Color(0.9, 0.96, 1.0, 0.5), Color(0.88, 0.95, 1.0, 0.0)]})
	FX.burst(c.global_position + Vector3.UP * 1.5, {"amount": 40, "life": 1.0, "tex": FX.tex_spark, "add": true, "size": 0.15, "radius": 1.5, "vmin": 1, "vmax": 3,
		"colors": [Color(1, 1, 1, 1), Color(0.75, 0.92, 1.0, 0.8), Color(0.7, 0.9, 1.0, 0)]})
	var n = 16
	for k in n:
		var bird = Node3D.new()
		var sw = IceArt.swallow(1.3)
		bird.add_child(sw)
		get_tree().current_scene.add_child(bird)
		var a0 = k * TAU / n
		var r = 2.2 + (k % 3) * 0.5
		var h = 1.4 + (k % 4) * 0.45
		var st0 = {"a": a0}
		# sürü: caster'ın çevresinde dönen halka (kırlangıçlar dönüş yönüne bakar, kanatlar hafif yatar)
		var tw = bird.create_tween()
		tw.tween_method(func(u: float):
			if not is_instance_valid(bird) or not live(c):
				return
			st0["a"] = a0 + u * 5.0
			var o = Vector3(cos(st0["a"]), 0, sin(st0["a"]))
			bird.global_position = c.global_position + o * r * minf(1.0, u * 4.0 + 0.2) + Vector3.UP * h
			bird.look_at(bird.global_position + Vector3(-sin(st0["a"]), 0, cos(st0["a"])), Vector3.UP)
			sw.rotation.z = sin(u * 40.0 + k) * 0.35, 0.0, 1.0, 0.35 + k * 0.035)
		tw.tween_callback(func():
			if not is_instance_valid(bird):
				return
			var from = bird.global_position
			bird.queue_free()
			if not live(c):
				return
			var holder = Node3D.new()
			holder.add_child(IceArt.swallow(1.3))
			var pr = shot(c, from, aim_at(c, tt, from) if tt else (d + Vector3(randf_range(-0.2, 0.2), 0, randf_range(-0.2, 0.2))).normalized(), 34.0, holder,
				inf(c, "hyoton_tsubame_fubuki", 0.22, {"knock": 2.0, "kind": "light", "element": "hyoton", "slow": 1.5, "bleed": 0.5}), tt, false, 1.4, func(p, _h):
					IceArt.shatter(get_tree(), p - Vector3.UP * 0.5, 0.5, 5))
			pr.homing_turn = 4.0
			VFX.trail(pr, 0.12, Color(1, 1, 1, 0.9), Color(0.75, 0.92, 1.0, 0.5), Color(0.7, 0.9, 1.0, 0), 10, 0.0))
	Sfx.play("wind", c.global_position, 1.6)


## Hyōton: Tsurara Rendan (kanon, Haku): senbonla iki kesik ve tekme, hedef savrulur; ardından havada oluşan iri buz iğneleri yağar
func p_hyoton_senbon(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 8.0)
	busy(c, 1.0)
	if tt:
		_jump_at(c, tt, 0.0, 10.0)
		for k in 2:
			after(0.12 + k * 0.16, func():
				if not (live(c) and live(tt)):
					return
				anim(c, ["slash_a", "slash_b"][k], 2.2)
				mhit(c, c.global_position + Vector3.UP * 1.1 + c.face_dir() * 1.0, 1.2, inf(c, "hyoton_senbon", 0.25, {"knock": 1.0, "launch": 0.0, "kind": "light", "bleed": 2.0})))
		after(0.5, func():
			if not (live(c) and live(tt)):
				return
			_kick_pose(c, 0.25)
			tt.take_hit(inf(c, "hyoton_senbon", 0.35, {"knock": 12.0, "launch": 2.0, "kind": "heavy", "dir": c.face_dir()})))
	after(0.75, func():
		if live(c):
			Jutsu.j_hyoton_senbon(c, t))


func _ticks_local(n: int, dt: float, fn: Callable, done := Callable()) -> void:
	every(n * dt, dt, func(i, _k): fn.call(i), done)


## Su kırbacı (referans: Suiben karesi): elden çıkan, havada kavis çizip hedefe dolanan ince ak-mavi su ipi; sallanır
func _water_whip(c: Node3D, tt: Node3D, dur: float) -> void:
	var mi = MeshInstance3D.new()
	mi.top_level = true
	mi.material_override = VFX.mat_water(Color(0.45, 0.65, 0.85), Color(0.75, 0.9, 1.0), Color(1, 1, 1), Vector3.FORWARD, 0.9, 0.8, 0.0)
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	get_tree().current_scene.add_child(mi)
	var side_sgn = 1.0 if randf() < 0.5 else -1.0
	_ticks_local(int(dur / 0.05), 0.05, func(i):
		if not (live(c) and is_instance_valid(tt)):
			return
		var a: Vector3 = hand_pos(c, true)
		var b: Vector3 = tt.global_position + Vector3.UP * 1.0
		var reach = ease(clampf(i * 0.05 / 0.25, 0.0, 1.0), 0.5)
		var d = b - a
		var sd = d.cross(Vector3.UP).normalized() * side_sgn
		var pts = []
		var rad = []
		for k in 25:
			var u = k / 24.0 * reach
			var arc = sin(u * PI) * (1.6 * (1.0 - reach * 0.6))   # fırlarken yüksek yay, dolanınca gerilir
			var wave = sin(u * TAU * 1.5 - i * 0.6) * 0.18 * (1.0 - u)
			pts.append(a + d * u + Vector3.UP * arc + sd * (sin(u * PI) * 0.8 * (1.0 - reach * 0.5) + wave))
			rad.append(Vector2(0.06, 0.06) * (1.0 - u * 0.4))
		var mb = MB.new()
		Loft.tube(mb, pts, rad, Color.WHITE, 8, 2, true, true)
		mi.mesh = mb.build(null), func():
		mi.queue_free())


## Suiton: Suiben (kanon, Kiri av ninjaları): sudan kırbaç hedefe dolanıp bağlar; kullanan raiton bilirse kırbaçtan şimşek
## akıtıp bağlananı çarpar. (Eski "Mizu Muchi" — Hōzuki tekniği değil, Kiri öğretmeninden öğrenilir.) Hedef yoksa önünü savurur.
func p_hozuki_mizu_muchi(c: Node3D, t: Node3D) -> void:
	busy(c, 0.8)
	var tt = tg(c, t, 12.0)
	var d = fwd(c, tt if tt else t)
	var rai = ("raiton" in Game.profile.get("elements", [])) if c is Player else String(c.get("element") if c.get("element") != null else "") == "raiton"
	after(0.2, func():
		if not live(c):
			return
		if tt == null or not live(tt):
			stream_fx(hand_pos(c, true), (d + Vector3.UP * 0.15).normalized(), 9.0, 0.3, _wmat(), 0.35, func(end):
				VFX.splash(end, 1.2))
			Combat.hit_zone(c, c.global_position, d, 9.0, 14.0, 2.5, inf(c, "hozuki_mizu_muchi", 0.6, {"knock": 8.0, "kind": "heavy", "element": "suiton"}))
			return
		# kırbaç elden hedefe uzanır, bedenine dolanır (halkalar), bağlar
		_water_whip(c, tt, 2.2)
		for k in 3:
			var ring = MeshInstance3D.new()
			var tm = TorusMesh.new()
			tm.inner_radius = 0.42
			tm.outer_radius = 0.55
			ring.mesh = tm
			ring.material_override = _wmat()
			attach(tt, ring, 2.2, Vector3.UP * (0.6 + k * 0.4))
		VFX.splash(tt.global_position + Vector3.UP, 1.4)
		st(tt, "bind", 2.2)
		st(tt, "wet", 6.0)
		tt.take_hit(inf(c, "hozuki_mizu_muchi", 0.5, {"knock": 0.0, "kind": "light", "element": "suiton"}))
		if rai:
			after(0.5, func():
				if not live(tt):
					return
				tether(func(): return hand_pos(c, true) if live(c) else Vector3.ZERO, func(): return tt.global_position + Vector3.UP if is_instance_valid(tt) else Vector3.ZERO, 0.05, VFX.mat_bolt(Color(0.75, 0.85, 1.0), 2.2), 0.6)
				Combat.popup_text(tt.global_position + Vector3.UP * 2.4, "Kırbaçtan şimşek!", Color(0.8, 0.9, 1.0))
				tt.take_hit(inf(c, "hozuki_mizu_muchi", 0.9, {"knock": 0.0, "kind": "heavy", "element": "raiton", "stun": 1.0}))))
	Sfx.play("water", c.global_position, 1.3)


## Patlayan Su Çarpışma Dalgası: ağızdan boşalan su alanı denize çevirir
func p_hoshigaki_bakusui_shoha(c: Node3D, t: Node3D) -> void:
	busy(c, 1.4)
