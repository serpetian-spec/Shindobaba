## Kuchiyose: Gama Mise no Jutsu (kanon, Jiraiya): dükkân kurbağası masum bir dükkâna dönüşür, yakındakiler içeri çekilir;
## mühürle yapı birkaç saniyede kurbağaya döner, içindekiler midesinde hapsolur (bağlı, görünmez, mide asidi), sonra kurbağa
## küçülüp onları tükürür. Gerçek model: GamaMise (actors/gama_mise.gd). Dev hedefler (bijū, dev çağrı) sığmaz.
func p_kuchiyose_gama_mise_no_jutsu(c: Node3D, t: Node3D) -> void:
	busy(c, 0.8)
	var d = fwd(c, t)
	var tt = tg(c, t, 14.0)
	var at = gp((tt.global_position if tt else c.global_position + d * 6.0) + d * 1.8)   # kapı hedefin önüne gelir
	summon_circle(c.global_position, 1.4, Color(1, 0.55, 0.15), 0.5)
	FX.smoke_puff(at + Vector3.UP * 2.5, 3.2, 28)
	var shop = GamaMise.spawn(get_tree().current_scene, at, atan2(d.x, d.z))   # kapı çağırana bakar (ön -Z)
	Sfx.play("poof", at, 0.6)
	var caught = []
	after(1.0, func():   # içeri çekilme: kapının önündeki 6 m
		if not is_instance_valid(shop):
			return
		var door = at - d * 2.0
		for e in enemies_near(c, door, 6.0):
			if not live(e) or ClanJutsu.body_scale(e) > 1.5:
				continue
			caught.append(e)
			var p0: Vector3 = e.global_position
			var tw = e.create_tween()
			tw.tween_method(func(q: float):
				if is_instance_valid(e):
					e.global_position = p0.lerp(at, q), 0.0, 1.0, 0.35)
			tw.tween_callback(func():
				if is_instance_valid(e):
					var m = e.get("model")
					if m:
						m.visible = false)
			st(e, "bind", 4.0)
		after(0.45, func():
			if is_instance_valid(shop):
				shop.morph(0.6)
				Sfx.play("poof", at, 0.9)
				if not caught.is_empty():
					Combat.popup_text(at + Vector3.UP * 4.0, "Kurbağanın midesinde!", Color(1, 0.7, 0.3))))
	every(4.5, 0.5, func(i, _k):   # mide asidi
		if i < 4:
			return
		for e in caught:
			if live(e):
				e.take_hit(inf(c, "kuchiyose_gama_mise_no_jutsu", 0.22, {"knock": 0.0, "kind": "light", "attacker": c})), Callable())
	after(5.2, func():
		if is_instance_valid(shop):
			shop.shrink(0.6)
		after(0.55, func():
			for e in caught:
				if is_instance_valid(e):
					var m = e.get("model")
					if m:
						m.visible = true
					if live(e):
						e.take_hit(inf(c, "kuchiyose_gama_mise_no_jutsu", 0.6, {"knock": 9.0, "launch": 4.0, "kind": "heavy", "dir": d, "attacker": c}))
			if is_instance_valid(shop):
				FX.smoke_puff(at + Vector3.UP, 1.2, 12)
				shop.queue_free()))


## Hızlı Başkesme: dev orak gelincik çağrılır, orağıyla dev kesici rüzgâr savurur
func p_kuchiyose_kirikiri_mai(c: Node3D, t: Node3D) -> void:
	busy(c, 1.0)
	var d = fwd(c, t)
	var side = d.cross(Vector3.UP)
	var at = gp(c.global_position + side * 2.0) + Vector3.UP * 2.0
	summon_circle(c.global_position, 1.4, WIND, 0.5)
	# kanon: dev yelpaze üçüncü aya kadar açılır, savuruşla Kamatari gelir. Elinde Temari no Ōōgi varsa o açılır;
	# yoksa (yalnız NPC — oyuncu yelpazesiz atamaz) geçici yelpaze belirir
	var m = c.get("model")
	var own = m != null and m.get("weapons") != null and (m.weapons as Array).any(func(w): return String(w["id"]) == "temari_ogi")
	if own:
		preload("res://scripts/combat/keyed_combos.gd")._ogi_stage(c, 3, 1.1)
		anim(c, "throw", 1.0)
	else:
		jutsu_weapon(c, "tessen", 1.0)
	FX.smoke_puff(at, 0.35, 5)   # küçük çağırma dumanı
	# Kamatari (anime): KÜÇÜK orak gelincik (~0,6 m; göz bandı, dev orak) yelpazenin rüzgârına binip fırıl fırıl dönerek
	# ileri uçar, orağıyla yolundaki her şeyi biçer, rüzgârla birlikte kaybolur. Model: SummonModels "weasel_trio"
	var fly = Node3D.new()   # uçuş yolu (rüzgâr yönü)
	get_tree().current_scene.add_child(fly)
	fly.global_position = at + d * 0.8
	fly.look_at(fly.global_position + d, Vector3.UP)
	var weasel: Node3D = SummonModels.build("weasel_trio", 0.55, 1.0)["root"]
	fly.add_child(weasel)
	weasel.position = Vector3(0, -0.2, 0)
	var tw = fly.create_tween()
	tw.tween_interval(0.3)
	tw.tween_property(fly, "global_position", at + d * 20.0 + Vector3.UP * 0.6, 0.65).set_ease(Tween.EASE_IN)
	tw.tween_callback(func(): FX.smoke_puff(fly.global_position, 0.4, 5))
