## Kamuibashiri (kanon adı Storm 4, Obito): Kamui geçirgenliğiyle hedefe atılır — saldırılar içinden geçer — ve kolundan
## fışkıran Mokuton dallarıyla hedefi şişler (Hashirama hücreleri).
func p_kamuibashiri(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 22.0)
	busy(c, 0.9)
	_kamui_swirl(c.global_position + Vector3.UP * 1.0, 1.0, 0.4)
	if c is Player:
		Buffs.add("kamuibashiri", 0.9, {"armor": 0.0, "_name": "Kamui Koşusu", "_desc": "saldırılar içinden geçer"})
		c.combat.invuln = maxf(c.combat.invuln, 0.6)
	var m = c.get("model")
	MsArts.ghost(m, 0.55)
	var d = fwd(c, t)
	var dest = gp(tt.global_position - (tt.global_position - c.global_position).normalized() * 1.6) if tt else gp(c.global_position + d * 12.0)
	var tw = c.create_tween()
	tw.tween_property(c, "global_position", dest, 0.45).set_trans(Tween.TRANS_SINE)
	tw.tween_callback(func():
		MsArts.ghost(m, 0.0)
		if not live(c):
			return
		if tt and live(tt):
			_face(c, tt)
		anim(c, "jab", 1.6)
		var hand = Jutsu._hand(c)
		var aim = (tt.global_position + Vector3.UP * 1.1) if tt and live(tt) else hand + c.face_dir() * 4.0
		# koldan fışkıran sivri Mokuton dalları: hedefi delip arkasına uzanır
		for k in 5:
			var dir = (aim - hand).normalized().rotated(Vector3.UP, randf_range(-0.25, 0.25))
			dir = (dir + Vector3.UP * randf_range(-0.15, 0.2)).normalized()
			var L = hand.distance_to(aim) + randf_range(1.0, 2.2)
			var pts = []
			var rr = []
			var bend = Vector3(randf_range(-1, 1), randf_range(-0.3, 0.6), randf_range(-1, 1)) * 0.25
			for j in 8:
				var u = j / 7.0
				pts.append(dir * L * u + bend * sin(u * PI))
				var w = lerpf(0.11, 0.01, u)
				rr.append(Vector2(w, w))
			var mb = MB.new()
			Loft.tube(mb, pts, rr, WOOD, 6, 2)
			mb.add("cone", dir * L * 0.55 + bend * 0.8, Vector3(0.05, 0.4, 0.05), WOOD.darkened(0.2), Vector3(randf_range(-60, 60), 0, randf_range(-60, 60)), 4)   # yan filiz
			var br = mesh_of(mb)
			get_tree().current_scene.add_child(br)
			br.global_position = hand
			br.scale = Vector3.ONE * 0.05
			var tw2 = br.create_tween()
			tw2.tween_interval(k * 0.03)
			tw2.tween_property(br, "scale", Vector3.ONE, 0.12).set_trans(Tween.TRANS_EXPO).set_ease(Tween.EASE_OUT)
			tw2.tween_interval(0.9)
			tw2.tween_property(br, "scale", Vector3.ONE * 0.05, 0.25)
			tw2.tween_callback(br.queue_free)
		VFX.debris(aim, WOOD, 10, 6.0, 0.15)
		hit(c, aim, 2.0, inf(c, "kamuibashiri", 1.8, {"knock": 10.0, "kind": "heavy", "stun": 0.6, "bleed": 3.0, "element": "mokuton"})))
	Sfx.play("wind", c.global_position, 1.8, 0.5)


## Kanzeon Renge-Ō (kanon, Tobi/Zetsu; Yamato araç): ~160 m ayakta tahta heykel çağıranın ardında yükselir (gerçek model:
## actors/kanzeon.gd). Issai Kaiku: başını çevreleyen beş küçük baş aynı anda beş doğayı salar (ateş, su, şimşek, rüzgâr, toprak);
## sonra haleden açılan kollar hedefe yağar (Chōjō Kebutsu). Heykel toprağa gömülür.
func p_kanzeon_renge_o(c: Node3D, t: Node3D) -> void:
	busy(c, 1.6)
	var tt = tg(c, t, 70.0)
	var fd = fwd(c, t)
	var goal0 = gp(tt.global_position if tt else c.global_position + fd * 35.0)
	var at = gp(c.global_position - fd * 70.0)
	var kz = Kanzeon.spawn(get_tree().current_scene, at - Vector3.UP * 170.0, atan2(-(goal0 - at).x, -(goal0 - at).z))
	for k in 8:
		_earth_burst(at + Vector3(cos(k * 0.8) * 20.0, 0, sin(k * 0.8) * 20.0), 4.0)
	shake(1.6)
	Sfx.play("earth", at, 0.35)
	var tw = kz.create_tween()
	tw.tween_property(kz, "global_position", at, 1.6).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	tw.tween_callback(func():   # Issai Kaiku: beş baş, beş doğa
		var goal = gp(tt.global_position if tt and live(tt) else goal0) + Vector3.UP * 1.0
		var kinds = ["katon", "suiton", "raiton", "fuuton", "doton"]
		for i in 5:
			var from = kz.head_world(i)
			var d = (goal - from).normalized()
			var L = from.distance_to(goal) + 6.0
			match kinds[i]:
				"katon":
					fire_stream(from, d, L, 5.0, 18)
				"suiton":
					for q in 8:
						after(q * 0.05, func(): if is_instance_valid(kz): WaterArt.spray(from + d * (q * L / 8.0), 2.2, d, 25.0, 1.0))
				"raiton":
					tether(func(): return from, func(): return goal, 0.5, VFX.mat_bolt(Color(0.6, 0.8, 1.0), 2.0), 0.9)
				"fuuton":
					WindFX.streak(func(q: float) -> Vector3: return from.lerp(goal, q), 0.6, 1.4, Color(0.92, 0.95, 1.0, 0.9), 0.0, 16)
				"doton":
					for q in 6:
						after(q * 0.07, func(): if is_instance_valid(kz): VFX.debris(from.lerp(goal, q / 5.0), Color(0.5, 0.42, 0.33), 10, 8.0, 0.8))
			after(0.5, func():
				if live(c):
					hit(c, goal, 7.0, inf(c, "kanzeon_renge_o", 0.45, {"knock": 8.0, "kind": "heavy", "element": kinds[i], "burn": 2.0 if kinds[i] == "katon" else 0.0, "stun": 0.4 if kinds[i] == "raiton" else 0.0})))
		shake(1.0))
	tw.tween_interval(1.4)
	tw.tween_callback(func():   # Chōjō Kebutsu: haleden kollar
		for k in 18:
			after(k * 0.08, func():
				if not is_instance_valid(kz):
					return
				var goal = gp(tt.global_position if tt and live(tt) else goal0)
				var q = goal + Vector3(randf_range(-7, 7), 0, randf_range(-7, 7))
				var src = kz.random_hand_world()
				var hand = MeshInstance3D.new()
				hand.mesh = ShinSusenju.arm_mesh()
				hand.material_override = Props.toon_color(Kanzeon.WOOD)
				get_tree().current_scene.add_child(hand)
				hand.global_position = src
				hand.look_at(q + Vector3(0.001, 0, 0), Vector3.UP)
				hand.rotate_object_local(Vector3.RIGHT, -PI * 0.5)
				hand.scale = Vector3.ONE * 22.0
				var tw2 = hand.create_tween()
				tw2.tween_property(hand, "global_position", q - (q - src).normalized() * 20.0, clampf(src.distance_to(q) / 260.0, 0.3, 0.7)).set_ease(Tween.EASE_IN)
				tw2.tween_callback(func():
					impact_fx("doton", EARTH, q + Vector3.UP * 0.5, 2.0)
					VFX.cracks(q, 5.0)
					hit(c, q + Vector3.UP, 4.5, inf(c, "kanzeon_renge_o", 0.3, {"knock": 10.0, "kind": "heavy"})))
				tw2.tween_interval(0.4)
				tw2.tween_property(hand, "scale", Vector3.ONE * 0.4, 0.25)
				tw2.tween_callback(hand.queue_free)))
	tw.tween_interval(2.6)
	tw.tween_property(kz, "global_position", at - Vector3.UP * 170.0, 1.6).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	tw.tween_callback(kz.queue_free)


## Sümüklüböcek Büyük Bölünmesi: dev sümüklüböcek binlerce minik parçaya ayrılıp alana yayılır — yandaşları sürekli iyileştirir
func p_katsuyu_daibunretsu(c: Node3D, _t: Node3D) -> void:
	busy(c, 1.0)
	var at = gp(c.global_position)
	summon_circle(at, 3.0, Color(0.85, 0.9, 1.0), 0.8)
	FX.smoke_puff(at + Vector3.UP * 1.5, 3.0, 30)
	var slugs = []
	for k in 24:
		# oyunun gerçek Katsuyu parçası modeli (Sümüklüböcek sözleşmesi Kuchiyose'siyle aynı: SummonModels "slug_frag")
		var s: Node3D = SummonModels.build("slug_frag", 0.4, 0.8)["root"]
		get_tree().current_scene.add_child(s)
		var a = randf() * TAU
		var r = randf_range(1.0, 9.0)
		s.global_position = at + Vector3.UP * 3.0
		s.rotation.y = a
		var tw = s.create_tween()
		tw.tween_property(s, "global_position", gp(at + Vector3(cos(a) * r, 0, sin(a) * r)), randf_range(0.4, 0.7)).set_trans(Tween.TRANS_QUAD)
		tw.tween_interval(6.0)
		tw.tween_callback(func(): FX.smoke_puff(s.global_position, 0.4, 4))
		tw.tween_callback(s.queue_free)
		slugs.append(s)
	every(6.5, 0.5, func(_i, _k):
		if live(c):
			heal(c, c.max_hp * 0.03)
			VFX.puffs(c.global_position + Vector3.UP, {"amount": 5, "life": 0.6, "size": 0.4, "radius": 0.6, "vmin": 1, "vmax": 2, "dir": Vector3.UP, "spread": 30.0, "add": true,
				"colors": [Color(0.6, 1.0, 0.7, 0.8), Color(0.3, 0.9, 0.5, 0)]})
			chakra_gain(c, 2.0), Callable())
	if c is Player:
		Buffs.add("katsuyu_bunretsu", 6.5, {"armor": 0.3, "_name": "Sümüklüböcek Bölünmesi", "_desc": "parçalar sürekli iyileştirir"})
	Sfx.play("smoke", at, 0.7)


