# ------------------------------------------------------------------ Shiranui: Hiraijin no Jutsu (Hokage Muhafız Birliği)
## Kanon (Genma, Raidō, Iwashi; Dördüncü Hokage öğretti): ÜÇ kişi gerekir — kullanıcı ve yanındaki iki müttefik halka olup
## Yüzleşme Mührü'nde parmaklarını birleştirir; halkanın içindeki herkes işaretli yere ışınlanır. İşaret köyün Kage'sinde
## (muhafızlar Hokage'yi işaretlemişti): takım Kage Kulesi'nin önüne iner. Yanında iki müttefik yoksa çalışmaz.
func p_hiraijin_no_jutsu(c: Node3D, _t: Node3D) -> void:
	var allies = []
	for f in get_tree().get_nodes_in_group("fighters"):
		if f != c and is_instance_valid(f) and f is Enemy and not f.dead and f.get("team") == c.get("team") and f.global_position.distance_to(c.global_position) < 6.0:
			allies.append(f)
	if allies.size() < 2:
		if c is Player:
			Hud.msg("Hiraijin üç kişiyle yapılır: yanında (6 m) en az iki takım arkadaşın olmalı.", Color(1, 0.75, 0.45), 5.0)
		return
	if Interiors.inst and Interiors.inst.inside != "":
		if c is Player:
			Hud.msg("Kapalı bir yerdesin: işarete ışınlanmak için dışarıda ol.", Color(1, 0.75, 0.45))
		return
	if c is Player and Orgs.is_rogue():
		Hud.msg("İşaret köyünün Kage'sinde — kaçak bir ninjaya o halka açılmaz.", Color(1, 0.6, 0.5))
		return
	var vid = Progress.home() if c is Player else String(c.get("look").get("village", "konoha") if c.get("look") is Dictionary else "konoha")
	var dest = Missions.open_ground(Exams.find_point(["mission_board"], vid), 25.0)
	var group = [c] + allies.slice(0, 5)
	busy(c, 1.0)
	anim(c, "seal", 1.0)
	# halka: herkes kullanıcıya döner, mühürde altın ışık birleşir
	for g in group:
		VFX.star(g.global_position + Vector3.UP * 1.2, Color(1.0, 0.85, 0.2), 1.4, 0.3)
	VFX.shockwave(c.global_position + Vector3.UP * 0.2, Color(1.0, 0.85, 0.25), 4.0, 0.4, false)
	Sfx.play("whoosh", c.global_position, 1.6)
	after(0.55, func():
		for i in group.size():
			var g = group[i]
			if not is_instance_valid(g):
				continue
			var a = TAU * i / group.size()
			var q = gp(dest + Vector3(cos(a), 0, sin(a)) * 2.2)
			VFX.star(g.global_position + Vector3.UP, Color(1.0, 0.9, 0.3), 3.0, 0.2)
			g.global_position = q + Vector3.UP * 0.1
			if g is CharacterBody3D:
				g.velocity = Vector3.ZERO
			if g.has_method("reset_physics_interpolation"):
				g.reset_physics_interpolation()
			if g is Enemy:
				g.home = q
				g.target = null
			if g is Player:
				g.cam_pivot.global_position = q + Vector3.UP * 1.6 * g.model.age_scale
			VFX.star(q + Vector3.UP, Color(1.0, 0.9, 0.3), 3.0, 0.25)
		VFX.shockwave(dest + Vector3.UP * 0.2, Color(1.0, 0.85, 0.25), 5.0, 0.4, false)
		if c is Player:
			Hud.msg("Hiraijin — takım %s Kulesi'nin önüne indi." % Progress.kage_title(vid), Color(1, 0.9, 0.5)))


# ================================================================== Yeni klanlar 4: Momochi (sessiz öldürme) / Kurosuki (şimşek kılıçları) / Hagoromo (tüy ve illüzyon)
const KUROS := Color(0.4, 0.85, 1.0)


# ------------------------------------------------------------------ Kurosuki: Kiba şimşek kılıçları, kara bulut
func _ks_swords(c: Node3D, dur: float) -> void:
	for side in ["RightHand", "LeftHand"]:
		var ba = bone_attach(c, side)
		if ba == null:
			continue
		var b = MB.new()
		b.add("box", Vector3(0, 0, 0.55), Vector3(0.03, 0.09, 0.95), Color(0.75, 0.8, 0.85))
		for k in 4:
			b.add("box", Vector3(0, 0.07, 0.2 + k * 0.22), Vector3(0.025, 0.06, 0.08), Color(0.75, 0.8, 0.85), Vector3(-30, 0, 0))
		b.add("cyl", Vector3(0, 0, -0.06), Vector3(0.035, 0.2, 0.035), Color(0.12, 0.12, 0.2), Vector3(90, 0, 0), 6)
		var mi = mesh_of(b)
		ba.add_child(mi)
		every(dur, 0.08, func(_i, _k):
			if is_instance_valid(mi):
				var p = mi.global_position + mi.global_transform.basis.z * randf_range(0.2, 1.0)
				VFX.bolt(p, p + Vector3(randf_range(-0.4, 0.4), randf_range(-0.4, 0.4), randf_range(-0.4, 0.4)), KUROS, 0.04, 0.08, 0), Callable())
		get_tree().create_timer(dur).timeout.connect(func():
			if is_instance_valid(mi):
				mi.queue_free())


func _ks_cloud(at: Vector3, r: float, dur: float) -> void:
	VFX.puffs(at, {"amount": 35, "life": dur, "size": 1.8, "radius": r, "vmin": 0.05, "vmax": 0.3, "dir": Vector3.UP, "spread": 40.0, "add": false,
		"colors": [Color(0.1, 0.1, 0.14, 0.75), Color(0.12, 0.12, 0.16, 0.6), Color(0.1, 0.1, 0.12, 0)]})


## Ikazuchi no Kiba (anime, Raiga Kurosuki): iki Kiba kılıcı birleşir, kılıçlardan buluta elektrik akar ve istenen yere
## (hedefin çevresine) yıldırımlar iner. Kiba ile öğrenilir (weapon:kiba); kılıç elde değilse (NPC) geçici ikiz kılıç çıkar
func p_kurosuki_ikazuchi_kiba(c: Node3D, t: Node3D) -> void:
	busy(c, 0.8)
	if _held_or(c, "") != "kiba":
		_ks_swords(c, 0.9)
	var tt = tg(c, t, 24.0)
	var at = gp(tt.global_position if tt else c.global_position + fwd(c, t) * 9.0)
	VFX.bolt(c.global_position + Vector3.UP * 2.0, c.global_position + Vector3.UP * 14.0, KUROS, 0.4, 0.25, 2)   # kılıçlardan göğe akış
	_ks_cloud(at + Vector3.UP * 12.0, 4.0, 2.0)
	for k in 5:
		after(0.35 + k * 0.12, func():
			var p = at + Vector3(randf_range(-2.5, 2.5), 0, randf_range(-2.5, 2.5))
			VFX.bolt(p + Vector3.UP * 12.0, p, KUROS, 0.5, 0.3, 3)
			impact_fx("raiton", KUROS, p + Vector3.UP * 0.4, 0.9)
			hit(c, p + Vector3.UP, 2.0, inf(c, "kurosuki_ikazuchi_kiba", 0.55, {"knock": 4.0, "kind": "heavy", "element": "raiton", "stun": 0.3})))
	Sfx.play("thunder", at, 1.0)


# ================================================================== VİDEO FŪTON: eksik rüzgâr teknikleri (anime derlemesine göre)
# Hepsi organik rüzgâr (WindFX): perde + akım çizgisi + az toz; görünür geometrik kabuk yok.

## Rüzgârın içine alınan düşmanı döndürerek göğe kaldırıp bırakır
func _wind_lift(c: Node3D, e: Node3D, h: float, dur: float) -> void:
	if not live(e):
		return
	var base = e.global_position
	var a0 = randf() * TAU
	every(dur, 1.0 / 30.0, func(_i, k):
		if live(e):
			var r = 1.2 * (1.0 - k)
			e.global_position = base + Vector3(cos(a0 + k * 9.0) * r, sin(k * PI) * h, sin(a0 + k * 9.0) * r)
			if e.has_method("apply_status"):
				e.apply_status("stun", 0.1), Callable())


## Jūha Reppūshō: iki avuçtan art arda mavi hilal rüzgâr dalgaları
func p_juha_reppusho(c: Node3D, t: Node3D) -> void:
	busy(c, 0.8)
	var d = fwd(c, t)
	var side = d.cross(Vector3.UP).normalized()
	var blue = Color(0.55, 0.78, 1.0)
	for k in 3:
		after(0.18 + k * 0.14, func():
			if not live(c):
				return
			var o = c.global_position + Vector3.UP * 1.1 + d * 0.8
			var sgn = 1.0 if k % 2 == 0 else -1.0
			# hilal: yandan yana kavis çizerek ileri giden geniş perde
			for i in 3:
				var off = (i - 1) * 0.35
				WindFX.sheet(func(q: float) -> Vector3:
					var w = lerpf(0.6, 4.5, q)
					return o + d * q * 18.0 + side * sgn * sin(q * PI) * w * 0.6 + side * off + Vector3.UP * off * 0.5, 0.42, 1.8 + i * 0.4, blue.darkened(0.1), i * 0.02, 0.9)
			WindFX.gust(o, d, 18.0, 5.0, {"n": 6, "speed": 44.0, "tint": blue, "col": Color(0.85, 0.94, 1.0, 0.9), "sheets": 0, "leaves": false})
			Combat.hit_zone(c, c.global_position, d, 18.0, 25.0, 3.0, inf(c, "juha_reppusho", 0.55, {"knock": 9.0, "launch": 3.0, "kind": "heavy", "element": "fuuton", "bleed": 2.0, "dir": d})))
	shake(0.4)
	Sfx.play("wind", c.global_position, 1.3)


## Kakeami: ileri atılan görünmez rüzgâr ağı — yakalananlar sıkışıp kalır
func _wind_net(c: Node3D, at: Vector3, r: float, hold: float, id: String, from_sky := false) -> void:
	var g = gp(at)
	# ağ iplikleri: merkeze doğru daralan, birbirini kesen ince akım çizgileri
	for i in 14:
		var a = TAU * i / 14.0
		var p0 = g + Vector3(cos(a), 0, sin(a)) * r + Vector3.UP * (12.0 if from_sky else 1.5)
		var p1 = g + Vector3(cos(a + PI * 0.8), 0, sin(a + PI * 0.8)) * r * 0.9 + Vector3.UP * 0.6
		WindFX.streak(func(q: float) -> Vector3: return p0.lerp(p1, q) + Vector3.UP * sin(q * PI) * 1.2, 0.35, 0.06, Color(0.92, 1.0, 0.96, 0.9), i * 0.015, 16)
	after(0.3, func():
		WindFX.swirl(g, r * 0.8, 1.6, hold, 8, WindFX.LINE, false)
		for e in enemies_near(c, g, r):
			if live(e) and e.has_method("apply_status"):
				e.apply_status("bind", hold)
				hit(c, e.global_position + Vector3.UP, e.radius + 0.4, inf(c, id, 0.6, {"knock": 0.0, "kind": "light", "element": "fuuton"}))
		every(hold, 0.4, func(_i, _k):
			for e in enemies_near(c, g, r):
				if live(e):
					hit(c, e.global_position + Vector3.UP, e.radius + 0.3, inf(c, id, 0.15, {"knock": 0.0, "kind": "light", "element": "fuuton"})), Callable()))


func p_futon_kakeami(c: Node3D, t: Node3D) -> void:
	busy(c, 0.7)
	var tt = tg(c, t, 22.0)
	var at = tt.global_position if tt else c.global_position + fwd(c, t) * 10.0
	WindFX.gust(c.global_position + Vector3.UP * 1.2, (at - c.global_position).normalized(), c.global_position.distance_to(at), 4.0, {"n": 8, "speed": 36.0, "dust": false, "leaves": false})
	after(0.25, func(): _wind_net(c, at, 4.0, 2.0, "futon_kakeami"))
	Sfx.play("wind", c.global_position, 1.1)


func p_futon_okakeami(c: Node3D, t: Node3D) -> void:
