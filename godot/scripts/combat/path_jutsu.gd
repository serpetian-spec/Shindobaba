## Kanon (Sekiz Kapı): teknik, gerekli kapı açıkken yapılır. Kapıları Hachimon Tonkō açar; bedeli (can) açık kapılar zamanla öder.
const GATE_REQ := {"omote_renge": 1, "ura_renge": 3, "asakujaku": 6, "hirudora": 7, "sekizo": 8, "yagai": 8}
const GATE_NAMES := ["", "Açılış", "Dinlenme", "Yaşam", "Acı", "Sınır", "Görüş", "Hayret", "Ölüm"]


static func gate_level(c: Node) -> int:
	if c == null or not is_instance_valid(c) or not c.has_meta("gates"):
		return 0
	if Game.now() > float(c.get_meta("gates_until", 0.0)):
		return 0
	return int(c.get_meta("gates"))


## Teknik atılabilir mi (oyuncu + düşman aynı şart). Omote Renge 1. kapıyı kendisi zorla açar (kanon: Lee'nin ilk Lotus'u).
static func gate_ok(c: Node, jid: String) -> bool:
	var need = int(GATE_REQ.get(jid, 0))
	return need <= 1 or gate_level(c) >= need


func _gate_cost(c: Node3D, frac: float) -> void:
	# kapı zaten açıksa teknik ayrıca can yakmaz (bedel açık kapıların akışı); kapalıyken (yalnız Omote Renge) 1. kapı zorla açılır
	if gate_level(c) < 1:
		if c is Player:
			c.hp = maxf(1.0, c.hp - c.max_hp * frac)
		c.set_meta("gates", 1)
		c.set_meta("gates_until", Game.now() + 8.0)
	FX.aura(c, GATE_GREEN, 1.0, Vector3(0, 0.9, 0), 0.8)


## Ön Lotus: hedefe atıl, çeneden yukarı tekmele, havada sargıyla sar ve başaşağı yere çak
func p_omote_renge(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 12.0)
	_gate_cost(c, 0.05)
	busy(c, 1.4)
	if tt == null:
		anim(c, "hook", 1.5)
		return
	c.global_position = gp(tt.global_position - fwd(c, tt) * 1.0)
	anim(c, "hook", 1.8)
	Sfx.play("hit_heavy", c.global_position, 1.1)
	tt.take_hit(inf(c, "omote_renge", 0.3, {"launch": 14.0, "knock": 0.0, "kind": "heavy"}))
	# anime: Kage Buyō — havadaki hedefin arkasında belirir; kol sargısı hedefin bedenine sarmal dolanır,
	# sıkıca kavrayıp ikisi birlikte matkap gibi dönerek başaşağı yere iner
	after(0.3, func():
		if not (live(tt) and live(c)):
			return
		c.global_position = tt.global_position - fwd(c, tt) * 0.6 + Vector3.DOWN * 0.3   # gölge gibi arkasında
		anim(c, "air", 1.4)
		_trail_ghost(c, 0.4, 0.3))
	after(0.45, func():
		if not live(tt):
			return
		var coil = Node3D.new()
		var b = MB.new()
		var N = 90
		var hgt: float = float(tt.get("height")) if tt.get("height") != null else 1.8
		for i in N:   # sargı bandı: bedeni 5 tur saran kesintisiz yassı şerit (dilimler üst üste biner)
			var a0 = TAU * 5.0 * i / N
			var p0 = Vector3(cos(a0) * 0.3, -0.45 + hgt * 0.62 * i / N, sin(a0) * 0.3)
			b.add("box", p0, Vector3(0.14, 0.1, 0.012), Color(0.95, 0.94, 0.9).darkened(0.04 * ((i / 9) % 2)), Vector3(0, -rad_to_deg(a0) - 90.0, 10))
		var mi = mesh_of(b)
		coil.add_child(mi)
		var hip = bone_attach(tt, "Hips")   # bedene bağlı: düşerken/dönerken bedenle birlikte
		if hip:
			hip.add_child(coil)
		else:
			tt.add_child(coil)
			coil.position = Vector3.UP * 0.9
		mi.scale = Vector3(1.0, 0.05, 1.0)
		mi.create_tween().tween_property(mi, "scale", Vector3.ONE, 0.18)
		after(1.0, func():
			if is_instance_valid(coil):
				coil.queue_free()
			if hip and is_instance_valid(hip):
				hip.queue_free())
		var band = StandardMaterial3D.new()
		band.albedo_color = Color(0.95, 0.94, 0.9)
		tether(func(): return c.global_position + Vector3.UP * 1.1, func(): return tt.global_position + Vector3.UP * hgt * 0.6, 0.08, band, 0.5)
		# dönerek dalış: hedef üstte değil — ikisi birlikte yere doğru, başaşağı, hızla dönerek
		var top = tt.global_position
		var ground = gp(top)
		var t0 = Game.now()
		every(0.5, 1.0 / 60.0, func(_i, _k):
			if not (live(tt) and live(c)):
				return
			var u = clampf((Game.now() - t0) / 0.5, 0.0, 1.0)
			var y = lerpf(top.y, ground.y + 0.3, u * u)
			tt.global_position = Vector3(top.x, y, top.z)
			c.global_position = tt.global_position + Vector3.UP * 1.0
			var spin = u * 22.0
			for n in [c, tt]:
				var md = n.get("model")
				if md:
					md.rotation.y += 0.55
					md.rotation.x = PI * 0.85 * minf(1.0, u * 3.0)   # başaşağı
			if _i % 3 == 0:
				WindFX.swirl(tt.global_position + Vector3.UP * 0.5, 1.0, 2.4, 0.25, 6, Color(0.85, 1.0, 0.85, 0.8), false), func():
			for n in [c, tt]:
				if is_instance_valid(n):
					var md = n.get("model")
					if md:
						md.rotation.x = 0.0))
	after(0.95, func():
		if not live(c):
			return
		var p = gp(c.global_position)
		c.global_position = p
		if live(tt):
			tt.global_position = p
		melee_fx(c, p + Vector3.UP * 0.5, GATE_GREEN, 1.8, true)
		VFX.cracks(p, 6.0)
		VFX.shockwave(p + Vector3.UP * 0.1, Color(0.7, 0.65, 0.55), 8.0, 0.4, true)
		shake(0.9)
		Sfx.play("boom", p, 0.8)
		hit(c, p + Vector3.UP * 0.6, 3.0, inf(c, "omote_renge", 1.4, {"knock": 8.0, "kind": "heavy"})))


## Arka Lotus: üçüncü kapı; hedefi havaya savurup arkasından görünerek 6 hızlı vuruş, son yumrukla yere çakar
func p_ura_renge(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 14.0)
	_gate_cost(c, 0.1)
	busy(c, 1.8)
	if tt == null:
		return
	c.global_position = gp(tt.global_position - fwd(c, tt) * 1.0)
	tt.take_hit(inf(c, "ura_renge", 0.2, {"launch": 16.0, "knock": 0.0, "kind": "heavy"}))
	for k in 6:
		after(0.25 + k * 0.13, func():
			if not live(tt) or not live(c):
				return
			var side = Vector3(cos(k * 2.1), 0.4, sin(k * 2.1)) * 1.2
			c.global_position = tt.global_position + side
			anim(c, ["jab", "cross", "hook"][k % 3], 2.2)
			melee_fx(c, tt.global_position + Vector3.UP * 0.8, Color(1, 0.4, 0.3), 1.0)
			Sfx.play("punch", tt.global_position, 1.2 + k * 0.05)
			tt.take_hit(inf(c, "ura_renge", 0.22, {"knock": 0.0, "launch": 2.0, "kind": "light", "hitstop": 0.03})))
	after(1.15, func():
		if not live(c):
			return
		var p = gp(tt.global_position if live(tt) else c.global_position)
		c.global_position = p + Vector3.UP * 0.2
		if live(tt):
			tt.global_position = p
		anim(c, "cross", 1.4)
		melee_fx(c, p + Vector3.UP * 0.5, Color(1, 0.4, 0.3), 2.2, true)
		VFX.cracks(p, 9.0, Color(0.1, 0.07, 0.05, 0.95), 8.0)
		for r in [5.0, 9.0, 13.0]:
			VFX.shockwave(p + Vector3.UP * 0.1, Color(0.7, 0.65, 0.55), r, 0.5, true)
		VFX.debris(p, EARTH, 40, 12.0, 0.6)
		shake(1.3)
		Sfx.play("boom", p, 0.6)
		hit(c, p + Vector3.UP * 0.6, 4.0, inf(c, "ura_renge", 1.8, {"knock": 12.0, "kind": "heavy"}), [tt] if live(tt) else [])
		if live(tt):   # hedefe kilitli: yere çakılan hedef kaymış olsa da son darbe onu bulur
			tt.take_hit(inf(c, "ura_renge", 1.8, {"knock": 12.0, "kind": "heavy"})))


## Kapı yükseltme anı: buhar patlaması, zemin çatlağı; 8. kapı (Ölüm) kızıl buhar ve sonunda beden tükenir
func _gate_burst(c: Node3D, g: int) -> void:
	var col = Color(1.0, 0.25, 0.18) if g >= 8 else (Color(0.95, 0.55, 0.3) if g >= 6 else GATE_GREEN)
	shake(0.5 + g * 0.08)
	VFX.shockwave(c.global_position + Vector3.UP * 1.0, col, 6.0 + g * 1.5, 0.5, false)
	VFX.cracks(gp(c.global_position), 3.0 + g * 0.6)
	FX.aura(c, col, 1.3 + g * 0.1, Vector3(0, 0.9, 0), 1.2)
	Sfx.play("roar", c.global_position, 1.0, 0.5)
	Combat.popup_text(c.global_position + Vector3.UP * 2.6, "%d. Kapı: %s Kapısı açıldı!" % [g, GATE_NAMES[g]], col)
	if g >= 8:
		var until = float(c.get_meta("gates_until", 0.0))
		after(maxf(0.5, until - Game.now()), func():
			if live(c):   # Ölüm Kapısı kapanınca beden tükenir (kanon: kullanıcı ölür; oyunda can 1, uzun yavaşlık)
				c.hp = 1.0
				st(c, "slow", 15.0)
				Combat.popup_text(c.global_position + Vector3.UP * 2.4, "Ölüm Kapısı'nın bedeli: beden tükendi", Color(1, 0.4, 0.35)))


## Sekiz Kapı Açılışı: yeşil buhar fışkırır, ten kızarır; 25 sn büyük güç ve hız, can yavaşça erir
func p_hachimon_tonko_no_jin(c: Node3D, _t: Node3D) -> void:
	# kanon: kapılar sırayla açılır. İlk açılış Yaşam Kapısı'na (3) kadar; açıkken tekrar: 6. (Görüş), 7. (Hayret), 8. (Ölüm)
	var cur = gate_level(c)
	var nxt = 3 if cur < 3 else (6 if cur < 6 else (7 if cur < 7 else 8))
	if cur >= 8:
		return
	if cur > 0:   # kapı yükseltme: kısa bekleme, aynı akış devam eder
		c.set_meta("gates", nxt)
		c.set_meta("gates_until", maxf(float(c.get_meta("gates_until", 0.0)), Game.now() + (14.0 if nxt == 8 else 10.0)))
		_gate_burst(c, nxt)
		if c is Player:
			c.combat.cooldowns["hachimon_tonko_no_jin"] = 1.5
		elif c.get("jcd") is Dictionary:
			c.jcd["hachimon_tonko_no_jin"] = Game.now() + 1.5
		return
	c.set_meta("gates", nxt)
	c.set_meta("gates_until", Game.now() + 25.0)
	if c is Player:
		Combat.popup_text(c.global_position + Vector3.UP * 2.6, "%d. Kapı: %s Kapısı açıldı!" % [nxt, GATE_NAMES[nxt]], GATE_GREEN)
	busy(c, 0.8)
	anim(c, "cast", 1.0)
	shake(0.8)
	Sfx.play("roar", c.global_position, 1.2, 0.6)
	FX.ring(c.global_position + Vector3.UP * 0.2, GATE_GREEN, 10.0, 0.5)
	VFX.shockwave(c.global_position + Vector3.UP * 1.0, GATE_GREEN, 12.0, 0.6, false)
	VFX.cracks(gp(c.global_position), 6.0)
	VFX.debris(gp(c.global_position), EARTH, 24, 10.0, 0.5)
	if c is Player:
		VFX.screen_lines(0.5, 1.0, GATE_GREEN)
	var a = FX.aura(c, GATE_GREEN, 1.6, Vector3(0, 0.9, 0), 0.0)
	var m = c.get("model")
	var skin_mats = []
	if m:
		var ratio: Color = m._skin_ratio()
		for sm in m.materials:
			if sm is ShaderMaterial and sm.get_shader_parameter("tint") == ratio:
				skin_mats.append(sm)
				sm.set_shader_parameter("tint", ratio * Color(1.15, 0.78, 0.72))   # kapılar açıkken ten kızarır
	if c is Player:
		Buffs.add("hachimon", 25.0, {"melee": 1.55, "speed": 1.25, "_name": "Sekiz Kapı Açık", "_desc": "her sn canın %1.5'i erir"})
	every(25.0, 0.4, func(_i, _k):
		if live(c):
			var gl = gate_level(c)
			if gl == 0:
				return
			# açık kapı başına can akışı (8. kapı: ölüm kapısı, hızla yakar)
			var drain = 0.0015 * gl + (0.01 if gl >= 8 else 0.0)
			c.hp = maxf(1.0, c.hp - c.max_hp * drain)
			FX.burst(c.global_position + Vector3.UP * 1.1, {"amount": 4, "life": 0.9, "tex": FX.tex_soft, "add": true, "size": 0.35, "radius": 0.35,
				"vmin": 1, "vmax": 2.5, "dir": Vector3.UP, "spread": 20.0, "colors": [Color(0.75, 1, 0.75, 0.0), Color(0.75, 1, 0.75, 0.3), Color(0.6, 0.9, 0.6, 0)]}), func():
		if is_instance_valid(a):
			a.emitting = false
		if m and is_instance_valid(m):
			for sm in skin_mats:
				sm.set_shader_parameter("tint", m._skin_ratio()))


## Sabah Tavuskuşu: altıncı kapı; sürtünmeden alev alan yumruklar tavuskuşu kuyruğu gibi yelpazelenir
func p_asakujaku(c: Node3D, t: Node3D) -> void:
	# anime (refs/kapi/asakujaku.png): önce kullanıcının ARKASINDA tavuskuşu kuyruğu gibi yarım daire açan alevli yumruk
	# yelpazesi belirir; sonra yumruklar o yelpazeden hedefe yağar. Duman yok: alev topları + kıvılcım + ışık.
	_gate_cost(c, 0.12)
	busy(c, 1.6)
	var d = fwd(c, t)
	var right = d.cross(Vector3.UP).normalized()
	var tt = tg(c, t, 18.0)
	var aim_at = (tt.global_position + Vector3.UP * 1.0) if tt else c.global_position + d * 12.0 + Vector3.UP
	var fans: Array = []
	for k in 22:
		var a = lerpf(-1.35, 1.35, k / 21.0)   # yarım daire
		var r = 2.2 + (k % 3) * 0.6
		var off = (right * sin(a) + Vector3.UP * cos(a)) * r - d * 0.6
		fans.append(off)
	for k in fans.size():
		after(0.015 * k, func():
			if not live(c):
				return
			var q = c.global_position + Vector3.UP * 1.3 + fans[k]
			var fb = VFX.fireball(0.5 + randf() * 0.2)
			get_tree().current_scene.add_child(fb)
			fb.global_position = q
			fb.scale = Vector3.ONE * 0.1
			var tw = fb.create_tween()
			tw.tween_property(fb, "scale", Vector3.ONE, 0.12)
			tw.tween_interval(0.5 - k * 0.012)
			tw.tween_callback(fb.queue_free)
			FX.light(q, Color(1.0, 0.55, 0.15), 3.0, 5.0, 0.3))
	FX.light(c.global_position + Vector3.UP * 1.5, Color(1.0, 0.6, 0.2), 8.0, 14.0, 1.2)
	for k in fans.size():
		after(0.55 + k * 0.035, func():
			if not live(c):
				return
			anim(c, "jab" if k % 2 == 0 else "cross", 2.8)
			var from = c.global_position + Vector3.UP * 1.3 + (fans[k] as Vector3) * 0.6
			# her yumruk atıldığı an hedefin ŞİMDİKİ yerine + kaçış yönüne nişan alır (başta bir kez alınan nişan kaçanı ıskalıyordu)
			var aim_now = aim_at
			if live(tt):
				var tv: Vector3 = tt.velocity if "velocity" in tt else Vector3.ZERO
				aim_now = tt.global_position + Vector3.UP * 1.0 + Vector3(tv.x, 0, tv.z) * (from.distance_to(tt.global_position) / 44.0)
			var target = aim_now + right * randf_range(-0.9, 0.9) + Vector3.UP * randf_range(-0.5, 0.8)
			var pr = shot(c, from, (target - from).normalized(), 44.0, VFX.fireball(0.55), inf(c, "asakujaku", 0.16, {"element": "katon", "burn": 1.5, "knock": 2.0, "kind": "light"}), null, false, 0.6, func(hp, _h):
				FX.burst(hp, {"amount": 14, "life": 0.3, "tex": FX.tex_spark, "size": 0.35, "radius": 0.3, "vmin": 4.0, "vmax": 9.0, "spread": 180.0,
					"colors": [Color(1, 0.95, 0.6, 1), Color(1, 0.5, 0.1, 0.8), Color(1, 0.3, 0.05, 0)]})
				FX.light(hp, Color(1.0, 0.55, 0.15), 4.0, 6.0, 0.2))
			VFX.trail(pr, 0.4, Color(1, 0.95, 0.6), Color(1, 0.55, 0.15), Color(0.9, 0.25, 0.05), 10, 0.8)
			if k % 4 == 0:
				Sfx.play("fire", from, 1.4, 0.4))
	FX.speed_lines(c.global_position + Vector3.UP, d)


## Gündüz Kaplanı: yedinci kapı; avuç ileri, kaplan başı biçiminde dev hava basıncı topu (her şeyi savurur)
func p_hirudora(c: Node3D, t: Node3D) -> void:
	# anime (refs/kapi/hirudora.png): avuç ileri, sıkışmış havadan KAPLAN BAŞI — açık çene, dişler, kulaklar, parlayan gözler;
	# arkasında akan hava yelesi. Gövde yarı saydam hava (mat_wind), çevresinde savrulan moloz.
	_gate_cost(c, 0.15)
	busy(c, 1.1)
	anim(c, "push", 1.0)
	var d = fwd(c, t)
	after(0.35, func():
		if not live(c):
			return
		var from = c.global_position + Vector3.UP * 1.4 + d * 1.6
		var node = _tiger_head(1.4)
		VFX.gather(from, Color(0.7, 0.85, 1.0), 2.0)
		var pr = shot(c, from, d, 24.0, node, inf(c, "hirudora", 2.2, {"knock": 22.0, "launch": 6.0, "kind": "heavy", "hitstop": 0.1}), tg(c, t, 30.0), true, 1.5)
		pr.radius = 3.6   # kanon: göl dalgasını yaran dev hava basıncı — dar mermi değil
		node.scale = Vector3.ONE * 0.2
		node.create_tween().tween_property(node, "scale", Vector3.ONE, 0.25).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		WindFX.bullet(pr, 3.0)   # yele: arkaya akan hava çizgileri
		every(1.5, 0.15, func(_i, _k):
			if is_instance_valid(pr):
				VFX.shockwave(pr.global_position, Color(0.75, 0.9, 1.0), 5.0, 0.25, false, d)
				VFX.debris(gp(pr.global_position), EARTH, 4, 8.0, 0.3), Callable())
		shake(1.0)
		Sfx.play("wind", from, 0.5)
		Sfx.play("roar", from, 1.3, 0.6))


## Hirudora kaplan başı (-Z ileri): kafatası + burun + açık alt çene + dişler + kulaklar (hava malzemesi), parlak gözler
func _tiger_head(s: float) -> Node3D:
	var root = Node3D.new()
	var airm = VFX.mat_wind(Color(0.92, 0.97, 1.0), 9.0, 7.0, Vector3(0, 0, 1), 1.0)   # opak-beyaz hava (kaplan biçimi okunsun)
	var b = MB.new()
	var wc = Color(1, 1, 1)
	Loft.blob(b, Vector3(0, 0.2, 0.4) * s, Vector3(0, 0, -1), 3.2 * s, [0.9 * s, 1.55 * s, 1.7 * s, 1.5 * s, 1.0 * s], wc, 18)   # kafatası
	Loft.blob(b, Vector3(0, -0.05, -1.6) * s, Vector3(0, -0.1, -1).normalized(), 2.0 * s, [1.0 * s, 1.05 * s, 0.85 * s, 0.4 * s], wc, 16)   # burun / üst çene
	Loft.blob(b, Vector3(0, -1.05, -1.0) * s, Vector3(0, -0.45, -1).normalized(), 2.2 * s, [0.75 * s, 0.85 * s, 0.7 * s, 0.3 * s], wc, 14)   # açık alt çene
	for sx in [-1.0, 1.0]:
		b.add("cone", Vector3(0.9 * sx, 1.45, 0.6) * s, Vector3(0.9, 1.1, 0.6) * s, wc, Vector3(0, 0, -sx * 18.0), 8)   # kulak
		b.add("sphere", Vector3(0.75 * sx, 0.75, -1.05) * s, Vector3(0.75, 0.35, 0.5) * s, wc, Vector3(0, 0, sx * 12.0), 10)   # kaş çıkıntısı
		for f in 2:   # üst köpek dişi + alt diş
			b.add("cone", Vector3(0.5 * sx, -0.55 - f * 0.05, -2.45 + f * 0.6) * s, Vector3(0.22, 0.7, 0.22) * s, wc, Vector3(180, 0, 0), 6)
			b.add("cone", Vector3(0.42 * sx, -1.3, -2.2 + f * 0.5) * s, Vector3(0.2, 0.55, 0.2) * s, wc, Vector3.ZERO, 6)
	var mi = MeshInstance3D.new()
	mi.mesh = b.build(airm)
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	root.add_child(mi)
	# parlak gözler (sarı-beyaz) + içte girdap
	for sx in [-1.0, 1.0]:
		var e = Projectile.energy_mesh(Color(1.0, 0.9, 0.45), Color(1, 1, 1), 0.42 * s, 10.0, 0.0, 2.2)
		e.position = Vector3(0.72 * sx, 0.6, -1.45) * s
		root.add_child(e)
	var maw = MeshInstance3D.new()   # açık çenenin içi: koyu mavi boşluk
	maw.mesh = VFX._sphere(0.75 * s, 12, 8)
	maw.scale = Vector3(1.0, 0.55, 1.3)
	var mm = StandardMaterial3D.new()
	mm.albedo_color = Color(0.18, 0.28, 0.5, 0.85)
	mm.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mm.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	maw.material_override = mm
	maw.position = Vector3(0, -0.6, -1.9) * s
	root.add_child(maw)
	var inner = MeshInstance3D.new()
	inner.mesh = VFX._sphere(1.2 * s, 16, 8)
	inner.material_override = VFX.mat_spiral(Color(1, 1, 1), Color(0.45, 0.65, 1.0), 4.0, 2.5, 9.0, 1.2, Vector3(0, 0, 1))
	inner.position = Vector3(0, 0, 0.2) * s
	root.add_child(inner)
	return root


## Akşam Fili: sekizinci kapı; beş ardışık süpersonik yumruk, her biri öne uzanan hava şoku
func p_sekizo(c: Node3D, t: Node3D) -> void:
	# anime (refs/kapi/sekizo.png): her yumruk öne uzanan DEV beyaz hava basıncı sütunu atar; beş sütun çaprazlanarak
	# (sağ-sol, yukarı-aşağı) hedefin üstünde X çizer. Sütun: uzun sivrilen hava silindiri, hızla belirir ve incelerek söner.
	_gate_cost(c, 0.2)
	busy(c, 2.0)
	var d = fwd(c, t)
	var right = d.cross(Vector3.UP).normalized()
	for k in 5:
		after(0.2 + k * 0.3, func():
			if not live(c):
				return
			anim(c, "cross" if k % 2 == 0 else "jab", 2.0)
			var o = c.global_position + Vector3.UP * 1.3 + d * 0.8
			var yaw = [-11.0, 11.0, -5.0, 6.0, 0.0][k]
			var pitch = [5.0, -4.0, -7.0, 6.0, 0.0][k]
			var dd = d.rotated(Vector3.UP, deg_to_rad(yaw)).rotated(right, deg_to_rad(pitch)).normalized()
			var L = 34.0 + k * 2.0
			var col = MeshInstance3D.new()
			var cm = CylinderMesh.new()
			cm.top_radius = 0.7
			cm.bottom_radius = 2.0
			cm.height = L
			cm.radial_segments = 18
			col.mesh = cm
			var wm = VFX.mat_wind(Color(0.95, 0.98, 1.0), 14.0, 6.0, Vector3(0, 1, 0), 0.9)
			col.material_override = wm
			col.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			get_tree().current_scene.add_child(col)
			# silindir ekseni (+Y) sütun yönüne; dip yumrukta, uç ileride
			var bas = Basis(dd.cross(Vector3.UP).normalized(), 0.0)
			var yax = -dd
			var xax = yax.cross(Vector3.UP).normalized()
			if xax.length() < 0.1:
				xax = Vector3.RIGHT
			var zax = xax.cross(yax).normalized()
			col.global_transform = Transform3D(Basis(xax, yax, zax), o + dd * L * 0.5)
			col.scale = Vector3(0.2, 1.0, 0.2)
			var tw = col.create_tween()
			tw.tween_property(col, "scale", Vector3(1.0, 1.0, 1.0), 0.08)
			tw.tween_interval(0.25)
			tw.tween_property(col, "scale", Vector3(0.05, 1.0, 0.05), 0.5).set_ease(Tween.EASE_IN)
			tw.parallel().tween_method(func(v: float): wm.set_shader_parameter("alpha", v), 0.9, 0.0, 0.5)
			tw.tween_callback(col.queue_free)
			VFX.star(o, Color(1, 1, 1), 2.2)
			VFX.shockwave(o, Color(1, 1, 1), 6.0, 0.25, false, dd)
			VFX.debris(gp(o + dd * 8.0), EARTH, 10, 10.0, 0.4)
			shake(0.6 + k * 0.12)
			Sfx.play("boom", o, 1.2 - k * 0.08, 0.6)
			Combat.hit_zone(c, c.global_position + Vector3.UP * 0.4, dd, L, 10.0, 5.0, inf(c, "sekizo", 0.75, {"knock": 16.0, "launch": 3.0, "kind": "heavy", "hitstop": 0.05})))


## Gece Gayı: sekizinci kapının son tekmesi; kızıl ejderha biçimli buhar, uzayı büken tek hamlede hedefin içinden geç.
## Bedeli: canın %10'a iner, 12 sn bitkin (yavaş)
func p_yagai(c: Node3D, t: Node3D) -> void:
	# anime (refs/kapi/yagai.png): kızıl buhar EJDERHA biçimini alır (sarı parlayan gözler, boynuzlar, dişli ağız), kullanıcı
	# uzayı büken tek tekmeyle hedefin içinden geçer; yol boyunca kıvrılan ejderha gövdesi, havaya kalkan kayalar. Duman yok.
	var tt = tg(c, t, 30.0)
	busy(c, 1.8)
	anim(c, "crouch", 0.8)
	var steam = FX.chakra_aura(c, Color(1.0, 0.22, 0.16), 1.2, Color(1.0, 0.62, 0.52))
	Sfx.play("roar", c.global_position, 0.6)
	shake(1.0)
	after(0.9, func():
		if not live(c):
			return
		var d = fwd(c, tt)
		var start = c.global_position
		var dist = 26.0 if tt == null else c.global_position.distance_to(tt.global_position) + 6.0
		var end = gp(start + d * dist)
		var side = d.cross(Vector3.UP).normalized()
		# ejderha gövdesi: başlangıçtan bitişe kıvrılan kızıl hava tüpü, başı hedefin ötesinde
		var pts: Array = []
		var rads: Array = []
		for k in 12:
			var f = k / 11.0
			pts.append(start.lerp(end, f) + Vector3.UP * (1.4 + sin(f * 7.0) * 1.2 + f * 1.5) + side * sin(f * 5.5) * 2.2)
			rads.append(lerpf(0.4, 1.6, f))
		var b = MB.new()
		Loft.tube(b, pts, rads, Color(1, 1, 1), 14, 3, false, false)
		var head = pts[-1]
		var hd = (pts[-1] - pts[-2]).normalized()
		Loft.blob(b, head + hd * 0.6, hd, 3.6, [1.6, 1.8, 1.4, 0.8], Color(1, 1, 1), 14)   # baş
		var hs = hd.cross(Vector3.UP).normalized()
		for sx in [-1.0, 1.0]:
			b.add("cone", head + Vector3.UP * 1.6 + hs * sx * 0.9 - hd * 0.6, Vector3(0.4, 2.2, 0.4), Color(1, 1, 1), Vector3(-30, 0, sx * 25), 6)   # boynuz
		var rm = VFX.mat_wind(Color(1.0, 0.32, 0.24), 10.0, 6.0, Vector3(0, 1, 0), 0.8)
		var mi = MeshInstance3D.new()
		mi.mesh = b.build(rm)
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		get_tree().current_scene.add_child(mi)
		for sx in [-1.0, 1.0]:   # sarı parlayan gözler
			var e = Projectile.energy_mesh(Color(1.0, 0.85, 0.3), Color(1, 1, 0.8), 0.32, 10.0, 0.0, 1.8)
			get_tree().current_scene.add_child(e)
			e.global_position = head + hd * 1.6 + Vector3.UP * 0.7 + hs * sx * 0.7
			e.create_tween().tween_interval(1.1)
			get_tree().create_timer(1.3).timeout.connect(e.queue_free)
		var tw = mi.create_tween()
		tw.tween_interval(0.8)
		tw.tween_method(func(v: float): rm.set_shader_parameter("alpha", v), 0.8, 0.0, 0.6)
		tw.tween_callback(mi.queue_free)
		for k in 10:   # yol boyunca havaya kalkan kayalar
			var q = start.lerp(end, k / 9.0)
			VFX.debris(gp(q), Color(0.45, 0.2, 0.18), 6, 10.0, 0.5)
			VFX.cracks(gp(q), 3.0, Color(0.15, 0.04, 0.03, 0.9), 8.0)
		c.global_position = end
		anim(c, "dash", 1.4)
		Combat.hit_zone(c, start, d, dist, 10.0, 4.0, inf(c, "yagai", 6.0, {"knock": 30.0, "launch": 10.0, "kind": "heavy", "hitstop": 0.2}))
		VFX.slowmo(0.35, 0.6)
		VFX.shockwave(end + Vector3.UP, Color(1, 0.3, 0.2), 16.0, 0.6, false)
		VFX.star(end + Vector3.UP, Color(1, 0.5, 0.4), 4.0)
		if c is Player:
			VFX.screen_lines(0.6, 1.2, Color(1, 0.35, 0.3))
		shake(2.0)
		Sfx.play("boom", end, 0.4)
		get_tree().create_timer(1.2).timeout.connect(func(): FX.stop_aura(steam))
		if c is Player:
			c.hp = minf(c.hp, c.max_hp * 0.1)
			st(c, "slow", 12.0)
			Hud.msg("Gece Gayı'nın bedeli: bedenin tükendi.", Color(1, 0.4, 0.4)))


# ================================================================== Kâğıt Yolu
const PAPER := Color(0.96, 0.95, 0.98)
const PAPER_V := Color(0.62, 0.52, 0.85)


## Tek bir kâğıt yaprağı (dörtgen, hafif kıvrık)
func paper_sheet(s := 0.35) -> MeshInstance3D:
	var b = MB.new()
	b.add("box", Vector3.ZERO, Vector3(s, 0.006, s * 1.3), PAPER, Vector3(randf_range(-20, 20), randf() * 360.0, randf_range(-20, 20)))
	return mesh_of(b)


## Kâğıt Kanatlar: sırttan katmanlı kâğıt kanatlar açılır (kemiğe bağlı), 20 sn uçuş; kanat çırpınca kâğıt bıçaklar savrulur
func p_kami_tsubasa(c: Node3D, _t: Node3D) -> void:
	anim(c, "cast", 1.2)
	var m = c.get("model")
	var parts = []
	var wings = []
	if m and m.skel:
		var sk: Skeleton3D = m.skel
		var chest_b = "UpperChest" if sk.find_bone("UpperChest") >= 0 else "Chest"
		var p_ch: Vector3 = m._grest(sk.find_bone(chest_b)).origin
		for sx in [-1.0, 1.0]:
			var ba = m._attach(chest_b, Transform3D(Basis.IDENTITY, p_ch + Vector3(sx * 0.13, 0.0, -0.14)))   # kürek kemiği
			var b = MB.new()
			_paper_wing(b, sx)
			var wing = mesh_of(b)
			ba.get_child(0).add_child(wing)
			wing.scale = Vector3.ONE * 0.05
			wing.create_tween().tween_property(wing, "scale", Vector3.ONE, 0.4).set_trans(Tween.TRANS_BACK)
			wing.set_meta("sx", sx)
			wings.append(wing)
			parts.append(ba)
	# kanat sırta bağlı ama gövde eğilse de dik durur (animedeki gibi kemer yukarıda, tüyler aşağı); yavaş çırpma
	every(20.0, 1.0 / 60.0, func(i, _k):
		if m == null or not is_instance_valid(m):
			return
		var tm = i / 60.0
		var fast = c is Player and Vector2(c.velocity.x, c.velocity.z).length() > 8.0
		var spd = 7.0 if fast else 4.0
		for w in wings:
			if not is_instance_valid(w):
				continue
			var sx = float(w.get_meta("sx"))
			var ph = sin(tm * spd)
			var sc: Vector3 = w.scale
			# çırpma: uçlar aşağı-yukarı (roll), kanat geriye katlanıp açılır (yaw), hızlıyken daha geride süzülür
			var roll = deg_to_rad(sx * (ph * 22.0 + 4.0))
			var yaw = deg_to_rad(-sx * ((30.0 if fast else 14.0) + cos(tm * spd) * 12.0))
			w.global_basis = m.global_basis.orthonormalized() * Basis.from_euler(Vector3(deg_to_rad(-8.0 + ph * 5.0), yaw, roll))
			w.scale = sc
		if i % 50 == 0 and live(c):
			Sfx.play("wind", c.global_position, 1.8, 0.25))
	Sfx.play("wind", c.global_position, 1.4)
	if c is Player and c.has_method("start_flight"):
		c.start_flight("kami", {"drain": 0.0, "speed": 20.0, "dur": 20.0})
		Buffs.add("kami_tsubasa", 20.0, {"speed": 1.15, "_name": "Kâğıt Kanatlar", "_desc": "uçuyorsun (Space/Ctrl); kanatlar kâğıt bıçak savurur"})
	every(20.0, 1.2, func(_i, _k):
		if not live(c):
			return
		var foes = enemies_near(c, c.global_position, 14.0)
		for k in 3:   # kanatlardan kopup savrulan kâğıtlar
			var sh = paper_sheet(0.12)
			get_tree().current_scene.add_child(sh)
			sh.global_position = c.global_position + Vector3(randf_range(-1.2, 1.2), randf_range(0.6, 2.4), randf_range(-0.6, 0.2))
			var tw = sh.create_tween()
			tw.tween_property(sh, "global_position", sh.global_position + Vector3(randf_range(-2, 2), randf_range(-2.5, -1), randf_range(-2, 2)), 1.4)
			tw.parallel().tween_property(sh, "rotation", Vector3(randf() * 6, randf() * 6, randf() * 6), 1.4)
			tw.tween_callback(sh.queue_free)
		if not foes.is_empty():
			var e = foes.pick_random()
			var b2 = MB.new()
			b2.add("box", Vector3.ZERO, Vector3(0.05, 0.005, 0.5), PAPER)
			shot(c, c.global_position + Vector3.UP * 1.4, (e.global_position + Vector3.UP - c.global_position - Vector3.UP * 1.4).normalized(), 40.0, mesh_of(b2), inf(c, "kami_tsubasa", 0.2, {"knock": 1.0, "kind": "light"}), null, false, 0.8), func():
		for pp in parts:
			if is_instance_valid(pp):
				pp.queue_free()
		if c is Player and is_instance_valid(c) and c.has_method("flight_source") and c.flight_source() == "kami":
			c.stop_flight())


# ================================================================== Kurbağa Bilgesi Yolu
const TOAD_OIL := Color(0.92, 0.75, 0.3)


## Yağ gölü: içindekiler yavaşlar; ateş vurursa alev gölüne döner
func _oil_pool(c: Node3D, at: Vector3, r: float, dur: float) -> void:
	at = gp(at)
	# kurbağa yağı birikintisi: düz disk değil — zemini saran düzensiz, ıslak parlamalı amber yağ lekeleri (Decal),
	# üstünde kaynayıp patlayan kabarcıklar; yağ yavaşça yayılır
	var decals = []
	for k in 5:
		var a = randf() * TAU
		var p = at + Vector3(cos(a), 0, sin(a)) * (0.0 if k == 0 else randf_range(0.4, 0.75) * r)
		var dc = Decal.new()
		dc.texture_albedo = FX._puddle(randi())
		dc.modulate = Color(0.85, 0.6, 0.16, 0.92)
		var sz = r * (1.6 if k == 0 else randf_range(0.7, 1.0))
		dc.size = Vector3(sz * randf_range(1.0, 1.3), 1.4, sz)
		dc.cull_mask = 1
		get_tree().current_scene.add_child(dc)
		dc.global_position = gp(p) + Vector3.UP * 0.2
		dc.rotation.y = randf() * TAU
		dc.scale = Vector3.ONE * 0.3
		dc.create_tween().tween_property(dc, "scale", Vector3.ONE, 0.8).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
		decals.append(dc)
	every(dur, 0.15, func(i, _k):
		var b = at + Vector3(randf_range(-1, 1), 0, randf_range(-1, 1)) * r * 0.7
		VFX.puffs(gp(b) + Vector3.UP * 0.1, {"amount": 2, "life": 0.35, "size": 0.35, "radius": 0.2, "vmin": 0.3, "vmax": 0.9, "dir": Vector3.UP, "spread": 30.0,
			"rough": 0.1, "outline": 0.03, "outline_col": Color(0.5, 0.32, 0.08), "colors": [Color(1.0, 0.85, 0.45, 1), Color(0.95, 0.7, 0.25, 0.9), Color(0.9, 0.65, 0.2, 0.0)]})
		if i % 3 == 0:
			for e in enemies_near(c, at, r):
				st(e, "slow", 1.0), func():
		for dc in decals:
			if is_instance_valid(dc):
				var tw = dc.create_tween()
				tw.tween_property(dc, "modulate:a", 0.0, 1.0)
				tw.tween_callback(dc.queue_free))


## Konan'ın melek kanadı: omuzdan başın üstüne kemer, oradan dizlere kadar sarkan tüy sütunları; her tüy küçük kâğıt tuğlalardan
func _paper_wing(b: MB, sx: float) -> void:
	var rng = RandomNumberGenerator.new()
	rng.seed = 77 if sx > 0 else 78
	var arm := func(u: float) -> Vector3:   # kemer (ikinci derece bezier): kök → yukarı → dış tepe
		var p0 = Vector2(0.0, 0.0); var p1 = Vector2(0.35, 0.75); var p2 = Vector2(1.05, 0.95)   # ref: sırttan yukarı kalkıp başın üstünde dışa kıvrılan kemer
		var q = p0.lerp(p1, u).lerp(p1.lerp(p2, u), u)
		return Vector3(q.x * sx * 1.6, q.y * 1.1, -0.05 - q.x * 0.15)   # ref: kanat açıklığı gövde boyu kadar
	var cols = 22
	for ci in cols:
		var u = 0.12 + 0.88 * (ci + 0.5) / cols   # kökte (sırtta) tüy yok
		var top: Vector3 = arm.call(u)
		var L = 0.5 + 1.6 * pow(u, 1.2) + rng.randf_range(-0.12, 0.12) * u   # dışa doğru uzayan, uçları düzensiz tüy sıraları (dizlere iner)
		var dir = Vector3(sx * (0.15 + 0.45 * u), -1.0, -0.05).normalized()
		var n = int(L / 0.075)
		for k in n:
			var f = float(k) / maxf(1.0, n - 1)
			var w = 0.16 * (1.0 - 0.5 * pow(f, 2.0))           # uca doğru daralan tüy
			var q = top + dir * (k * 0.075) + Vector3(rng.randf_range(-0.012, 0.012), 0, (ci % 2) * -0.012)
			var col = PAPER.darkened(rng.randf_range(0.0, 0.1) + 0.06 * f)
			b.add("box", q, Vector3(w, 0.11, 0.008), col, Vector3(-4, 0, rad_to_deg(atan2(dir.x, -dir.y)) * -1.0 + rng.randf_range(-8, 8)))
	# kemer üzerindeki kalın üst kenar: çift sıra tuğla
	for k in 22:
		var u = 0.1 + 0.9 * k / 21.0
		var q: Vector3 = arm.call(u)
		var q2: Vector3 = arm.call(minf(1.0, u + 0.05))
		var ang = rad_to_deg(atan2(q2.y - q.y, (q2.x - q.x) * sx))
		for r in 2:
			b.add("box", q + Vector3(0, -0.06 * r, 0.006), Vector3(0.13, 0.09, 0.009), PAPER.darkened(0.03 * r + rng.randf_range(0, 0.05)), Vector3(-10, 0, ang * sx))


## Omuzda oturan yaşlı bilge kurbağa: yüksek yakalı cübbe, kulak diski, alın bandı; erkek: beyaz diken saç/kaş/keçi sakal + sırtta parşömen, dişi: kıvırcık mor saç, mor dudak (+Z öne bakar)
func _elder_toad(female: bool) -> MB:
	var skin = Color(0.48, 0.58, 0.3) if not female else Color(0.85, 0.86, 0.62)
	var robe = Color(0.5, 0.48, 0.45) if not female else Color(0.28, 0.2, 0.32)
	var robe_d = robe.darkened(0.25)
	var white = Color(0.95, 0.95, 0.93)
	var purple = Color(0.55, 0.32, 0.65)
	var b = MB.new()
	# gövde cübbenin içinde: yalnızca ayaklar dışarıda
	b.add("sphere", Vector3(0, 0.07, 0), Vector3(0.2, 0.15, 0.19), skin)
	for ex in [-1.0, 1.0]:
		b.add("sphere", Vector3(ex * 0.07, 0.012, 0.075), Vector3(0.045, 0.025, 0.06), skin)          # ön ayak parmakları
	b.add("sphere", Vector3(0, 0.08, -0.005), Vector3(0.235, 0.18, 0.225), robe, Vector3.ZERO, 12)    # cübbe gövdeyi sarar
	b.add("cyl", Vector3(0, 0.008, -0.005), Vector3(0.25, 0.016, 0.23), robe_d, Vector3.ZERO, 12)     # etek kenarı
	b.add("cyl", Vector3(0, 0.14, -0.005), Vector3(0.205, 0.05, 0.195), robe_d, Vector3.ZERO, 14)    # kalın yüksek yaka
	b.add("cyl", Vector3(0, 0.168, -0.005), Vector3(0.21, 0.012, 0.2), robe, Vector3.ZERO, 14)      # yaka kıvrımı
	b.add("sphere", Vector3(0, 0.17, -0.065), Vector3(0.15, 0.11, 0.07), robe_d)                      # sırtta kapüşon
	b.add("box", Vector3(0, 0.11, 0.1), Vector3(0.012, 0.09, 0.006), robe_d)                          # önde cübbe yarığı
	# baş
	b.add("sphere", Vector3(0, 0.17, 0.02), Vector3(0.18, 0.12, 0.16), skin)
	b.add("sphere", Vector3(0, 0.145, 0.07), Vector3(0.13, 0.05, 0.08), skin.darkened(0.05))         # ağız/çene
	for ex in [-1.0, 1.0]:
		b.add("sphere", Vector3(ex * 0.055, 0.215, 0.065), Vector3(0.055, 0.045, 0.045), skin)        # göz tümseği
		b.add("sphere", Vector3(ex * 0.058, 0.218, 0.085), Vector3(0.034, 0.03, 0.012), Color(0.92, 0.7, 0.2))
		b.add("box", Vector3(ex * 0.058, 0.218, 0.092), Vector3(0.024, 0.005, 0.003), Color(0.05, 0.05, 0.05))
		b.add("cyl", Vector3(ex * 0.088, 0.17, 0.01), Vector3(0.035, 0.008, 0.035), Color(0.7, 0.7, 0.66), Vector3(0, 0, 90), 10)   # kulak diski
		b.add("box", Vector3(ex * 0.092, 0.17, 0.01), Vector3(0.002, 0.004, 0.026), Color(0.35, 0.35, 0.33))
	b.add("cyl", Vector3(0, 0.2, 0.02), Vector3(0.185, 0.02, 0.165), Color(0.2, 0.24, 0.42), Vector3(-12, 0, 0), 16)   # alın bandı başı sarar
