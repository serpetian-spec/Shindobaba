## Ahşap Ağaç Hapsi: hedefin etrafında ahşap kubbe, içinde sarmal bağlayan dallar — yüzde ahşap mühür deseni; çakrası bastırılır
func p_mokuton_hobi_no_jutsu(c: Node3D, t: Node3D) -> void:
	# kanon (Hōbi, fūinjutsu): kullanıcının çevresinde bir anda yüz oymalı dolu ahşap kubbe; içerideyken gelen saldırılar
	# büyük ölçüde zayıflar (Hashirama, Kurama'nın Bijūdama'sını böyle söndürdü); süre bitince kubbe ortadan ikiye açılır.
	# anime yüzü: iç içe halkalı iri yuvarlak gözler, kalın kavisli kaşlar, yassı burun, dudak çıkıntısı ve kare diş sırası.
	busy(c, 0.5)
	var at = gp(c.global_position)
	var yaw = atan2(-c.face_dir().x, -c.face_dir().z)
	var root = Node3D.new()
	get_tree().current_scene.add_child(root)
	root.global_position = at
	root.rotation.y = yaw
	var mb = [MB.new(), MB.new()]   # 0: +x yarısı, 1: -x yarısı
	var R = 3.0
	for k in 30:   # birbirine yaslanan kalın kaburgalar = dolu, oluklu kubbe
		var a = (k + 0.5) * TAU / 30.0
		var hi = 0 if cos(a) >= 0.0 else 1
		var pts = []
		var rad = []
		for q in 7:
			var e = 1.48 * q / 6.0
			pts.append(Vector3(cos(a) * cos(e), sin(e), sin(a) * cos(e)) * R + Vector3.DOWN * (0.15 if q == 0 else 0.0))
			rad.append(lerpf(0.42, 0.2, q / 6.0))
		var rc = WOOD_C.darkened(0.06 * (k % 3))
		Loft.tube(mb[hi], pts, rad, rc, 9, 3, false, false, _bark_fn(rc))
	var dark = Color(0.14, 0.09, 0.05)
	var lite = WOOD_C.lightened(0.18)
	for hi in 2:
		var sx = 1.0 - hi * 2.0
		var b = mb[hi]
		for rg in [[1.25, 0.05, lite, "cyl"], [1.15, 0.12, dark, "torus"], [0.78, 0.16, dark, "torus"], [0.42, 0.2, dark, "torus"], [0.16, 0.2, dark, "cyl"]]:   # iç içe halkalı göz
			_dome_put(b, rg[3], sx * 0.95, 1.7, rg[1], Vector3(rg[0], 0.12 if rg[3] == "cyl" else 0.5, rg[0]), rg[2], R + 0.4, 22)
		for q in 5:   # kalın kavisli kaş
			var u = q / 4.0
			_dome_put(b, "box", sx * lerpf(0.25, 1.75, u), 2.3 + sin(u * PI) * 0.3 - u * 0.15, 0.12, Vector3(0.42, 0.26, 0.3), WOOD_C.darkened(0.28), R + 0.4)
		_dome_put(b, "box", sx * 0.2, 1.1, 0.22, Vector3(0.4, 0.62, 0.45), WOOD_C.lightened(0.06), R + 0.4)   # yassı burun yarısı
		_dome_put(b, "box", sx * 0.24, 0.88, 0.42, Vector3(0.16, 0.1, 0.08), dark, R + 0.4)                  # burun deliği
		for q in 6:   # dudak çıkıntısı
			var u = q / 5.0
			_dome_put(b, "box", sx * lerpf(0.1, 1.7, u), 0.72 + u * u * 0.15, 0.14, Vector3(0.34, 0.16, 0.24), WOOD_C.darkened(0.22), R + 0.4)
		for q in 4:
			var u = q / 3.0
			_dome_put(b, "box", sx * lerpf(0.2, 1.4, u), 0.4 + u * u * 0.12, 0.02, Vector3(0.48, 0.5, 0.2), dark, R + 0.4)  # ağız boşluğu
			_dome_put(b, "box", sx * lerpf(0.2, 1.4, u), 0.52 + u * u * 0.12, 0.1, Vector3(0.34, 0.2, 0.14), lite, R + 0.4)   # üst diş
			_dome_put(b, "box", sx * lerpf(0.2, 1.4, u), 0.28 + u * u * 0.12, 0.1, Vector3(0.34, 0.18, 0.14), lite.darkened(0.08), R + 0.4)   # alt diş
	var halves = []
	for hi in 2:
		var h = Node3D.new()
		h.add_child(mesh_of(mb[hi], Props.bark_toon()))
		root.add_child(h)
		halves.append(h)
	root.scale = Vector3(1, 0.03, 1)
	var tw = root.create_tween()
	tw.tween_property(root, "scale", Vector3.ONE, 0.3).set_trans(Tween.TRANS_BACK)
	tw.tween_interval(4.0)
	tw.tween_callback(func():   # komutla ortadan ikiye açılır
		var tw2 = root.create_tween().set_parallel(true)
		tw2.tween_property(halves[0], "position", Vector3(2.6, -0.4, 0), 0.5)
		tw2.tween_property(halves[1], "position", Vector3(-2.6, -0.4, 0), 0.5)
		tw2.tween_property(halves[0], "rotation:z", -0.5, 0.5)
		tw2.tween_property(halves[1], "rotation:z", 0.5, 0.5)
		tw2.chain().tween_callback(root.queue_free))
	_earth_burst(at, 2.0)
	var mods = {"armor": 0.08, "_name": "Hōbi", "_desc": "yüz oymalı ahşap kubbe gelen saldırıları söndürüyor"}
	if c is Player:
		Buffs.add("mokuton_hobi", 4.3, mods)
	elif c.has_method("add_buff"):
		c.add_buff("mokuton_hobi", 4.3, mods)
	Sfx.play("earth", at, 0.6)

## Kubbe (yarıçap R, ön yüz -z) yüzeyine parça koyar: (x, y) ön görünüşte konum, off yüzeyden dışarı taşma; parça normale hizalanır
func _dome_put(b: MB, kind: String, x: float, y: float, off: float, size: Vector3, col: Color, R: float, seg := 8) -> void:
	var z = -sqrt(maxf(R * R - x * x - y * y, 0.04))
	var n = Vector3(x, y, z).normalized()
	var p = n * (R + off)
	var bas: Basis
	if kind == "box":
		bas = Basis.looking_at(n, Vector3.UP)
	else:
		bas = Basis(Quaternion(Vector3.UP, n))
	b.add_xf(kind, Transform3D(bas.scaled_local(size), p), col, seg)


# ================================================================== Yeni jutsular O (Sv.28): ahşap devler, sonsuz Tsukuyomi, Altı Yol güçleri, şimşek kapısı, demir kum
const RIKUDO := Color(1.0, 0.85, 0.35)


## Rasenşuriken düğümü (anime): Jutsu.rasenshuriken_body — mavi çekirdek + dört kıvrık beyaz rüzgâr bıçağı diski,
## uçuşta kameraya hafif eğik; çevresinde çığlık atan akım çizgileri. s = eski ölçek birimi (disk çapı ≈ s * 2.6 m).
func _rsh_big(s: float, tint := Color(0.78, 0.9, 1.0)) -> Node3D:
	var core = Node3D.new()
	var body = Jutsu.rasenshuriken_body(s * 2.6, tint)
	body.rotation.x = 0.5
	core.add_child(body)
	WindFX.bullet(core, s * 1.6)
	return core


## Altı Yol avuç işareti (güneş veya hilal)
func _palm_mark(c: Node3D, side: String, moon: bool) -> Node3D:
	var ba = bone_attach(c, side)
	if ba == null:
		return null
	var b = MB.new()
	if moon:
		b.add("cyl", Vector3(0, 0.08, 0.03), Vector3(0.06, 0.006, 0.06), Color(0.05, 0.05, 0.06), Vector3(90, 0, 0), 16)
		b.add("cyl", Vector3(0.015, 0.09, 0.034), Vector3(0.05, 0.006, 0.05), Color(0.9, 0.85, 0.8), Vector3(90, 0, 0), 16)
	else:
		b.add("cyl", Vector3(0, 0.08, 0.03), Vector3(0.05, 0.006, 0.05), Color(0.05, 0.05, 0.06), Vector3(90, 0, 0), 16)
		for k in 8:
			var a = k * TAU / 8.0
			b.add("box", Vector3(cos(a) * 0.045, 0.08 + sin(a) * 0.045, 0.03), Vector3(0.02, 0.005, 0.004), Color(0.05, 0.05, 0.06), Vector3(0, 0, rad_to_deg(a)))
	ba.add_child(mesh_of(b))
	return ba


## Sırtta dokuz magatama halkası (Altı Yol modu)
func _magatama_ring(c: Node3D, col: Color) -> Node3D:
	var ba = bone_attach(c, "UpperChest")
	if ba == null:
		return null
	var b = MB.new()
	for k in 9:
		var x = (k % 3 - 1) * 0.09
		var y = 0.02 + (k / 3) * 0.09
		b.add("sphere", Vector3(x, y, -0.14), Vector3(0.045, 0.045, 0.01), col)
		b.add("sphere", Vector3(x + 0.02, y - 0.02, -0.14), Vector3(0.02, 0.025, 0.01), col)
	b.add("cyl", Vector3(0, 0.28, -0.16), Vector3(0.22, 0.01, 0.22), Color(0.05, 0.05, 0.06), Vector3(90, 0, 0), 24)
	ba.add_child(mesh_of(b, VFX.mat_bolt(col, 1.0)))
	return ba


## Ahşap Hotei: yerdeki dev ahşap mühürden mavi çakra ruh-ejder yükselir, hedefi sarar — çakrasını emip kilitler
func p_mokuton_hotei_no_jutsu(c: Node3D, t: Node3D) -> void:
	# kanon (Hotei no Jutsu): avuçlar birleşir; hedefin çevresinde yerden halka hâlinde çok sayıda dev ahşap el fışkırır,
	# onu çevreleyip kavrar ve tutar (anime: yukarıdan bakınca sarmal ahşap zemin + el çemberi). Hedef büyükse eller de büyür.
	busy(c, 1.0)
	var tt = tg(c, t, 30.0)
	var at = gp(tt.global_position if tt else c.global_position + fwd(c, t) * 10.0)
	# kanon (Databook): her el bir kuyruklu canavar büyüklüğünde — insan hedefe karşı da dev (~25 m), dev hedefte daha da büyür
	var big = 6.0
	if tt and tt.get("height") != null:
		big = clampf(float(tt.get("height")) / 2.0, 6.0, 14.0)
	# zeminde sarmal ahşap halka (ellerin çıktığı yer)
	var sb = MB.new()
	var sp = []
	var sr = []
	var floor_c = Color(0.3, 0.36, 0.3)   # ref: koyu yeşil-gri iç içe halkalı dev sarmal zemin
	for i in 60:
		var a = i * 0.42
		sp.append(Vector3(cos(a), 0.0, sin(a)) * (6.0 - i * 0.092) * big + Vector3.UP * 0.1 * big)
		sr.append(Vector2(0.95, 0.16) * big)
	Loft.tube(sb, sp, sr, floor_c, 10, 3, true, true, _bark_fn(floor_c))
	var coil = mesh_of(sb, Props.bark_toon())
	scene_add(coil, at)
	coil.scale = Vector3(1, 0.05, 1)
	var ctw = coil.create_tween()
	ctw.tween_property(coil, "scale", Vector3.ONE, 0.25)
	ctw.tween_interval(4.6)
	ctw.tween_property(coil, "scale", Vector3(1, 0.05, 1), 0.5)
	ctw.tween_callback(coil.queue_free)
	var n = 8 if big < 2.0 else 10
	for k in n:
		var a = TAU * k / n + randf() * 0.2
		var hand = _wood_hand(big * randf_range(0.9, 1.1))
		var base = at + Vector3(cos(a), 0, sin(a)) * (3.8 * big)
		scene_add(hand, base + Vector3.DOWN * 5.0 * big)
		hand.look_at_from_position(hand.global_position, Vector3(at.x, hand.global_position.y, at.z), Vector3.UP)   # yalnız yatay yön (dik dursun)
		hand.rotate_y(PI)   # avuç (+z) hedefe dönük
		var tw = hand.create_tween()
		tw.tween_interval(0.1 + k * 0.05)
		tw.tween_property(hand, "global_position", base, 0.35).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		tw.tween_property(hand.get_child(0), "rotation:x", 0.35, 0.3)   # öne kapanıp kavrar
		tw.tween_interval(4.0)
		tw.tween_property(hand, "global_position", base + Vector3.DOWN * 5.0 * big, 0.6)
		tw.tween_callback(hand.queue_free)
		after(0.1 + k * 0.05, func(): _earth_burst(base, big * 0.7))
	after(0.6, func():
		for e in enemies_near(c, at, 2.6 * big):
			st(e, "bind", 4.0)
			e.take_hit(inf(c, "mokuton_hotei_no_jutsu", 0.8, {"knock": 0.0, "launch": 0.0, "kind": "crush", "element": "mokuton"})))
	shake(0.6 * big)
	Sfx.play("earth", at, 0.5)


## Dev ahşap el (avuç +z yönüne bakar, bilek yerde): kalın avuç, dört parmak + başparmak, oyma ahşap derzleri
func _wood_hand(s: float) -> Node3D:
	# yerden çıkan kol + yassı avuç (+z avuç içi), boğumlu kıvrık dört parmak ve başparmak — hepsi pürüzsüz kabuklu tüp
	var b = MB.new()
	var wc = WOOD_C
	var bark = _bark_fn(wc)
	Loft.tube(b, [Vector3(0, -1.2 * s, -0.25 * s), Vector3(0, 0.9 * s, -0.12 * s), Vector3(0, 2.5 * s, 0)], [0.58 * s, 0.5 * s, 0.44 * s], wc.darkened(0.06), 12, 3, false, false, bark)
	Loft.tube(b, [Vector3(0, 2.35 * s, 0), Vector3(0, 3.0 * s, 0.06 * s), Vector3(0, 3.65 * s, 0.08 * s)], [Vector2(0.48 * s, 0.3 * s), Vector2(0.62 * s, 0.3 * s), Vector2(0.6 * s, 0.24 * s)], wc, 14, 3, true, true, bark, Vector3(0, 0, 1))
	var FL = [0.95, 1.1, 1.05, 0.82]
	for f in 4:
		var fx = (-0.43 + f * 0.287) * s
		var L = FL[f] * s
		var p0 = Vector3(fx, 3.55 * s, 0.1 * s)
		var p1 = p0 + Vector3(fx * 0.06, L * 0.45, L * 0.1)
		var p2 = p1 + Vector3(fx * 0.04, L * 0.35, L * 0.28)
		var p3 = p2 + Vector3(0, L * 0.12, L * 0.34)
		Loft.tube(b, [p0, p1, p2, p3], [0.16 * s, 0.15 * s, 0.13 * s, 0.1 * s], wc.lightened(0.03 * f), 9, 3, false, true, bark)
	Loft.tube(b, [Vector3(0.5 * s, 2.7 * s, 0.12 * s), Vector3(0.92 * s, 3.2 * s, 0.42 * s), Vector3(0.88 * s, 3.65 * s, 0.75 * s)], [0.19 * s, 0.16 * s, 0.11 * s], wc, 9, 3, false, true, bark)
	var mi = MeshInstance3D.new()
	mi.mesh = b.build(Props.bark_toon())
	var root = Node3D.new()
	root.add_child(mi)
	return root


## Mokuton: Mokujin no Jutsu (kanon, Hashirama): ~110 m tahta dev (oni yüzü, diken yelesi, gövdesine sarılı ejder) topraktan
## yükselir, rakibin üstüne iki dev yumruk indirir, sonra toprağa geri gömülür. Gerçek model: Mokujin (actors/mokujin.gd).
func p_mokuton_mokujin_no_jutsu(c: Node3D, t: Node3D) -> void:
	busy(c, 1.4)
	var tt = tg(c, t, 60.0)
	var d = fwd(c, t)
	var goal0 = gp(tt.global_position if tt else c.global_position + d * 30.0)
	var at = gp(c.global_position - d * 22.0)
	var yaw = atan2(-(goal0 - at).x, -(goal0 - at).z)
	var mj = Mokujin.spawn(get_tree().current_scene, at - Vector3.UP * 120.0, yaw)
	mj.set_pose("rise", 0.0)
	for k in 6:
		_earth_burst(at + Vector3(cos(k) * 18.0, 0, sin(k) * 18.0), 3.0)
	VFX.cracks(at, 30.0)
	shake(1.2)
	Sfx.play("earth", at, 0.4)
	var tw = mj.create_tween()
	tw.tween_property(mj, "global_position", at, 1.3).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	tw.tween_callback(func(): mj.set_pose("stand", 0.4))
	for k in 2:
		var right = k == 0
		tw.tween_interval(0.35)
		tw.tween_callback(func(): mj.set_pose("pull_r" if right else "pull_l", 0.45))
		tw.tween_interval(0.5)
		tw.tween_callback(func(): mj.set_pose("punch_r" if right else "punch_l", 0.3))
		tw.tween_interval(0.3)
		tw.tween_callback(func():
			var goal = gp(tt.global_position if tt and live(tt) else goal0)
			impact_fx("doton", EARTH, goal + Vector3.UP * 1.0, 4.0)
			VFX.cracks(goal, 14.0)
			VFX.shockwave(goal + Vector3.UP * 0.3, Color(0.6, 0.55, 0.4), 18.0, 0.4, true)
			hit(c, goal + Vector3.UP, 9.0, inf(c, "mokuton_mokujin_no_jutsu", 1.4, {"knock": 20.0, "launch": 6.0, "kind": "heavy", "element": "mokuton", "hitstop": 0.12}))
			shake(1.4))
	tw.tween_interval(0.8)
	tw.tween_callback(func(): mj.set_pose("stand", 0.4))
	tw.tween_interval(0.4)
	tw.tween_property(mj, "global_position", at - Vector3.UP * 120.0, 1.4).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	tw.tween_callback(mj.queue_free)


## Sonsuz Tsukuyomi: göğe dev beyaz ay yükselir, üzerinde Rinne-Sharingan deseni açılır — beyaz ışık her şeyi örter, menzildeki herkes rüyaya düşer, kökler sarar
func p_mugen_tsukuyomi(c: Node3D, _t: Node3D) -> void:
	busy(c, 2.0)
	var sky = c.global_position + c.face_dir() * 48.0 + Vector3.UP * 16.0
	var moon = MeshInstance3D.new()
	moon.mesh = SphereMesh.new()
	var m = StandardMaterial3D.new()
	m.albedo_color = Color(1, 0.97, 0.9)
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	moon.material_override = m
	get_tree().current_scene.add_child(moon)
	moon.global_position = sky
	moon.scale = Vector3.ONE * 0.5
	var eye = Node3D.new()
	moon.add_child(eye)
	var red = StandardMaterial3D.new()
	red.albedo_color = Color(0.85, 0.1, 0.15)
	red.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	for r in [0.18, 0.3, 0.42]:
		var ring = MeshInstance3D.new()
		var tm = TorusMesh.new()
		tm.inner_radius = r; tm.outer_radius = r + 0.015; tm.rings = 32; tm.ring_segments = 4
		ring.mesh = tm
		ring.material_override = red
		ring.rotation.x = PI * 0.5
		eye.add_child(ring)
	for k in 9:
		var tom = MeshInstance3D.new()
		tom.mesh = SphereMesh.new()
		tom.material_override = red
		var r = [0.18, 0.3, 0.42][k / 3]
		var a = k * TAU / 3.0 + (k / 3) * 0.5
		tom.position = Vector3(cos(a) * r, sin(a) * r, 0)
		tom.scale = Vector3.ONE * 0.06
		eye.add_child(tom)
	eye.position = Vector3(0, 0, -0.5)
	eye.look_at_from_position(eye.position, -(c.global_position - sky).normalized() * 2.0, Vector3.UP)
	eye.scale = Vector3.ONE * 0.02
	var tw = moon.create_tween()
	tw.tween_property(moon, "scale", Vector3.ONE * 16.0, 0.8).set_trans(Tween.TRANS_QUAD)
	tw.parallel().tween_property(eye, "scale", Vector3.ONE, 1.0)
	tw.tween_callback(func():
		if c is Player:
			VFX.screen_lines(0.8, 2.0, Color(1, 1, 1))
		VFX.star(sky, Color(1, 1, 1), 30.0, 0.6)
		for e in enemies_near(c, c.global_position, 40.0):
			st(e, "stun", 6.0)
			st(e, "bind", 6.0)
			for j in 3:
				var root = _branch(3.0, 0.15)
				e.add_child(root)
				fit_body(e, root)   # hedef boyunda (kuyruklu/dev hedefte küçük kalmasın)
				root.position = Vector3(cos(j * 2.1) * 0.35, 0.6 + j * 0.4, sin(j * 2.1) * 0.35)
				root.rotation = Vector3(randf_range(-1, 1), randf() * TAU, randf_range(-1, 1))
				get_tree().create_timer(6.0).timeout.connect(root.queue_free)
			e.take_hit(inf(c, "mugen_tsukuyomi", 1.0, {"knock": 0.0, "kind": "heavy", "chakra_drain": 30.0}))
		shake(1.2))
	tw.tween_interval(3.0)
	tw.tween_property(moon, "scale", Vector3.ONE * 0.05, 0.8)
	tw.tween_callback(moon.queue_free)
	Sfx.play("genjutsu", c.global_position, 0.4)


## Musekiyōjin (kanon, Obito — Altı Yol gücü şart): kara alıcı çubuklardan kurulan, Dört Kırmızı Yang'ı aşan bariyer —
## hiç kimse geçemez, içindeki dev patlamaları (kuyruklu canavar topları) yukarı, göğe saptırır. Uzay-zaman ile aşılabilir.
## Burada: hedefin çevresinde altı kara çubuk, aralarında kırmızı altıgen duvar; içeridekiler çıkamaz, gelen mermiler göğe sapar.
func p_musekiyojin(c: Node3D, t: Node3D) -> void:
	var six = (c is Player and (Buffs.has("rikudo_sennin") or Buffs.has("rikudo_senjutsu"))) or (not (c is Player) and c.has_meta("rikudo"))
	if not six:
		if c is Player:
			Hud.msg("Musekiyōjin yalnız Altı Yol gücüyle kurulur (Altı Yol Bilge Modu açık olmalı).", Color(1.0, 0.5, 0.45))
		return
	busy(c, 1.0)
	var tt = tg(c, t, 30.0)
	var at = gp(tt.global_position if tt else c.global_position + fwd(c, t) * 12.0)
	var R0 = 8.0
	var H = 34.0
	var wm = StandardMaterial3D.new()
	wm.albedo_color = Color(1.0, 0.12, 0.08, 0.3)
	wm.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	wm.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	wm.cull_mode = BaseMaterial3D.CULL_DISABLED
	var box = Node3D.new()
	get_tree().current_scene.add_child(box)
	box.global_position = at
	for k in 6:
		var a0 = k * TAU / 6.0
		var a1 = (k + 1) * TAU / 6.0
		var p0 = Vector3(cos(a0), 0, sin(a0)) * R0
		var p1 = Vector3(cos(a1), 0, sin(a1)) * R0
		var wall = MeshInstance3D.new()
		var qm = QuadMesh.new()
		qm.size = Vector2(p0.distance_to(p1), H)
		wall.mesh = qm
		wall.material_override = wm
		box.add_child(wall)
		wall.position = (p0 + p1) * 0.5 + Vector3.UP * H * 0.5
		wall.look_at(box.global_position + wall.position + ((p0 + p1) * 0.5).normalized(), Vector3.UP)
		var rod = _receiver_rod(H)
		box.add_child(rod)
		rod.position = p0 + Vector3.UP * H * 0.5
		rod.rotation = Vector3(-PI * 0.5, 0, 0)
	box.scale = Vector3(1, 0.02, 1)
	var tw = box.create_tween()
	tw.tween_property(box, "scale", Vector3.ONE, 0.4).set_trans(Tween.TRANS_QUAD)
	tw.tween_interval(8.0)
	tw.tween_property(box, "scale", Vector3(1, 0.02, 1), 0.3)
	tw.tween_callback(box.queue_free)
	var inside = enemies_near(c, at, R0 - 0.5)
	every(8.4, 0.1, func(_i, _k):
		for e in inside:   # içeridekiler çıkamaz
			if live(e):
				var off = e.global_position - at
				off.y = 0
				if off.length() > R0 - 0.8:
					e.global_position = at + off.normalized() * (R0 - 0.9) + Vector3.UP * (e.global_position.y - at.y)
		for f in get_tree().get_nodes_in_group("fighters"):   # dışarıdakiler giremez
			if f in inside or f == c or f.is_dead():
				continue
			var o2 = f.global_position - at
			o2.y = 0
			if o2.length() < R0 + 0.5:
				f.global_position = at + o2.normalized() * (R0 + 0.6) + Vector3.UP * (f.global_position.y - at.y)
		for p in get_tree().get_nodes_in_group("projectiles"):   # bariyere çarpan mermi göğe sapar
			var o3 = p.global_position - at
			o3.y = 0
			if absf(o3.length() - R0) < 1.0 and p.get("vel") != null:
				p.vel = Vector3(0, absf(p.vel.length()), 0), Callable())
	Sfx.play("seal", at, 0.6)


## Ningendō (kanon): elini hedefin başına koyar, zihnini okur (sırlarını öğrenir), elini çekerken ruhu bedenden söker —
## sıradan hedef ölür. Ancak çok büyük güç (canavar çakrası / bijū pelerini) sökmeye bir süre direnebilir. Boss ölmez:
## ağır hasar + sersemleme. Temas şart (yakın dövüş menzili). Oyuncu ve AI aynı fonksiyon.
func p_ningendo(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 6.0)
	if tt == null:
		if c is Player:
			Hud.msg("Ningendō: eli başına koymak için hedefe yakın olmalısın.", Color(0.75, 0.85, 1.0))
		return
	busy(c, 1.8)
	var dv = _face(c, tt)
	var tw0 = c.create_tween()
	tw0.tween_property(c, "global_position", gp(tt.global_position - dv * 0.9), 0.2).set_trans(Tween.TRANS_QUAD)
	after(0.25, func():
		if not (live(c) and live(tt)) or c.global_position.distance_to(tt.global_position) > 2.5:
			return
		anim(c, "interact", 1.0)
		tt.set_meta("gaki_hold", true)
		st(tt, "bind", 1.6)
		if c is Player:
			c.input_locked = 1.5
		Combat.popup_text(tt.global_position + Vector3.UP * 2.6, "Zihni okunuyor...", Color(0.8, 0.88, 1.0))
		var resist = (tt is Player and Buffs.has("beast")) or tt.has_meta("jinchuriki")
		var boss = tt is Player or tt.has_meta("boss") or tt is TailedBeast
		var ghost = _soul_ghost()
		get_tree().current_scene.add_child(ghost)
		ghost.global_position = tt.global_position
		ghost.rotation.y = tt.rotation.y
		ghost.scale = Vector3.ONE * 0.98
		var away = -dv
		var tw = ghost.create_tween()
		tw.tween_interval(0.6)
		# el geri çekilirken ruh bedenden sıyrılır (başından itibaren öne-yukarı uzar)
		tw.tween_property(ghost, "global_position", tt.global_position + away * (0.5 if resist else 1.4) + Vector3.UP * 0.25, 0.8).set_trans(Tween.TRANS_SINE)
		tw.parallel().tween_property(ghost, "rotation:x", -0.35, 0.8)
		tw.tween_callback(func():
			if is_instance_valid(tt):
				tt.remove_meta("gaki_hold")
			if not (live(c) and live(tt)):
				return
			if resist:
				Combat.popup_text(tt.global_position + Vector3.UP * 2.6, "Canavar gücüyle direndi!", Color(1, 0.6, 0.3))
				tt.take_hit(inf(c, "ningendo", 1.2, {"knock": 0.0, "launch": 0.0, "kind": "light", "pierce_guard": true}))
			elif boss:
				st(tt, "stun", 2.0)
				if tt is Player:
					tt.chakra = maxf(0.0, tt.chakra * 0.4)
				tt.take_hit(inf(c, "ningendo", 0.0, {"dmg": float(tt.max_hp) * (0.22 if tt is Player else 0.1), "knock": 0.0, "launch": 0.0, "kind": "light", "pierce_guard": true}))
				Combat.popup_text(tt.global_position + Vector3.UP * 2.6, "Ruhu yarı söküldü", Color(0.8, 0.88, 1.0))
			else:
