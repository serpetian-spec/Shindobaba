		cr.position = Vector3(randf_range(-0.4, 0.4), randf_range(-0.4, 0.4), 0.45)
	var tw = moon.create_tween()
	tw.tween_property(moon, "global_position", goal + Vector3.UP * 3.0, 1.6).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	tw.tween_callback(func():
		VFX.explosion(goal + Vector3.UP, 6.0, Color(0.9, 0.9, 1.0))
		VFX.shockwave(goal + Vector3.UP * 0.3, Color(0.85, 0.85, 0.9), 30.0, 0.6, true)
		VFX.cracks(goal, 20.0)
		VFX.debris(goal + Vector3.UP, Color(0.6, 0.6, 0.58), 40, 18.0, 1.0)
		if live(c):
			hit(c, goal + Vector3.UP, 12.0, inf(c, "otsutsuki_ten_no_kama", 4.5, {"knock": 28.0, "launch": 10.0, "kind": "heavy", "hitstop": 0.2}))
		shake(2.4))
	tw.tween_property(moon, "scale", Vector3(10, 2, 10), 0.4)
	tw.tween_interval(1.0)
	tw.tween_property(moon, "scale", Vector3(10, 0.05, 10), 0.4)
	tw.tween_callback(moon.queue_free)
	Sfx.play("boom", goal, 0.3)
# ================================================================== Namikaze (Sarı Şimşek soyu): hız, üç kollu kunai, ışınlanma mühürleri
const NAMI := Color(1.0, 0.86, 0.3)


## Namikaze mührü taşıyan hedef (Işınlanma Mührü): klan teknikleri ona %35 fazla vurur
func _nm_marked(e: Node3D) -> bool:
	return live(e) and e.has_meta("nm_mark") and int(e.get_meta("nm_mark")) > Time.get_ticks_msec()


func _nm_mark(e: Node3D, sec: float) -> void:
	if not live(e):
		return
	var fresh = not _nm_marked(e)
	e.set_meta("nm_mark", Time.get_ticks_msec() + int(sec * 1000.0))
	if not fresh:
		return
	var lbl = Label3D.new()
	lbl.text = "飛"
	lbl.font_size = 120
	lbl.pixel_size = 0.005
	lbl.modulate = Color(0.1, 0.08, 0.05)
	lbl.outline_modulate = NAMI
	lbl.outline_size = 14
	lbl.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	lbl.position = Vector3.UP * 2.4
	e.add_child(lbl)
	get_tree().create_timer(sec).timeout.connect(func():
		if is_instance_valid(lbl):
			lbl.queue_free())


func _nm_inf(c: Node3D, e: Node3D, id: String, mul: float, extra := {}) -> Dictionary:
	return inf(c, id, mul * (1.35 if _nm_marked(e) else 1.0), extra)


## Altın ışık izi: geçilen yerde kısa süre kalan saydam sarı silüet şeritleri
func _nm_streak(a: Vector3, b: Vector3) -> void:
	var d = b - a
	if d.length() < 0.2:
		return
	stream_fx(a + Vector3.UP, d.normalized(), d.length(), 0.28, VFX.mat_trail(Color(1, 1, 0.85), NAMI, Color(1.0, 0.6, 0.1, 0.0), 1.0), 0.35)
	for k in 3:
		var p = a.lerp(b, (k + 1) / 4.0)
		var s = MeshInstance3D.new()
		var cm = CapsuleMesh.new()
		cm.radius = 0.32; cm.height = 1.8
		s.mesh = cm
		var m = StandardMaterial3D.new()
		m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		m.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
		m.albedo_color = Color(NAMI.r, NAMI.g, NAMI.b, 0.45 - k * 0.1)
		s.material_override = m
		get_tree().current_scene.add_child(s)
		s.global_position = p + Vector3.UP * 0.95
		var tw = s.create_tween()
		tw.tween_property(m, "albedo_color:a", 0.0, 0.35 + k * 0.08)
		tw.tween_callback(s.queue_free)


## Sarı Adım: göz açıp kapayana kadar 12 m ileri; hattaki düşmanlar kesilir
func p_namikaze_shunpo(c: Node3D, t: Node3D) -> void:
	busy(c, 0.35)
	var d = fwd(c, t)
	var start = c.global_position
	var end = gp(start + d * 12.0)
	_yellow_flash(start + Vector3.UP)
	_nm_streak(start, end)
	c.global_position = end
	_yellow_flash(end + Vector3.UP)
	for e in enemies_near(c, start.lerp(end, 0.5), 7.0):
		var p = e.global_position
		var ab = end - start
		var k = clampf((p - start).dot(ab) / ab.length_squared(), 0.0, 1.0)
		if (start + ab * k).distance_to(p) < 1.6:
			_arc_cut(p + Vector3.UP * 1.1, d, -50.0, 50.0, NAMI, 1.4)
			e.take_hit(_nm_inf(c, e, "namikaze_shunpo", 1.0, {"knock": 5.0, "kind": "light"}))
	Sfx.play("whoosh", c.global_position, 1.4)


## Kunai Yelpazesi: beş üç kollu kunai yelpaze halinde; isabet edene mühür kalır
func p_namikaze_sankunai(c: Node3D, t: Node3D) -> void:
	busy(c, 0.5)
	var tt = tg(c, t, 30.0)
	after(0.15, func():
		if not live(c):
			return
		var from = hand_pos(c, true)
		var base = aim_at(c, tt, from)
		for k in 5:
			var dd = base.rotated(Vector3.UP, deg_to_rad((k - 2) * 9.0))
			var pr = shot(c, from, dd, 42.0, _hira_kunai(), inf(c, "namikaze_sankunai", 0.55, {"knock": 2.0, "kind": "light", "bleed": 1.0}), null, false, 1.0, func(p, h):
				if h and live(h):
					_nm_mark(h, 15.0)
				VFX.star(p, NAMI, 0.8))
			_etrail(pr, "", NAMI, 0.15))
	Sfx.play("throw", c.global_position, 1.2)


## Işınlanma Mührü: avuçla vurulan mühür formülü; hedef 20 sn işaretli kalır
func p_namikaze_shiki(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 10.0)
	busy(c, 0.6)
	if tt == null:
		return
	_jump_at(c, tt, 0.2, 10.0)
	after(0.28, func():
		if not (live(c) and live(tt)):
			return
		var at = tt.global_position + Vector3.UP * 1.2
		_palm_flash(at, (tt.global_position - c.global_position).normalized())
		_script_ring(tt, 0.7, 2.0, NAMI.darkened(0.3))
		for k in 8:
			var a = k * TAU / 8.0
			VFX.bolt(at, at + Vector3(cos(a), sin(a) * 0.6, sin(a)) * 1.3, NAMI, 0.05, 0.2, 0)
		_nm_mark(tt, 20.0)
		tt.take_hit(inf(c, "namikaze_shiki", 0.8, {"knock": 4.0, "kind": "light"})))
	Sfx.play("seal", c.global_position, 1.1)


## Mühür Bariyeri: dört kunai yere saplanır; aralarında altın kare bariyer mermileri yutar, düşmanı dışarı iter
func p_namikaze_kekkai(c: Node3D, _t: Node3D) -> void:
	busy(c, 0.6)
	var center = c.global_position
	var R = 3.2
	var corners = []
	for k in 4:
		var a = PI * 0.25 + k * PI * 0.5
		var p = gp(center + Vector3(cos(a), 0, sin(a)) * R)
		corners.append(p)
		var ku = _hira_kunai()
		get_tree().current_scene.add_child(ku)
		ku.global_position = p + Vector3.UP * 0.25
		ku.rotation_degrees = Vector3(-90, 0, 0)
		get_tree().create_timer(7.0).timeout.connect(ku.queue_free)
	var walls = []
	for k in 4:
		var a = corners[k]
		var b = corners[(k + 1) % 4]
		var w = MeshInstance3D.new()
		var bm = BoxMesh.new()
		bm.size = Vector3(a.distance_to(b), 3.2, 0.04)
		w.mesh = bm
		var m = StandardMaterial3D.new()
		m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		m.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
		m.cull_mode = BaseMaterial3D.CULL_DISABLED
		m.albedo_color = Color(NAMI.r, NAMI.g * 0.9, 0.2, 0.0)
		w.material_override = m
		get_tree().current_scene.add_child(w)
		w.global_position = (a + b) * 0.5 + Vector3.UP * 1.6
		w.look_at(w.global_position + (b - a).cross(Vector3.UP), Vector3.UP)
		var tw = w.create_tween()
		tw.tween_property(m, "albedo_color:a", 0.14, 0.25)
		tw.tween_interval(6.0)
		tw.tween_property(m, "albedo_color:a", 0.0, 0.4)
		tw.tween_callback(w.queue_free)
		walls.append(w)
		VFX.bolt(a + Vector3.UP * 0.3, b + Vector3.UP * 0.3, NAMI, 0.08, 0.3, 1)
	every(6.5, 0.08, func(i, _k):
		for pr in get_tree().get_nodes_in_group("projectiles"):
			if pr.get("shooter") != c and Vector2(pr.global_position.x - center.x, pr.global_position.z - center.z).length() < R + 0.6:
				_yellow_flash(pr.global_position)
				pr.queue_free()
		if i % 4 == 0:
			for e in enemies_near(c, center, R + 0.3):
				var out = (e.global_position - center) * Vector3(1, 0, 1)
				if out.length() < 0.1:
					out = Vector3.FORWARD
				e.global_position = gp(center + out.normalized() * (R + 1.2))
				VFX.star(e.global_position + Vector3.UP, NAMI, 1.0)
				st(e, "stun", 0.3), Callable())
	Sfx.play("seal", center, 0.9)


## Sarı Hayalet: yerinde parlayan bir hayalet bırakıp en yakın düşmanın arkasında belirirsin
func p_namikaze_zanzou(c: Node3D, t: Node3D) -> void:
	busy(c, 0.4)
	var tt = tg(c, t, 22.0)
	var start = c.global_position
	decoy(c, start, 6.0, func(p: Vector3):
		_yellow_flash(p + Vector3.UP)
		for e in enemies_near(c, p, 3.5):
			st(e, "stun", 0.8)
			e.take_hit(inf(c, "namikaze_zanzou", 0.5, {"knock": 6.0, "kind": "light"})))
	_yellow_flash(start + Vector3.UP)
	if tt == null:
		var to0 = gp(start - fwd(c, t) * 6.0)
		_nm_streak(start, to0)
		c.global_position = to0
		return
	var behind = gp(tt.global_position + (tt.global_position - start).normalized() * 1.4)
	_nm_streak(start, behind)
	c.global_position = behind
	if c is Player:
		c.combat.face_to(tt)
	_yellow_flash(behind + Vector3.UP)
	after(0.1, func():
		if live(c) and live(tt):
			_arc_cut(tt.global_position + Vector3.UP * 1.1, (tt.global_position - behind).normalized(), -80.0, 80.0, NAMI, 1.8)
			tt.take_hit(_nm_inf(c, tt, "namikaze_zanzou", 1.4, {"knock": 9.0, "kind": "heavy", "bleed": 2.0})))
	Sfx.play("whoosh", c.global_position, 1.2)


## Uzay-Zaman Bariyeri: 4 sn sana gelen her mermi altın kapıda kaybolur ve atana geri fırlar
func p_namikaze_jikukan_kekkai(c: Node3D, _t: Node3D) -> void:
	busy(c, 0.3)
	var ring = MeshInstance3D.new()
	var tm = TorusMesh.new()
	tm.inner_radius = 1.5; tm.outer_radius = 1.65; tm.rings = 32
	ring.mesh = tm
	ring.material_override = VFX.mat_bolt(NAMI, 2.2)
	c.add_child(ring)
	ring.position = Vector3.UP * 1.0
	var tw = ring.create_tween().set_loops(8)
	tw.tween_property(ring, "rotation:y", TAU, 0.5).as_relative()
	get_tree().create_timer(4.0).timeout.connect(ring.queue_free)
	_script_ring(c, 1.3, 4.0, NAMI.darkened(0.2))
	every(4.0, 0.04, func(_i, _k):
		if not live(c):
			return
		for pr in get_tree().get_nodes_in_group("projectiles"):
			var sh = pr.get("shooter")
			if sh == c or pr.get("dead"):
				continue
			if pr.global_position.distance_to(c.global_position + Vector3.UP) < 2.6:
				var p0 = pr.global_position
				var dmg_info: Dictionary = pr.get("info") if pr.get("info") is Dictionary else {}
				_yellow_flash(p0)
				pr.queue_free()
				if live(sh):
					var from = gp(sh.global_position + (c.global_position - sh.global_position).normalized() * 6.0) + Vector3.UP * 1.2
					_yellow_flash(from)
					var back = shot(c, from, (sh.global_position + Vector3.UP - from).normalized(), 36.0, VFX.lightning_ball(0.35, NAMI), inf(c, "namikaze_jikukan_kekkai", maxf(1.0, float(dmg_info.get("mul", 1.0))), {"knock": 8.0, "kind": "heavy"}), sh, false, 1.0)
					_etrail(back, "", NAMI, 0.2), Callable())
	Sfx.play("seal", c.global_position, 1.3)


## Sarı Şimşek Serisi: hedefin etrafında sekiz yönden ışınlanarak sekiz kesik; işaretliyse son darbe havaya fırlatır
func p_namikaze_senko_rendan(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 14.0)
	busy(c, 1.3)
	if tt == null:
		_jump_at(c, null, 0.2, 10.0)
		return
	var marked = _nm_marked(tt)
	for k in 8:
		after(0.08 + k * 0.11, func():
			if not (live(c) and live(tt)):
				return
			var a = k * TAU / 8.0 * 3.0
			var prev = c.global_position
			var to = gp(tt.global_position + Vector3(cos(a), 0, sin(a)) * 1.4)
			_nm_streak(prev, to)
			c.global_position = to
			var dd = (tt.global_position - to).normalized()
			if c is Player:
				c.combat.face_to(tt)
			_arc_cut(tt.global_position + Vector3.UP * (0.8 + (k % 3) * 0.3), dd, -60.0 + k * 10.0, 60.0 + k * 10.0, NAMI, 1.5)
			VFX.star(tt.global_position + Vector3.UP, NAMI, 1.0)
			tt.take_hit(_nm_inf(c, tt, "namikaze_senko_rendan", 0.42, {"knock": 1.5, "kind": "light", "hitstop": 0.03})))
	after(0.08 + 8 * 0.11 + 0.05, func():
		if not (live(c) and live(tt)):
			return
		_yellow_flash(tt.global_position + Vector3.UP)
		impact_fx("", NAMI, tt.global_position + Vector3.UP, 1.4 if marked else 1.0)
		tt.take_hit(inf(c, "namikaze_senko_rendan", 1.6 if marked else 0.9, {"knock": 14.0, "launch": 7.0 if marked else 0.0, "kind": "heavy", "hitstop": 0.12}))
		shake(0.5))
	Sfx.play("blade", c.global_position, 1.4)


## Sarı Şimşek Fırtınası: on iki kunai alana yağar; kunaiden kunaiye ışınlanıp aradaki her şeyi biçersin
func p_namikaze_kiiro_senko(c: Node3D, t: Node3D) -> void:
	busy(c, 2.2)
	var tt = tg(c, t, 30.0)
	var at = gp(tt.global_position if tt else Jutsu._aim_ground(c, t, 12.0, 24.0))
	var start = c.global_position
	var pts = []
	var kunais = []
	for k in 12:
		var a = k * TAU / 12.0 + randf_range(-0.15, 0.15)
		var r = 6.0 if k % 2 == 0 else 3.2
		var p = gp(at + Vector3(cos(a), 0, sin(a)) * r)
		pts.append(p)
		var ku = _hira_kunai()
		get_tree().current_scene.add_child(ku)
		ku.global_position = c.global_position + Vector3.UP * 2.0
		ku.look_at(p, Vector3.UP)
		var tw = ku.create_tween()
		tw.tween_interval(k * 0.03)
		tw.tween_property(ku, "global_position", p + Vector3.UP * 0.3, 0.3)
		kunais.append(ku)
	summon_circle(at, 6.5, NAMI, 2.2)
	var order = [0, 5, 10, 3, 8, 1, 6, 11, 4, 9, 2, 7]
	for i in order.size():
		after(0.5 + i * 0.09, func():
			if not live(c):
				return
			var prev = c.global_position
			var to = pts[order[i]]
			_nm_streak(prev, to)
			VFX.bolt(prev + Vector3.UP, to + Vector3.UP, NAMI, 0.1, 0.25, 1)
			c.global_position = to
			_yellow_flash(to + Vector3.UP)
			var d = (to - prev) * Vector3(1, 0, 1)
			for e in enemies_near(c, prev.lerp(to, 0.5), d.length() * 0.5 + 1.5):
				var p = e.global_position
				var kk = clampf((p - prev).dot(d) / maxf(d.length_squared(), 0.01), 0.0, 1.0)
				if (prev + d * kk).distance_to(p) < 1.8:
					_arc_cut(p + Vector3.UP * 1.1, d.normalized(), -60.0, 60.0, NAMI, 1.5)
					e.take_hit(_nm_inf(c, e, "namikaze_kiiro_senko", 0.5, {"knock": 3.0, "kind": "light", "bleed": 1.0}))
			if is_instance_valid(kunais[order[i]]):
				kunais[order[i]].queue_free())
	after(0.5 + order.size() * 0.09 + 0.1, func():
		if not live(c):
			return
		_nm_streak(c.global_position, at)
		c.global_position = at
		VFX.shockwave(at + Vector3.UP * 0.2, NAMI, 13.0, 0.4)
		impact_fx("", NAMI, at + Vector3.UP, 2.4)
		hit(c, at + Vector3.UP, 6.5, inf(c, "namikaze_kiiro_senko", 1.8, {"knock": 16.0, "launch": 5.0, "kind": "heavy", "hitstop": 0.15}))
		shake(1.0)
		after(0.35, func():
			if live(c) and start.distance_to(at) < 40.0:
				_nm_streak(c.global_position, start)
				c.global_position = start
				_yellow_flash(start + Vector3.UP)))
	Sfx.play("throw", c.global_position, 1.0)
	after(0.5, func(): Sfx.play("blade", at, 1.4))
# ================================================================== Yeni klanlar 3: Yūhi (orman illüzyonları) / Gekkō (ay kılıcı) / Mitarashi (yılanlar) / Shiranui (senbon)
const YUHI := Color(0.9, 0.25, 0.42)
const GEKKO := Color(0.78, 0.88, 1.0)
const MITA := Color(0.5, 0.3, 0.62)
const SHIRA := Color(0.86, 0.88, 0.93)


## Yūhi: hedefin üstünde dönen kırmızı illüzyon halkası (genjutsu altında olduğunu gösterir)
func _yh_daze(e: Node3D, dur: float) -> void:
	if not live(e):
		return
	var r = MeshInstance3D.new()
	var tm = TorusMesh.new()
	tm.inner_radius = 0.42; tm.outer_radius = 0.5; tm.rings = 24
	r.mesh = tm
	r.material_override = VFX.mat_spiral(Color(1.0, 0.7, 0.8), YUHI, 4.0, 2.0, 5.0, 1.2, Vector3.UP)
	e.add_child(r)
	r.position = Vector3.UP * 2.3
	var tw = r.create_tween().set_loops(int(dur / 0.6) + 1)
	tw.tween_property(r, "rotation:y", TAU, 0.6).as_relative()
	get_tree().create_timer(dur).timeout.connect(func():
		if is_instance_valid(r):
			r.queue_free())


## Yūhi: yerden kıvrılarak yükselen sarmaşık (genjutsu ağacı)
func _yh_vine(at: Vector3, h: float, dur: float) -> void:
	var root = Node3D.new()
	scene_add(root, at)
	var n = 7
	for k in n:
		var seg = _branch(h / n * 1.4, 0.13 * (1.0 - k / float(n)) + 0.03)
		root.add_child(seg)
		var a = k * 0.9
		seg.position = Vector3(cos(a) * 0.35, h / n * (k + 0.5), sin(a) * 0.35)
		seg.rotation = Vector3(sin(a) * 0.4, a, cos(a) * 0.4)
		if k % 2 == 1:
			var leaf = MeshInstance3D.new()
			leaf.mesh = SphereMesh.new()
			leaf.material_override = Props.toon_color(Color(0.2, 0.45, 0.2))
			leaf.scale = Vector3(0.28, 0.05, 0.16)
			seg.add_child(leaf)
			leaf.position = Vector3(0.12, 0, 0)
	root.scale = Vector3(1, 0.05, 1)
	var tw = root.create_tween()
	tw.tween_property(root, "scale", Vector3.ONE, 0.35).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tw.tween_interval(maxf(0.1, dur - 0.7))
	tw.tween_property(root, "scale", Vector3(1, 0.05, 1), 0.35)
	tw.tween_callback(root.queue_free)


## Yūhi: kırmızı çiçek (beş taç yaprak + sarı göbek)
func _yh_flower(at: Vector3, s: float, dur: float) -> Node3D:
	var root = Node3D.new()
	scene_add(root, at)
	for k in 6:
		var a = k * TAU / 6.0
		var p = MeshInstance3D.new()
		p.mesh = SphereMesh.new()
		p.material_override = Props.toon_color(YUHI if k % 2 == 0 else YUHI.lightened(0.2))
		root.add_child(p)
		p.position = Vector3(cos(a), 0.15, sin(a)) * 0.55
		p.rotation = Vector3(0, -a, 0.35)
		p.scale = Vector3(0.6, 0.08, 0.32)
	var core = MeshInstance3D.new()
	core.mesh = SphereMesh.new()
	core.material_override = glow(Color(1.0, 0.85, 0.3), 1.0)
	root.add_child(core)
	core.position = Vector3.UP * 0.2
	core.scale = Vector3.ONE * 0.3
	root.scale = Vector3.ONE * 0.05
	var tw = root.create_tween()
