func _splash(at: Vector3, s := 1.0) -> void:
	VFX.puffs(at, {"amount": int(30 * s), "life": 0.6, "size": 0.35 * s, "radius": 0.4 * s, "vmin": 3 * s, "vmax": 8 * s, "dir": Vector3.UP, "spread": 70.0, "add": false,
