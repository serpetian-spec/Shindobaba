## Kiraz Çiçeği Darbesi: havaya sıçrar, yumruğunda çakra parlar, iner — zemin örümcek ağı gibi çatlar, kayalar fırlar, toz halkası, ekran sarsılır
func p_okasho(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 10.0)
	var d = _jump_at(c, tt, 7.0, 8.0 if tt else 2.0)
	busy(c, 1.0)
	anim(c, "air", 1.0)
	var pink = Color(1, 0.6, 0.75)
	every(0.45, 0.05, func(_i, _k):
		if live(c):
			FX.burst(hand_pos(c, true), {"amount": 3, "life": 0.25, "tex": FX.tex_spark, "add": true, "size": 0.25, "radius": 0.1, "vmin": 0.5, "vmax": 1.5,
				"colors": [Color(1, 1, 1, 1), pink, Color(pink.r, pink.g, pink.b, 0)]}), Callable())
	after(0.45, func():
		if not live(c):
			return
		anim(c, "cross", 1.2)
		if c is CharacterBody3D:
			c.velocity = Vector3.DOWN * 20.0
		after(0.12, func():
			var at = gp(c.global_position + d * 0.6)
			melee_fx(c, at + Vector3.UP * 0.4, pink, 1.8, true)
			VFX.cracks(at, 9.0, Color(0.1, 0.07, 0.05, 0.95), 8.0)
			for r in [4.0, 8.0, 12.0]:
				VFX.shockwave(at + Vector3.UP * 0.1, Color(0.85, 0.75, 0.6), r, 0.5, true)
			for k in 12:
				var q = at + Vector3(randf_range(-6, 6), 0, randf_range(-6, 6))
				var rk = _rock(randf_range(0.6, 1.3))
				get_tree().current_scene.add_child(rk)
				rk.global_position = gp(q) - Vector3.UP * 0.6
				rk.rotation = Vector3(randf_range(-0.6, 0.6), randf() * TAU, randf_range(-0.6, 0.6))
				var tw = rk.create_tween()
				tw.tween_property(rk, "global_position", gp(q) + Vector3.UP * randf_range(0.3, 1.2), 0.1)
				tw.tween_interval(3.0)
				tw.tween_property(rk, "global_position", gp(q) - Vector3.UP * 1.5, 0.6)
				tw.tween_callback(rk.queue_free)
			VFX.debris(at, EARTH, 50, 13.0, 0.7)
			VFX.smoke_ring(at + Vector3.UP * 0.1, 8.0, Color(0.6, 0.52, 0.42))
			shake(1.2)
			hit(c, at + Vector3.UP, 6.5, inf(c, "okasho", 2.2, {"knock": 18.0, "launch": 9.0, "kind": "heavy", "hitstop": 0.1}))
			Sfx.play("boom", at, 0.8)))


## Akış (su seli / rüzgâr seli): ağızdan büyüyerek uzanan, akan dokulu koni; uçta sıçrama/toz; dur sonra söner
func stream_fx(from: Vector3, d: Vector3, length: float, radius: float, mat: Material, dur: float, end_fx := Callable()) -> void:
	# rüzgâr: saydam koni yerine organik hamle (akım çizgileri, toz, yaprak) — görünür şekil yok
	if mat is ShaderMaterial and mat.shader != null and mat.shader.resource_path.ends_with("vfx_wind.gdshader"):
		var tint: Color = mat.get_shader_parameter("tint")
		var dusty = tint.b < tint.r - 0.1   # kumlu/toprak tonlu rüzgâr (Ressenpū, Mugen Sajin): bol toz
		WindFX.gust(from, d.normalized(), length, radius * 2.0, {"n": int(clampf(8 + radius * 3.0, 10, 26)), "dust": Color(tint.r, tint.g, tint.b) if dusty else null,
			"speed": maxf(30.0, length / maxf(0.3, dur * 0.8))})
		if dur > 0.5:
			after(dur * 0.45, func(): WindFX.gust(from, d.normalized(), length, radius * 2.0, {"n": int(clampf(6 + radius * 2.0, 8, 18)), "leaves": false, "dust": false}))
		if end_fx.is_valid():
			after(0.22, func(): end_fx.call(from + d * length))
		return
	if mat is ShaderMaterial and mat.shader != null and mat.shader.resource_path.ends_with("vfx_water.gdshader"):
		# su: saydam koni yerine akan su ipleri (ince su tüpleri) + uçta sıçrama
		var dn2 = d.normalized()
		var sd = dn2.cross(Vector3.UP).normalized()
		var n2 = clampi(int(radius * 1.5), 2, 5)
		var mc: Color = mat.get_shader_parameter("c_mid")
		var oily = mc.r > mc.b + 0.2   # kurbağa yağı / çamur: mavi su sıçraması ve mavi gölcük bırakmasın
		if oily:
			# lav seli (kızıl) / Mei'nin bej aşındırıcı çamuru / kurbağa yağı: kalın, kesintisiz, ağır yapışkan sıvı tüpleri,
			# yay çizip düşer, gövdeden ağır parçalar kopar (ateş/duman partikülü yok), uçta sıvının kendisi sıçrar
			var gkind = "molten" if mc.g < 0.6 else ("mei" if mc.b > 0.4 else "oil")
			# lav seli (anime Mei'nin lav duvarı / lav seli): kalın, kesintisiz, kızıl tabanlı sarı erimiş hücreli tüpler;
			# ağırlıkla yay çizip düşer, damlalar, kor, beyaz buhar
			var ln = clampi(int(radius * 1.2), 2, 4)
			for i in ln:
				var off = (i - (ln - 1) * 0.5) * radius * 0.4
				var lh = Node3D.new()
				scene_add(lh, from + sd * off * 0.3)
				var lb = VfxSerpent.new()
				lb.style = "lava" if gkind == "molten" else "goo"
				lb.thin = 1.0
				lb.head = lh
				lb.count = 14
				lb.spacing = maxf(0.5, length / 15.0)
				lb.radius = maxf(0.45, radius * 0.45)
				lb.mat = VFX.lava_mat(gkind, true)
				get_tree().current_scene.add_child(lb)
				var lend = from + dn2 * length + sd * off
				var lmid = from.lerp(lend, 0.5) + Vector3.UP * length * 0.12
				var ltw = lh.create_tween()
				ltw.tween_method(func(u: float):
					if is_instance_valid(lh):
						lh.global_position = from.lerp(lmid, u).lerp(lmid.lerp(lend, u), u), 0.0, 1.0, maxf(0.25, dur * 0.65))
				ltw.tween_callback(func():
					VFX.lava_splash(lend, 1.0 + radius * 0.35, gkind)
					lh.queue_free())
			if end_fx.is_valid():
				after(maxf(0.25, dur * 0.65), func(): end_fx.call(from + dn2 * length))
			return
		if oily:
			# kurbağa yağı / çamur / Mei'nin aşındırıcı lav çamuru: su tüpü değil — kendi renginde ağır, yapışkan topaklardan akıntı
			var lava = false
			var dd = d.normalized()
			every(maxf(0.3, dur * 0.8), 0.04, func(_i, _k):
				for q in 3:
					var u = randf() * 0.25
					VFX.puffs(from + dd * (0.4 + u * length), {"amount": 2, "life": 0.6, "size": 0.5 + radius * 0.35, "radius": radius * 0.3, "vmin": length * 0.9, "vmax": length * 1.25,
						"dir": (dd + Vector3.UP * 0.12).normalized(), "spread": 6.0 + radius * 2.0, "gravity": Vector3(0, -9.0, 0), "damp": 1.2, "glow": 1.2 if lava else 1.05, "hot": 0.6 if lava else 0.3,
						"outline_col": Color(0.18, 0.03, 0.01) if lava else mc.darkened(0.55), "outline": 0.05, "rough": 0.2, "shade": 0.35,
						"colors": ([Color(1.0, 0.82, 0.3, 1), Color(1.0, 0.38, 0.05, 1), Color(0.5, 0.08, 0.02, 0.95), Color(0.15, 0.03, 0.01, 0.0)] if lava else [mc.lightened(0.25), mc, mc.darkened(0.35), Color(mc.r * 0.4, mc.g * 0.3, mc.b * 0.3, 0.0)]), "scale_curve": [[0.0, 0.4], [0.3, 1.0], [1.0, 1.3]]})
				if lava and _i % 3 == 0:
					VFX.embers(from + dd * length * 0.5, Color(1.0, 0.45, 0.1), 5, radius * 2.0, 0.6), Callable())
			after(0.45, func():
				var end = from + dd * length
				if lava:
					VFX.lava_splash(end, 1.0 + radius * 0.4)
				else:
					VFX.puffs(end, {"amount": 10, "life": 0.5, "size": 0.6 + radius * 0.2, "radius": 0.6, "vmin": 1.5, "vmax": 4.0, "dir": Vector3.UP, "spread": 60.0, "gravity": Vector3(0, -9.0, 0),
						"rough": 0.12, "outline": 0.04, "outline_col": mc.darkened(0.5), "colors": [mc.lightened(0.2), mc, Color(mc.r, mc.g, mc.b, 0.0)]})
				if end_fx.is_valid():
					end_fx.call(end))
			return
		for i in n2:
			var off = (i - (n2 - 1) * 0.5) * radius * 0.45
			var head = Node3D.new()
			scene_add(head, from + sd * off * 0.3)
			var body = VfxSerpent.new()
			body.style = "water"
			body.thin = 1.0
			body.head = head
			body.count = 12
			body.spacing = maxf(0.5, length / 14.0)
			body.radius = maxf(0.3, radius * 0.35)
			body.mat = mat
			get_tree().current_scene.add_child(body)
			var tw = head.create_tween()
			var end = from + dn2 * length + sd * off
			tw.tween_property(head, "global_position", end, maxf(0.2, dur * 0.6)).set_trans(Tween.TRANS_SINE)
			tw.tween_callback(func():
				if oily:
					VFX.puffs(end, {"amount": 8, "life": 0.5, "size": 0.6 + radius * 0.2, "radius": 0.5, "vmin": 1.5, "vmax": 4.0, "dir": Vector3.UP, "spread": 60.0, "gravity": Vector3(0, -9.0, 0),
						"rough": 0.12, "outline": 0.03, "outline_col": mc.darkened(0.5), "colors": [mc.lightened(0.2), mc, Color(mc.r, mc.g, mc.b, 0.0)]})
				else:
					VFX.splash(end, 1.0 + radius * 0.4)
				head.queue_free())
		if end_fx.is_valid():
			after(0.22, func(): end_fx.call(from + d * length))
		return
	if mat is ShaderMaterial and mat.shader != null and mat.shader.resource_path.ends_with("vfx_bolt.gdshader"):
		var bc: Color = mat.get_shader_parameter("col")
		var dn = d.normalized()
		var waves = maxi(1, int((dur + 0.2) / 0.08))
		for w in waves:
			after(w * 0.08, func():
				for k in 3:
					var off = Vector3(randf_range(-1, 1), randf_range(-1, 1), randf_range(-1, 1)) * radius * 0.35
					VFX.bolt(from + off * 0.3, from + dn * length + off, bc, radius * 0.12 * (1.6 if k == 0 else 0.8), 0.1, 3))
		FX.burst(from, {"amount": int(20 + length), "life": 0.35, "tex": FX.tex_spark, "size": 1.2, "vmin": length * 1.5, "vmax": length * 2.5, "dir": dn, "spread": 12.0,
			"colors": [Color(1, 1, 1, 1), bc.lightened(0.4), Color(bc.r, bc.g, bc.b, 0)]})
		if end_fx.is_valid():
			after(0.22, func(): end_fx.call(from + d * length))
		return
	var root = Node3D.new()
	get_tree().current_scene.add_child(root)
	root.global_position = from
	root.look_at(from + d, Vector3.UP if absf(d.y) < 0.95 else Vector3.RIGHT)
	var cm = CylinderMesh.new()
	cm.top_radius = 0.25; cm.bottom_radius = radius; cm.height = length; cm.radial_segments = 24; cm.rings = 6
	var mi = MeshInstance3D.new()
	mi.mesh = cm
	mi.material_override = mat
	mi.rotation_degrees = Vector3(-90, 0, 0)
	mi.position = Vector3(0, 0, -length * 0.5)
	root.add_child(mi)
	var inner = MeshInstance3D.new()
	var cm2 = CylinderMesh.new()
	cm2.top_radius = 0.15; cm2.bottom_radius = radius * 0.6; cm2.height = length * 0.95; cm2.radial_segments = 16
	inner.mesh = cm2
	inner.material_override = mat
	inner.rotation_degrees = Vector3(-90, 0, 0)
	inner.position = Vector3(0, 0, -length * 0.48)
	root.add_child(inner)
	root.scale = Vector3(1, 1, 0.05)
	var tw = root.create_tween()
	tw.tween_property(root, "scale", Vector3.ONE, 0.22).set_trans(Tween.TRANS_QUAD)
	tw.tween_interval(dur)
	tw.tween_property(root, "scale", Vector3(0.05, 0.05, 1), 0.3)
	tw.tween_callback(root.queue_free)
	if end_fx.is_valid():
		after(0.22, func(): end_fx.call(from + d * length))


func _wmat() -> Material:
	return VFX.mat_water(Color(0.05, 0.28, 0.78), Color(0.2, 0.55, 0.98), Color(0.62, 0.88, 1.0), Vector3(0, 1, 0), 0.9, 0.7, 0.1)


func _windmat(alpha := 0.7) -> Material:
