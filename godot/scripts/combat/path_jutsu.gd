## Kristal Zırh: bedeni pembe kristal plakalar kaplar (15 sn) — darbeler kristalde kırılır
func p_kessho_no_yoroi(c: Node3D, _t: Node3D) -> void:
	busy(c, 0.6)
	var parts = []
	for bone in ["UpperChest", "LeftLowerArm", "RightLowerArm", "LeftUpperLeg", "RightUpperLeg", "LeftHand", "RightHand"]:
		var ba = bone_attach(c, bone)
		if ba == null:
			continue
		# ref (Guren): yumruğu ve ön kolu saran, dışa doğru yüzlü kristal plakalar (kutu değil)
		var b = MB.new()
		var big = bone == "UpperChest"
		var n = 5 if bone in ["LeftHand", "RightHand", "LeftLowerArm", "RightLowerArm"] else 3
		for k in n:
			var a = k * TAU / n + randf() * 0.4
			var o = Vector3(cos(a), 0, sin(a)) * (0.13 if big else 0.07)
			b.add("cone", o + Vector3(0, 0.08 + k * 0.03, 0), Vector3(0.14, 0.28, 0.1) * (1.6 if big else 1.0), PINKCRYSTAL.lightened(randf() * 0.2), Vector3(randf_range(-30, 30), -rad_to_deg(a), rad_to_deg(atan2(o.x, 0.2)) * 0.8), 4)
		var mi = mesh_of(b, _crystal_mat(PINKCRYSTAL))
		ba.add_child(mi)
		mi.scale = Vector3.ONE * 0.1
		mi.create_tween().tween_property(mi, "scale", Vector3.ONE, 0.3).set_trans(Tween.TRANS_BACK)
		parts.append(ba)
	FX.burst(c.global_position + Vector3.UP, {"amount": 30, "life": 0.6, "tex": FX.tex_spark, "add": true, "size": 0.25, "vmin": 2, "vmax": 6, "colors": [Color(1, 1, 1, 1), PINKCRYSTAL, Color(PINKCRYSTAL.r, PINKCRYSTAL.g, PINKCRYSTAL.b, 0)]})
	if c is Player:
		Buffs.add("kessho_yoroi", 15.0, {"armor": 0.7, "melee": 1.15, "_name": "Kristal Zırh", "_desc": "kristal plakalar: gelen hasar çok azalır, yumruklar sertleşir"})
	after(15.0, func():
		for pp in parts:
			if is_instance_valid(pp):
				pp.queue_free())
	Sfx.play("clink", c.global_position, 1.0)


