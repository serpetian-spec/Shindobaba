				VFX.shockwave(c.global_position + Vector3.UP * 1.6, Color(0.6, 1.0, 0.6), 3.0 + k, 0.4, false))
	after(1.2, func():
		for pp in parts:
			if is_instance_valid(pp):
				pp.queue_free())
