	for k in 6:
		var br = _wood_branch(randf_range(3.0, 4.5), 0.3)
		br.position = Vector3(0, 3.5 + k * 0.9, 0)
		br.rotation = Vector3(randf_range(0.7, 1.1), k * 1.1 + randf() * 0.4, 0)
		br.translate_object_local(Vector3.UP * 1.8)
