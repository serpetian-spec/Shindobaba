## Erken Kurban: hedefi yakalar, havaya kaldırıp sırtüstü yere çakar
func p_hayanie(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 4.0)
	busy(c, 0.8)
	_face(c, tt)
	anim(c, "push", 1.4)
	if tt == null:
		return
	st(tt, "stun", 1.2)
	var y0 = tt.global_position
	var tw = tt.create_tween()
