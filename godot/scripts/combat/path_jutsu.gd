				"colors": [Color(1, 0.6, 0.2, 0.8), Color(0.4, 0.15, 0.05, 0)]})
			e.take_hit(inf(c, "amenominaka", 0.15, {"knock": 0.0, "kind": "light", "element": "yoton", "burn": 1.0})), Callable())
