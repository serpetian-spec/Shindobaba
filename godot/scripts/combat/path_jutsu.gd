		tether(func(): return c.global_position + Vector3.UP * 1.6 if is_instance_valid(c) else Vector3.ZERO, func(): return tt.global_position + Vector3.UP * 1.6 if is_instance_valid(tt) else Vector3.ZERO, 0.08, VFX.mat_bolt(MIND, 2.0), 0.6)
		for k in 6:
			after(k * 0.08, func():
				if live(tt):
					VFX.shockwave(tt.global_position + Vector3.UP * 1.6, MIND, 1.5 + k * 0.5, 0.3, false)
					VFX.debris(tt.global_position + Vector3.UP * 1.6, MIND, 6, 4.0, 0.15))
		if c is Player:
			VFX.screen_lines(0.4, 1.0, MIND)
		st(tt, "stun", 3.0)
		tt.take_hit(inf(c, "yamanaka_shinkaitai", 2.6, {"knock": 0.0, "kind": "heavy", "chakra_drain": 20.0, "hitstop": 0.12})))
	Sfx.play("genjutsu", c.global_position, 0.8)


func p_aburame_mushi_hashira(c: Node3D, t: Node3D) -> void:
	# Mushi Bashira: hedeflerin altından kara böcek sütunları fışkırır, onları içine alıp yukarı taşır, chakralarını emer
	busy(c, 1.0)
	var targets = enemies_near(c, c.global_position, 18.0).slice(0, 4)
	var tt = tg(c, t, 18.0)
	if tt and not targets.has(tt):
		targets.append(tt)
	_bug_cloud(hand_pos(c, true), 0.4, 40, fwd(c, t), 5.0)
	for e in targets:
		var at0 = gp(e.global_position)
		# önce yerde kaynayan kara leke (böcekler toprağın altından geliyor)
		ground_disc(at0, 2.4, Color(0.05, 0.05, 0.04), 2.8, 2, 0)
		_bug_cloud(at0 + Vector3.UP * 0.2, 1.4, 50, Vector3.UP, 1.5)
		after(0.35, func():
			if not live(e):
				return
			var at = gp(e.global_position)
			# sütun: dönen kara gövde (rüzgâr malzemesi koyu) + içinde kaynayan sürü
			var col = MeshInstance3D.new()
			var cm = CylinderMesh.new()
			cm.top_radius = 1.6
			cm.bottom_radius = 2.2
			cm.height = 9.0
			col.mesh = cm
			var cmat = StandardMaterial3D.new()   # kaynayan kara sürü gövdesi (eklemeli değil, koyu)
			cmat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
			cmat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
			cmat.albedo_color = Color(0.06, 0.06, 0.05, 0.8)
			col.material_override = cmat
			get_tree().current_scene.add_child(col)
			col.global_position = at + Vector3.UP * 4.5
			col.scale = Vector3(1, 0.05, 1)
			var ctw = col.create_tween()
			ctw.tween_property(col, "scale", Vector3.ONE, 0.3).set_trans(Tween.TRANS_BACK)
			ctw.tween_interval(1.8)
			ctw.tween_property(col, "scale", Vector3(1.8, 1.0, 1.8), 0.4)
			ctw.parallel().tween_property(cmat, "albedo_color:a", 0.0, 0.4)
			ctw.tween_callback(col.queue_free)
			for k in 12:
				after(k * 0.06, func():
					_bug_cloud(at + Vector3.UP * k * 0.75, 1.3, 36, Vector3.UP, 4.0))
			VFX.debris(at + Vector3.UP * 0.4, EARTH, 8, 7.0, 0.4)
			VFX.cracks(at, 4.0)
			st(e, "bind", 2.2)
			var lift = e.create_tween()
			lift.tween_property(e, "global_position", at + Vector3.UP * 3.0, 0.5).set_trans(Tween.TRANS_QUAD)
			every(2.0, 0.4, func(_i, _k):
				if live(e):
					e.take_hit(inf(c, "aburame_mushi_hashira", 0.3, {"knock": 0.0, "kind": "light", "chakra_drain": 6.0}))
					chakra_gain(c, 2.0)
					_bug_cloud(e.global_position + Vector3.UP, 1.0, 20, Vector3.UP, 3.0), Callable())
			after(2.3, func():   # sürü dağılır, hedef düşer
				_bug_cloud(at + Vector3.UP * 3.0, 3.0, 80, Vector3.UP, 6.0)))
	Sfx.play("wind", c.global_position, 2.0, 0.6)


func p_inuzuka_sototoro(c: Node3D, t: Node3D) -> void:
	# Sōtōrō: dev iki başlı beyaz kurda dönüşür, kükrer, sıçrar ve iki dev dönen hortuma (Garōga) dönüşüp hedefi oyar
	busy(c, 2.2)
	var tt = tg(c, t, 30.0)
	var d = fwd(c, t)
	var at = gp(c.global_position)
	FX.smoke_puff(at + Vector3.UP * 1.0, 1.6, 14)   # kısa dönüşüm dumanı (kurt görünsün)
	VFX.shockwave(at + Vector3.UP * 0.2, Color(0.9, 0.9, 0.92), 12.0, 0.5)
	var wolf = Node3D.new()
	get_tree().current_scene.add_child(wolf)
	var mdl: Node3D = SummonModels.build("wolf_giant", 4.4, 7.0)["root"]
	wolf.add_child(mdl)
	wolf.global_position = at
	wolf.rotation.y = atan2(-d.x, -d.z)
	if c.get("model"):
		c.model.visible = false
	Sfx.play("roar", at, 0.7)
	shake(1.0)
	# kükreme: önüne doğru savrulan toz ve şok dalgası
	after(0.35, func():
		VFX.shockwave(at + d * 5.0 + Vector3.UP * 3.0, Color(0.95, 0.95, 0.95), 10.0, 0.45, false)
		VFX.puffs(at + d * 4.0 + Vector3.UP, {"amount": 30, "life": 0.9, "size": 1.8, "radius": 2.5, "vmin": 6, "vmax": 12, "dir": d, "spread": 35.0, "add": false,
			"colors": [Color(0.85, 0.8, 0.72, 0.0), Color(0.85, 0.8, 0.72, 0.9), Color(0.8, 0.75, 0.68, 0)]}))
	var goal = gp(tt.global_position if tt and live(tt) else at + d * 18.0)
	var tw = wolf.create_tween()
	tw.tween_interval(1.1)
	tw.tween_property(wolf, "global_position", at + d * 3.0 + Vector3.UP * 4.0, 0.3).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	tw.tween_callback(func():
		# Garōga: kurt iki dev matkap hortuma dönüşür
		FX.smoke_puff(wolf.global_position + Vector3.UP * 2.0, 3.0, 30)
		wolf.visible = false
		var side = d.cross(Vector3.UP).normalized()
		for sx in [-1.0, 1.0]:
			var drill = Node3D.new()
			var cone = MeshInstance3D.new()
			var cm = CylinderMesh.new()
			cm.top_radius = 0.3
			cm.bottom_radius = 3.0
			cm.height = 8.5
			cone.mesh = cm
			cone.material_override = VFX.mat_spiral(Color(0.97, 0.97, 1.0), Color(0.58, 0.55, 0.52), 4.0, 6.0, 14.0, 1.1, Vector3.UP)   # matkap gövdesi: dönen sarmal çizgiler
			cone.rotation.x = -PI * 0.5
			drill.add_child(cone)
			var shell = MeshInstance3D.new()
			var cm2 = CylinderMesh.new()
			cm2.top_radius = 0.8
			cm2.bottom_radius = 4.0
			cm2.height = 7.5
			shell.mesh = cm2
			shell.material_override = VFX.mat_wind(Color(0.7, 0.66, 0.6), 9.0, 4.0, Vector3.UP, 0.65)
			shell.rotation.x = -PI * 0.5
			drill.add_child(shell)
			get_tree().current_scene.add_child(drill)
			var start = wolf.global_position + side * sx * 2.2
			drill.global_position = start
			drill.look_at(goal + Vector3.UP * 1.5 + side * sx * 1.2, Vector3.UP)
			VFX.trail(drill, 2.2, Color(1, 1, 1, 0.8), Color(0.8, 0.78, 0.74, 0.5), Color(0.7, 0.66, 0.6, 0.0), 14)
			drill.create_tween().set_loops(8).tween_property(cone, "rotation:z", TAU, 0.12).as_relative()
			var dtw = drill.create_tween()
			dtw.tween_method(func(u: float):
				if not is_instance_valid(drill):
					return
				var p = start.lerp(goal + Vector3.UP * 1.5 + side * sx * 1.2, u)
				drill.global_position = p
				VFX.puffs(p, {"amount": 3, "life": 0.6, "size": 1.6, "radius": 2.2, "vmin": 2, "vmax": 6, "add": false, "spin": 200.0,
					"colors": [Color(0.8, 0.76, 0.7, 0.0), Color(0.82, 0.78, 0.72, 0.85), Color(0.75, 0.7, 0.64, 0)]})
				if randf() < 0.5:   # yolunu oyar
					var g2 = gp(p)
					VFX.debris(g2 + Vector3.UP * 0.3, EARTH, 2, 9.0, 0.5)
					if randf() < 0.25:
						VFX.cracks(g2, 3.0, Color(0.1, 0.07, 0.05, 0.85), 6.0)
				hit(c, p, 3.0, inf(c, "inuzuka_sototoro", 0.25, {"knock": 8.0, "kind": "light", "bleed": 2.0})), 0.0, 1.0, 0.75)
			dtw.tween_callback(func():
				FX.smoke_puff(drill.global_position, 2.0, 20)
				drill.queue_free())
		shake(1.2)
		Sfx.play("wind", wolf.global_position, 0.7))
	tw.tween_interval(0.85)
	tw.tween_callback(func():
		impact_fx("doton", EARTH, goal + Vector3.UP, 2.8)
		VFX.cracks(goal, 12.0)
		VFX.shockwave(goal + Vector3.UP * 0.3, Color(0.95, 0.95, 0.95), 22.0, 0.6)
		hit(c, goal + Vector3.UP, 6.0, inf(c, "inuzuka_sototoro", 2.4, {"knock": 26.0, "launch": 8.0, "kind": "heavy", "bleed": 4.0, "hitstop": 0.15}))
		shake(1.6)
		if live(c):
			FX.smoke_puff(goal + Vector3.UP * 1.5, 2.0, 20)
			c.global_position = gp(goal - d * 3.0)
			if c.get("model"):
				c.model.visible = true
		wolf.queue_free())


func p_kaguya_hone_tate(c: Node3D, _t: Node3D) -> void:
	busy(c, 0.6)
	_kaguya_dots(c, 6.0)
	var root = Node3D.new()
	c.add_child(root)
	root.position = Vector3.UP * 1.0
	for k in 16:
		var a = k * TAU / 16.0
		var plate = MeshInstance3D.new()
		var cm = CylinderMesh.new()
		cm.top_radius = 0.0; cm.bottom_radius = 0.35; cm.height = 2.6; cm.radial_segments = 5
		plate.mesh = cm
		var m = StandardMaterial3D.new()
		m.albedo_color = BONE
		plate.material_override = m
		root.add_child(plate)
		plate.position = Vector3(cos(a) * 1.4, 0, sin(a) * 1.4)
		plate.rotation = Vector3(sin(a) * 0.5, 0, -cos(a) * 0.5)
