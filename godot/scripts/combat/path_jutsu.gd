## Rüzgârla sarılı el: elde dönen mavi-beyaz rüzgâr girdabı (dur sn)
func _wind_hand(c: Node3D, dur: float, s := 0.5, col := Color(0.6, 0.85, 1.0)) -> void:
	var ba = bone_attach(c, "RightHand")
	if ba == null:
		return
	var orb = VFX.wind_ball(s)
	ba.add_child(orb)
