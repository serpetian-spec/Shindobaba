	tw.tween_property(rod, "scale", Vector3.ONE * 0.01, 0.2)
	tw.tween_callback(rod.queue_free)
	Combat.popup_text(h.global_position + Vector3.UP * 2.4, "Çakrası bozuldu", Color(0.7, 0.6, 0.9))


