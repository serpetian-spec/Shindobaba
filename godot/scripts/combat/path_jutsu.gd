## Ölüm anında: mühür etkinse kara küre çevredekileri cesede çeker (boss olmayanlar mühürlenir, güçlüler ağır yaralanır)
static func ura_shisho_trigger(c: Node3D) -> void:
	if not is_instance_valid(c) or not c.has_meta("ura_shisho"):
		return
	c.remove_meta("ura_shisho")
	if c is Player:
		if not Buffs.has("ura_shisho"):
			return   # süresi dolmuş
		Buffs.remove("ura_shisho")
	var pi = get_pinst()
	var at = c.global_position + Vector3.UP * 1.2
	var R = 8.0
	for k in 4:   # kandan dört sembol
		var a = TAU * k / 4.0
		VFX.puffs(at + Vector3(cos(a), 0.4, sin(a)) * 1.2, {"amount": 10, "life": 0.6, "size": 0.25, "radius": 0.2, "vmin": 1, "vmax": 3, "dir": Vector3.UP, "spread": 30.0, "add": false,
			"colors": [Color(0.55, 0.02, 0.02, 1), Color(0.2, 0.0, 0.0, 0)]})
	# (ref anime) gövdede kara mühür formülü (dört yönde üçlü çizgi sembolleri) belirir
	var ch = pi.bone_attach(c, "UpperChest")
	if ch:
		var gb = MB.new()
		for g in [Vector2(0, 0.11), Vector2(0, -0.09), Vector2(-0.1, 0.01), Vector2(0.1, 0.01)]:
			for q in 3:
				var y = g.y + (q - 1) * 0.022
				if (int(g.x * 100) + q) % 2 == 0:
					gb.add("box", Vector3(g.x, 0.05 + y, 0.14), Vector3(0.07, 0.012, 0.006), Color(0.02, 0.02, 0.02))
				else:
					for hx in [-1.0, 1.0]:
						gb.add("box", Vector3(g.x + hx * 0.021, 0.05 + y, 0.14), Vector3(0.028, 0.012, 0.006), Color(0.02, 0.02, 0.02))
		ch.add_child(pi.mesh_of(gb, Props.toon()))
		pi.after(1.8, func():
			if is_instance_valid(ch):
				ch.queue_free())
	# küreyi saran, içe çeken gri burgu kollar
	for k in 10:
		var a0 = TAU * k / 10.0
		var e0 = randf_range(-0.2, 0.5)
		var dirn = 1.0 if k % 2 == 0 else -1.0
		var pth = func(u: float) -> Vector3:
			var a = a0 + dirn * u * TAU * 0.9
			var e = e0 + sin(u * PI) * 0.6
			return at + Vector3(cos(a) * cos(e), sin(e), sin(a) * cos(e)) * R * lerpf(1.25, 0.95, u)
		WindFX.streak(pth, 1.1, 0.7, Color.WHITE, 0.7 + k * 0.04, 24, WindFX.sheet_mat(Color(0.42, 0.45, 0.45), 0.9))
	var sp = MeshInstance3D.new()
	var sm = SphereMesh.new()
	sm.radius = 1.0
	sm.height = 2.0
	sp.mesh = sm
	var m = StandardMaterial3D.new()
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	m.albedo_color = Color(0.01, 0.01, 0.015)
	sp.material_override = m
	pi.get_tree().current_scene.add_child(sp)
	sp.global_position = at
	sp.scale = Vector3.ONE * 0.1
	var tw = sp.create_tween()
	tw.tween_interval(0.35)
	tw.tween_property(sp, "scale", Vector3.ONE * R, 0.45).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	tw.tween_interval(0.6)
	tw.tween_property(sp, "scale", Vector3.ONE * 0.05, 0.5).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	tw.tween_callback(sp.queue_free)
	pi.after(0.8, func():
		for f in pi.get_tree().get_nodes_in_group("fighters"):
			if not is_instance_valid(f) or f == c or (f.has_method("is_dead") and f.is_dead()) or not Combat.hostile(c, f):
				continue
			if f.global_position.distance_to(at) > R:
				continue
			var big = f.get("size") != null and float(f.get("size")) >= 2.5
			var mh = float(f.get("max_hp")) if f.get("max_hp") != null else 300.0
			f.take_hit({"dmg": mh * (0.4 if big or f == Game.player else 1.5), "kind": "heavy", "knock": 0.0, "attacker": c, "hitstop": 0.2, "melee": true}))
	Sfx.play("seal", at, 0.4)


## Seksen Tanrı Vakum Saldırısı: bin kollu gibi görünen hızla yüzlerce vakum yumruk dalgası ileri yağar
func p_yasogami_kugeki(c: Node3D, t: Node3D) -> void:
	busy(c, 1.4)
	var d = fwd(c, t)
	var side = d.cross(Vector3.UP).normalized()
	for k in 24:
		after(0.2 + k * 0.04, func():
			if not live(c):
				return
			var from = c.global_position + Vector3.UP * randf_range(0.8, 2.2) + side * randf_range(-1.2, 1.2) + d * 0.8
			var fist = MeshInstance3D.new()
			fist.mesh = SphereMesh.new()
			fist.material_override = _windmat(0.7)
			fist.scale = Vector3(1.4, 1.4, 2.6)
			var pr = shot(c, from, (d + side * randf_range(-0.12, 0.12)).normalized(), 40.0, fist, inf(c, "yasogami_kugeki", 0.25, {"knock": 4.0, "kind": "light", "element": "fuuton"}), null, false, 0.6, func(p, _h):
				VFX.shockwave(p, Color(0.9, 0.95, 1.0), 2.0, 0.2, false, d))
			pr.radius = 0.8
			if k % 3 == 0:
				VFX.shockwave(from + d * 0.4, Color(0.9, 0.95, 1.0), 1.4, 0.15, false, d))
	Sfx.play("wind", c.global_position, 1.2)


## Yomotsu Hirasaka: önde ve hedefin yanında siyah boyut kapıları açılır — yumruk bir kapıdan girip öbüründen hedefe çıkar
func p_yomotsu_hirasaka(c: Node3D, t: Node3D) -> void:
	var tt = tg(c, t, 30.0)
	busy(c, 0.8)
	var portal = func(at: Vector3, face: Vector3) -> MeshInstance3D:
		var p = MeshInstance3D.new()
		var qm = QuadMesh.new()
		qm.size = Vector2(1.6, 2.4)
		p.mesh = qm
		var m = StandardMaterial3D.new()
		m.albedo_color = Color(0.02, 0.02, 0.03)
		m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		m.cull_mode = BaseMaterial3D.CULL_DISABLED
		p.material_override = m
		get_tree().current_scene.add_child(p)
		p.global_position = at
		p.look_at(at + face + Vector3(0, 0.001, 0), Vector3.UP)
		p.scale = Vector3(0.05, 1, 1)
		var tw = p.create_tween()
		tw.tween_property(p, "scale", Vector3.ONE, 0.15)
		tw.tween_interval(0.6)
		tw.tween_property(p, "scale", Vector3(0.05, 1, 1), 0.15)
		tw.tween_callback(p.queue_free)
		return p
	var d = c.face_dir()
	portal.call(c.global_position + Vector3.UP * 1.2 + d * 1.0, d)
	if tt == null:
		return
	var side = (tt.global_position - c.global_position).cross(Vector3.UP).normalized()
	var exit = tt.global_position + Vector3.UP * 1.2 + side * 1.4
	portal.call(exit, -side)
	after(0.3, func():
		if not (live(c) and live(tt)):
			return
		anim(c, "punch", 1.6)
		VFX.shockwave(exit, Color(0.6, 0.6, 0.65), 2.0, 0.2, false, -side)
		melee_fx(c, tt.global_position + Vector3.UP, Color(0.85, 0.85, 0.9), 1.3)
		tt.take_hit(inf(c, "yomotsu_hirasaka", 1.8, {"knock": 14.0, "kind": "heavy", "hitstop": 0.1})))
	Sfx.play("seal", c.global_position, 1.6)


## Lav Çakra Modu: beden turuncu-kırmızı lav çakrası örtüsüyle kaplanır, kuyruklar alev gibi dalgalanır — temas eden her şey erir (20 sn)
func p_yoton_chakura_modo(c: Node3D, _t: Node3D) -> void:
	busy(c, 0.9)
	VFX.shockwave(c.global_position + Vector3.UP, LAVA, 10.0, 0.5, false)
	var a = FX.aura(c, LAVA, 1.9, Vector3(0, 0.9, 0), 0.0)
	# lav örtüsü: bedeni saran erimiş lav kabuğu (kemiklere bağlı; yere damlayan tabaka yok) — kollar, gövde, bacaklar
	var coat = []
	for bn in ["UpperChest", "Spine", "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm", "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg"]:
		var ba = bone_attach(c, bn)
		if ba == null:
			continue
		var lb = MB.new()
		var chest = bn in ["UpperChest", "Spine"]
		lb.add("boulder", Vector3(0, 0.1, 0.02), Vector3(0.36, 0.3, 0.3) if chest else Vector3(0.15, 0.3, 0.15), Color.WHITE, Vector3.ZERO, coat.size() % 6)
		var lm = mesh_of(lb, VFX.lava_mat("molten"))
		lm.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		ba.add_child(lm)
		lm.scale = Vector3.ONE * 0.05
		lm.create_tween().tween_property(lm, "scale", Vector3.ONE, 0.3).set_trans(Tween.TRANS_BACK)
		coat.append(ba)
	var tails = Node3D.new()
	c.add_child(tails)
	tails.position = Vector3(0, 0.95, -0.15)
	# (anime Rōshi: lav kuyruğu yok — beden lav örtüsüyle kaplı)
	# ref: bedeni saran, kenarları alev gibi dalgalanan parlak lav chakrası (jinchūriki pelerin shader'ı, kulak/kuyruk yok)
	var m = c.get("model")
	if m and m.get("body_mesh") and m.body_mesh and m.skel:
		var mt = ShaderMaterial.new()
		mt.shader = load("res://shaders/beast_cloak.gdshader")
		mt.set_shader_parameter("col", Color(1.0, 0.45, 0.08))
		mt.set_shader_parameter("grow", 0.07)
		var cm = MeshInstance3D.new()
		cm.mesh = m.body_mesh.mesh
		m.skel.add_child(cm)
		cm.skin = m.body_mesh.skin
		cm.skeleton = cm.get_path_to(m.skel)
		cm.material_override = mt
		cm.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		tails.set_meta("cloak", cm)
		tails.tree_exiting.connect(func(): if is_instance_valid(cm): cm.queue_free())
	if c is Player:
		Buffs.add("yoton_chakura", 20.0, {"melee": 1.35, "armor": 0.75, "_name": "Lav Çakra Modu", "_desc": "lav örtüsü: dokunan yanar, güç artar"})
	every(20.0, 0.5, func(_i, _k):
		if not live(c):
			return
		# bedenden yükselen lav buharı
		FX.burst(c.global_position + Vector3.UP * 1.6, {"amount": 2, "life": 1.0, "tex": FX.tex_smoke, "add": false, "cel": false, "size": 0.8, "radius": 0.4, "vmin": 0.6, "vmax": 1.4,
			"dir": Vector3.UP, "spread": 30.0, "colors": [Color(0.92, 0.9, 0.9, 0.0), Color(0.88, 0.86, 0.86, 0.45), Color(0.82, 0.8, 0.8, 0.0)]})
		for e in enemies_near(c, c.global_position, 2.8):
			VFX.lava_splash(e.global_position + Vector3.UP, 0.4)
			e.take_hit(inf(c, "yoton_chakura_modo", 0.25, {"knock": 0.0, "kind": "light", "element": "yoton", "burn": 2.0})), func():
		if is_instance_valid(tails):
			tails.queue_free()
		for ba in coat:
			if is_instance_valid(ba):
				ba.queue_free()
		if is_instance_valid(a):
			a.emitting = false)
	shake(0.6)
	Sfx.play("fire", c.global_position, 0.7)


