		VFX.bolt(p + Vector3(cos(a), 0, sin(a)) * 0.45, p + Vector3(cos(a + 0.8), randf_range(-0.4, 0.6), sin(a + 0.8)) * 0.9 + Vector3.UP * 0.2, RAIKAGE, 0.14, 0.12, 2), Callable())
