			sm.set_shader_parameter("tint", Color(0.62, 0.6, 0.58))
	var tw = husk.create_tween()
	tw.tween_interval(0.6)
	tw.tween_property(husk, "scale", Vector3(1.15, 0.25, 1.15), 0.5).set_ease(Tween.EASE_IN)
