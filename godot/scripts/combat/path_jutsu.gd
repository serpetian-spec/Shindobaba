		stream_fx(at - d * 2.0, d, 4.0, 0.08, VFX.mat_bolt(Color(1, 1, 1), 2.5), 0.25)
		mhit(c, at + d * 1.2, 2.4, inf(c, "iburi_iaigiri", 1.6, {"knock": 10.0, "kind": "heavy", "bleed": 3.0, "hitstop": 0.1})))
