## Dev Vakum Küresi: ağızda büyük vakum küresi toplanır, fırlar — yol boyunca zemini kazır, dev patlama
func p_futon_shinku_taigyoku(c: Node3D, t: Node3D) -> void:
	busy(c, 1.0)
	# (ref fuuton3.png) ağzın önünde hava merkeze emilir: her yönden içe akan koyu radyal hız çizgileri, sonra vakum küresi fırlar
	var cen = _mouth_pos(c) + c.face_dir() * 1.5
	var fw = c.face_dir()
	var sd = fw.cross(Vector3.UP).normalized()
	var upv = sd.cross(fw).normalized()
	for k in 34:
		var a = TAU * k / 34.0 + randf_range(-0.08, 0.08)
		var dirr = sd * cos(a) + upv * sin(a)
		var r0 = randf_range(5.0, 8.0)
		var dk = Color(0.28, 0.3, 0.32, 0.85) if k % 3 != 0 else Color(0.85, 0.9, 0.9, 0.8)
		WindFX.streak(func(u: float) -> Vector3: return cen + dirr * lerpf(r0, 0.4, u), 0.3, 0.06, dk, randf() * 0.12, 10)
	# (ref anime) fırlayan şey dev, şeffaf bir hava küresi: dönen akım perdeleri + kameraya dönük ince iç içe halka kenarları
	var tt2 = tg(c, t, 28.0)
	after(0.4, func():
		if not live(c):
			return
		var from = _mouth_pos(c) + c.face_dir() * 1.2
		var core = Node3D.new()
		WindFX.bullet(core, 3.2)
		for q in 3:
			var rg = MeshInstance3D.new()
			var qm = QuadMesh.new()
			qm.size = Vector2.ONE * (5.4 - q * 1.2)
			var m = StandardMaterial3D.new()
			m.albedo_texture = FX.tex_ring
			m.albedo_color = Color(0.92, 0.97, 1.0, 0.5 - q * 0.12)
			m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
			m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
			m.billboard_mode = BaseMaterial3D.BILLBOARD_ENABLED
			qm.material = m
			rg.mesh = qm
			rg.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			core.add_child(rg)
		var pr = shot(c, from, aim_at(c, tt2, from), 24.0, core, inf(c, "futon_shinku_taigyoku", 1.8, {"knock": 24.0, "launch": 6.0, "kind": "heavy", "element": "fuuton", "hitstop": 0.05}), null, false, 1.6, func(p, _h):
			impact_fx("fuuton", WIND, p, 2.0))
		pr.radius = 1.4
		_etrail(pr, "fuuton", WIND, 2.6))
	Sfx.play("wind", c.global_position, 0.5)


## Fūton: Shinkūha (kanon, Danzō): derin nefes, ağızdan ileri doğru keskin vakum dalgaları — yolundaki her şeyi keser, uzun menzil
func p_futon_shinkuha(c: Node3D, t: Node3D) -> void:
	busy(c, 0.6)
	var tt = tg(c, t, 30.0)
