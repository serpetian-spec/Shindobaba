	var at = gp(c.global_position + c.face_dir() * 1.5)
	c.velocity = Vector3.UP * 14.0
	WindFX.swirl(at, 2.2, 14.0, 1.0, 14, Color(0.9, 1.0, 0.9, 0.9), true)
