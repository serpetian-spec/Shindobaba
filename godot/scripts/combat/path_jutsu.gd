					var a = k * TAU / 8.0
					b.add("cone", Vector3(cos(a) * 0.2, sin(a) * 0.2, -0.2), Vector3(0.07, 0.2, 0.07), steel, Vector3(0, 0, rad_to_deg(a) - 90), 4)
			"chakram":
